#!/usr/bin/env bash
#
# PreToolUse accident guard: prevent normal file reads and credential printers
# from putting values in context. Names and masked metadata remain available.
# Shell analysis is bounded, role-aware, and never evaluates command text.
# It is not a sandbox: transformations, MCP search tools, and deliberate shell
# indirection are outside its protection. Malformed nonempty input, missing jq,
# and analysis failures deny. Analysis is limited to 8 KiB, 256 tokens, and four
# nested levels. Grep scans names to depth 12, with a 200 ms deadline.
#
# Registered for Bash and Read|Grep|Edit|Write. Bash 3.2-safe; synthetic matrix
# lives in tests/test-guard.sh. Denials suggest explicit secret transport.
set -euo pipefail
# Byte-wise scanning preserves input bytes and avoids locale-dependent indexing.
export LC_ALL=C
# Resolve guard tools only through absolute inherited PATH entries.
SAFE_PATH=''
IFS=: read -r -a PATH_PARTS <<<"${PATH:-/usr/bin:/bin}"
for path_part in "${PATH_PARTS[@]}"; do
    [[ "$path_part" == /* ]] || continue
    SAFE_PATH="${SAFE_PATH:+$SAFE_PATH:}$path_part"
done
export PATH="${SAFE_PATH:-/usr/bin:/bin}"
unset SAFE_PATH PATH_PARTS path_part
GIT_BINARY="$(command -v git 2>/dev/null || :)"

# Without a JSON parser, no nonempty request can establish search protection.
# Empty stdin still means there is no tool call to decide.
if ! command -v jq >/dev/null 2>&1; then
    if IFS= read -r -n 1; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"jq is required to analyse file access safely"}}'
    fi
    exit 0
fi
# Install the failure trap before reading the envelope, including read errors.
INPUT='?'
DECISION_WRITTEN=0
# Called from the EXIT trap, including nounset and unexpected tool failures.
# shellcheck disable=SC2317,SC2329
guard_exit() {
    local status="$1"
    if [[ -n "$INPUT" && "$DECISION_WRITTEN" != 1 && "$status" != 0 ]]; then
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"guard could not analyse file access safely"}}'
        exit 0
    fi
}
trap 'guard_exit "$?"' EXIT
trap 'exit 1' ERR
INPUT="$(cat)" || exit 1
GUARD_STARTED=$SECONDS
GUARD_REALTIME="${EPOCHREALTIME:-}"
within_budget() {
    if [[ -n "$GUARD_REALTIME" ]]; then
        local start="${GUARD_REALTIME/./}" now="${EPOCHREALTIME/./}"
        ((10#$now - 10#$start < 2000000))
    else
        ((SECONDS - GUARD_STARTED < 2))
    fi
}
# Reject concatenated JSON envelopes before extracting any field.
printf '%s' "$INPUT" | jq -se 'length == 1' >/dev/null 2>&1 || exit 1
TOOL="$(printf '%s' "$INPUT" | jq -er '.tool_name | select(type == "string")' 2>/dev/null)" || exit 1
HELP='use secret show FILE for masked names, or secret run -f FILE -- CMD; never disguise a denied command'
REASON=""
ANALYSIS_TOKENS=0
BRACE_STEPS=0
BRACE_FIELDS=0
RAW_OPERAND_PROTECTED=-1
US=$'\x1f'
REDIR=$'\x1e'
ACTIVE=$'\x1d'
READERS=' cat bat less more head tail grep egrep fgrep rg ag ack ack-grep sed awk gawk perl python python3 ruby node source . xxd od hexdump strings cut sort uniq base64 jq yq tr nl tac rev diff cmp vim vi nvim nano emacs pbcopy open wc '
CRED_VAR='\$\{?[A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss]([Ww][Oo][Rr][Dd]|[Ww][Dd])?|[Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_[Kk][Ee][Yy]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|_[Kk][Ee][Yy])[A-Za-z0-9_]*\}?'
# Static name witnesses serve globs; the shared ERE serves literal paths and Perl.
PROTECTED_NAMES=(.envrc .env .env.production app.env app.secret .secrets.env .netrc .git-credentials)
CREDENTIAL_NAMES=(.aws/credentials .docker/config.json .config/gh/hosts.yml .npmrc .pypirc
    .kube/config application_default_credentials.json .config/gcloud/credentials.db
    .config/gcloud/access_tokens.db .vault-token .terraform.d/credentials.tfrc.json
    .cargo/credentials.toml .cargo/credentials .pgpass)
# Shell builtins join the fixed names into an ERE body, without a runtime lookup
# table. @ID@ marks the SSH key name; each matcher fills in its own character
# class, since Bash before 4.3 keeps quotes inside a quoted ${var//pat/rep}.
printf -v CREDENTIAL_BODY '%s|' "${CREDENTIAL_NAMES[@]}"
CREDENTIAL_BODY="(${CREDENTIAL_BODY//./\\.}"
# Glob witnesses for variable-name families are not exhaustive literal paths.
# shellcheck disable=SC2016  # proc spellings are literal, never evaluated
CREDENTIAL_GLOBS=(.ssh/id_rsa .ssh/id_ed25519 /proc/self/environ /proc/thread-self/environ /proc/123/environ /proc/123/task/456/environ '/proc/$$/environ' '/proc/$ppid/environ')
# shellcheck disable=SC2016  # literal shell PID spellings belong in the regex
CREDENTIAL_BODY+='\.config/gcloud/legacy_credentials(/[^[:space:]]*)?|\.ssh/id_@ID@|proc/(self|thread-self|[0-9]+|[0-9]+/task/[0-9]+|\$\$|\$ppid)/environ)'
CREDENTIAL_PATH="(^|/)${CREDENTIAL_BODY//@ID@/[^/]*}"
CREDENTIAL_PUBLIC='(^|/)\.ssh/id_[^/]*\.pub$'

# decide: emit only fixed operation names, never arbitrary command/value text.
decide() {
    local reason="$1"
    [[ "${2:-1}" == 0 ]] || reason+="; $HELP"
    DECISION_WRITTEN=1
    jq -cn --arg r "$reason" '{hookSpecificOutput:{hookEventName:"PreToolUse",permissionDecision:"deny",permissionDecisionReason:$r}}' ||
        printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"guard could not emit decision safely"}}'
}

# Reject controls in JSON before jq -r can lose NUL or Bash can reinterpret it.
# Keep the existing fixed Bash failure reason, without echoing input fields.
case "$TOOL" in
    Bash | Read | Edit | Write | MultiEdit | NotebookEdit | Grep | apply_patch)
        JSON_SCAN=0
        printf '%s' "$INPUT" | jq -e '
            ([.cwd, .tool_input.file_path, .tool_input.notebook_path, .tool_input.path, .tool_input.glob,
              .tool_input.type, .tool_input.output_mode]
             | any(.[]; type == "string" and test("[\u0000-\u0008\u000b-\u001f\u007f]")))
            or (.tool_input.command | if type == "string" then
                (if length <= 8192 or contains("\n") then (gsub("\r\n";"\n") | sub("\r$";"") | test("[\u0000-\u0008\u000b-\u001f\u007f]")) else false end)
                elif type == "array" then any(.[]; type == "string" and test("[\u0000-\u0008\u000b-\u001f\u007f]"))
                else false end)' >/dev/null 2>&1 || JSON_SCAN=$?
        if [[ "$JSON_SCAN" != 1 ]]; then
            decide 'command too complex to analyse for secret access; split it or use secret run' 0
            exit 0
        fi
        ;;
esac
CWD="$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)" || exit 1
[[ "$CWD" == /* ]] || exit 1
# Codex's exec_command currently omits workdir from hook input. Honor it when
# supplied by another shell adapter; a relative workdir is based on hook cwd.
if [[ "$TOOL" == Bash ]]; then
    WORKDIR="$(printf '%s' "$INPUT" | jq -r '.tool_input.workdir | select(type == "string") // empty' 2>/dev/null)" || exit 1
    if [[ -n "$WORKDIR" ]]; then
        if [[ "$WORKDIR" == /* ]]; then CWD="$WORKDIR"; else CWD="$CWD/$WORKDIR"; fi
    fi
fi

# lower TEXT: fold ASCII protected names without Bash 4 case expansions.
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# credential_path TEXT [RAW]: share path rules, excluding public SSH keys.
# Raw recovery permits shell delimiters, but not credential-name suffixes.
credential_path() {
    context_credentials
    local text="$1" pattern="($CREDENTIAL_PATH)$" matched word="[^/[:space:]\"';|&<>]*"
    if [[ "${2:-0}" == 1 ]]; then
        # Backslash delimits too: the shell reads `\.aws` as `.aws`.
        pattern="((^|[\\/[:space:]\"'])${CREDENTIAL_BODY//@ID@/$word})(\$|[\\[:space:]\"';|&<>])"
    fi
    if [[ -n "${CONTEXT_CREDENTIAL:-}" ]]; then
        if [[ "${2:-0}" == 1 ]]; then
            local context_pattern="(^|[[:space:]\"'])($CONTEXT_CREDENTIAL)($|[[:space:]\"';|&<>])"
            [[ "$text" =~ $context_pattern ]] && return 0
        elif [[ "$text" =~ ^($CONTEXT_CREDENTIAL)$ ]]; then return 0; fi
    fi
    while [[ "$text" =~ $pattern ]]; do
        matched="${BASH_REMATCH[1]}"
        [[ "$matched" =~ $CREDENTIAL_PUBLIC ]] || return 0
        text="${text#*"$matched"}"
    done
    return 1
}

# credential_selector GLOB: contextual names need directory components, never
# a bare config.json/hosts.yml match. Strip only leading selector components.
credential_selector() {
    local selector="$1" name suffix
    credential_path "$selector" && return 0
    local value configs=()
    IFS=: read -r -a configs <<<"${KUBECONFIG:-}"
    for value in "${HOME:-/dev/null}/.yarnrc.yml" ${configs[@]+"${configs[@]}"}; do
        value="$(lower "$(path "$value" 1)")"
        # shellcheck disable=SC2053  # selectors are intentionally patterns
        [[ "$value" == $selector || "${value##*/}" == $selector ]] && return 0
    done
    for name in "${CREDENTIAL_NAMES[@]}" "${CREDENTIAL_GLOBS[@]}"; do
        suffix="$selector"
        while [[ -n "$suffix" ]]; do
            if [[ "$name" != */* || "$suffix" == */* ]]; then
                # shellcheck disable=SC2053  # selectors intentionally are patterns
                [[ "$name" == $suffix || "/$name" == $suffix ]] && return 0
            fi
            [[ "$suffix" == */* ]] || break
            suffix="${suffix#*/}"
        done
    done
    return 1
}

# raw_mentions_protected TEXT: narrow failure recovery and inline-code checks.
# This only inspects command text, never file contents, and emits no user text.
raw_mentions_protected() (
    local folded boundary end pattern readers remaining matched brace_witness
    # Keep nocasematch local: credential expansions retain the shared regex.
    shopt -s nocasematch
    folded="$(lower "$1")"
    boundary='(^|[^[:alnum:]_])'
    end='([^[:alnum:]_]|$)'
    # The optional mode lets filtered shell code distinguish credential use
    # from protected files/printers, before recursive validation of that code.
    if [[ ("${2:-0}" == 0 || "${2:-0}" == 3) && "$folded" =~ $CRED_VAR ]]; then return 0; fi
    pattern="\\.(envrc|env|secret|secrets|netrc|git-credentials)$end|secrets\\.env$end"
    [[ "$folded" =~ $pattern ]] && return 0
    credential_path "$folded" 1 && return 0
    # Budget/malformed failures retain conservative brace/name witnesses even
    # when an unrelated list exhausted enumeration first, or braces produce the
    # leading dot. Interpreter source is not shell brace syntax.
    brace_witness="${folded//../@}"
    pattern='(\.[^[:space:]]*[{}]|[{}][^[:space:]]*\.)'
    if [[ "${2:-0}" != 2 && "$brace_witness" =~ $pattern ]]; then return 0; fi
    pattern="$boundary(gcloud[[:space:]]+auth[[:space:]]+(application-default[[:space:]]+)?print-(access|identity)-token|aws[[:space:]]+[^;|]*(configure[[:space:]]+export-credentials|configure[[:space:]]+get[[:space:]]+[^;|]*aws_(access_key_id|secret_access_key|session_token))|op[[:space:]]+(read|item[[:space:]]+get[[:space:]]+[^;|]*--(reveal|fields))|secret-tool[[:space:]]+(lookup|search)|kwallet-query[[:space:]]+[^;|]*(-r|--read-password(=[^;|[:space:]]*)?))$end"
    [[ "$folded" =~ $pattern ]] && return 0
    # pass defaults to show; known non-reading subcommands stay safe on failure.
    # Interpreter code (mode 2) skips this: `pass` is a Python keyword.
    pattern="$boundary"'pass[[:space:]]+([^[:space:];|]+)'
    remaining="$folded"
    [[ "${2:-0}" != 2 ]] || remaining=""
    while [[ "$remaining" =~ $pattern ]]; do
        matched="${BASH_REMATCH[0]}"
        case "${BASH_REMATCH[2]}" in
            ls | list | insert | add | edit | generate | rm | remove | delete | mv | rename | cp | copy | init | git | help | version | -*) ;;
            *) return 0 ;;
        esac
        remaining="${remaining#*"$matched"}"
    done
    # BSD e has no dash; macOS -E is conservatively treated as environment mode.
    pattern="$boundary"'ps[[:space:]]+([^;|]*[[:space:]])?([a-zA-Z]*e[a-zA-Z]*|-[a-zA-Z]*E[a-zA-Z]*)'"$end"
    shopt -u nocasematch
    [[ "$1" =~ $pattern ]] && return 0
    # Mode 2 (interpreter arguments) skips shell-builtin printer words:
    # `manage.py export` or `x.rb set` are ordinary operands. Environment
    # access from interpreter code (ENV, %ENV, os.environ, getenv) still counts.
    if [[ "${2:-0}" == 2 ]]; then
        # A standalone env argument is an ordinary name, not interpreter code.
        [[ "$folded" != env ]] || return 1
        pattern="$boundary(env|printenv|environb?|getenv)$end|\\.environ|process\\[.*env.*\\]"
        [[ "$folded" =~ $pattern ]] && return 0
    else
        pattern='(^|[;|&()])[[:space:]]*(env|printenv|export|set|declare|typeset|wl-paste|xclip|xsel|pbpaste|rg)([[:space:];|&<>"'"'"'()]|$)'
        # The regular analysis classifies command words; failure recovery must
        # not promote an ordinary argument named env into a printer.
        [[ "$folded" =~ $pattern ]] && return 0
        pattern="$boundary(printenv|export|set|declare|typeset|wl-paste|xclip|xsel|pbpaste|rg)([[:space:];|&<>\"'()]|$)"
        [[ "$folded" =~ $pattern ]] && return 0
    fi
    pattern="$boundary(compgen[[:space:]]+-[a-z]*v[a-z]*|gh[[:space:]]+auth[[:space:]]+token|credential[[:space:]]+fill|secret[[:space:]]+(get|exec))$end|$boundary"'security[[:space:]]+find-'
    [[ "$folded" =~ $pattern ]] && return 0
    pattern="$boundary(grep|egrep|fgrep)[[:space:]]+([^;|]*[[:space:]])?(-[a-z]*r[a-z]*|--(dereference-)?recursive)$end"
    [[ "$folded" =~ $pattern ]] && return 0
    pattern="$boundary"'git[[:space:]]+([^;|]*[[:space:]])?grep'"$end"
    [[ "$folded" =~ $pattern ]] && return 0
    # Prefix globs such as .en* can match .env without spelling it literally.
    pattern='\.e(n(v)?)?(\*|\?|\[)'
    [[ "$folded" =~ $pattern ]] && return 0
    # Operand recovery cannot treat globs inside an unrelated substitution as
    # reader filenames (wc -l $(ls src/*.ts)); named protected globs still count.
    [[ "${2:-0}" != 3 ]] || return 1
    readers="${READERS// . / }"
    readers="${readers# }"
    readers="${readers% }"
    readers="${readers// /|}"
    # Reader/redirect glob operands can expand to protected names. Filter code
    # is not parsed here: uncertain over-budget requests must be split instead.
    pattern="$boundary($readers|\\.)[[:space:]]+[^;|]*(\\*|\\?|\\[)|<[[:space:]]*[^;|]*(\\*|\\?|\\[)"
    [[ "$folded" =~ $pattern ]]
)

# raw_text_protected: deny raw protected names except the documented inert
# argument and quoted data roles. This never interprets or executes the text.
raw_text_protected() {
    case "$1" in *.* | *git/config* | */proc/*) ;; *) return 1 ;; esac
    printf '%s' "$1" | perl -e '
        use strict; use warnings;
        local $/;
        my $text = <STDIN> // "";
        my $scope = shift(@ARGV) // "all";
        # Only the command receiving this heredoc can own inert message data.
        # Inert cat substitutions and cat-to-message pipes are also recognised.
        sub message_header {
            my ($before, $after) = @_;
            my $receiver = $before;
            $receiver =~ s/^.*(?:&&|\|\||;|\|)//;
            $receiver =~ s/^.*\$\(\s*//;
            my $message = qr{^\s*(?:git\s+(?:commit|tag)\b[^\n]*(?:-[as]*m\b|--message\b|-F\s+-|--file=-)|gh\b[^\n]*(?:--title|--body))};
            return 1 if $receiver =~ $message;
            return 0 unless $receiver =~ /^\s*cat\s*$/;
            return 1 if $after =~ /^\s*\|\s*(?:git\s+(?:commit|tag)\b[^\n]*(?:-F\s+-|--file=-)|gh\b[^\n]*--body-file\s+-)/;
            return $before =~ $message && $before =~ /\$\(\s*cat\s*$/;
        }
        my $protected = qr{(?:\.env(?!\.(?:example|sample|template)(?![\w-]))(?![\w-])|\.(?:envrc|secrets|secret|netrc|npmrc|pypirc|git-credentials|gitconfig|gitmodules)(?![\w.-])|[\w-]+\.secret(?![\w.-])|\.aws/credentials(?![\w.-])|\.docker/config\.json(?![\w.-])|\.config/gh/hosts\.yml(?![\w.-])|\.ssh/id_[\w-]+(?![\w-]|\.pub)|/proc/[^\s]+/environ|git/config|\.git(?![\w-]))}i;
        # A script body is code even if a line resembles a shell comment.
        while ($text =~ /(?:\A|\n)([^\n]*?)<<-?\x27?([A-Za-z0-9_]+)\x27?([^\n]*)\n(.*?)\n\2(?:\n|\z)/sg) {
            my ($before, $after, $source) = ($1, $3, $4);
            my $header = $before . $after;
            my ($target) = $header =~ /^\s*cat\b[^\n]*\s>>?\s*([^\s<>]+)/;
            ($target) = $header =~ /^\s*tee\s+(?:-a\s+)?([^\s<>]+)/ unless defined $target;
            my $file_data = defined($target) && $target !~ $protected && $target !~ /[\$`*?]/;
            my $message_data = message_header($before, $after);
            exit 0 if !$file_data && !$message_data && $source =~ $protected;
        }
        if ($scope eq "body") {
            while ($text =~ /(?:\A|[;\n])([^\n]*?)<<<\s*(\x27[^\x27]*\x27|"[^"]*"|[^\s;]+)/g) {
                my ($header, $source) = ($1, $2);
                my ($target) = $header =~ /^\s*cat\b[^\n]*\s>\s*([^\s<>]+)/;
                ($target) = $header =~ /^\s*tee\s+(?:-a\s+)?([^\s<>]+)/ unless defined $target;
                my $file_data = defined($target) && $target !~ $protected && $target !~ /[\$`*?]/;
                exit 0 if !$file_data && $source =~ $protected;
            }
            exit 1;
        }
        # Whole-line comments and trailing unquoted shell comments are inert.
        my $clean = ""; my $quote = ""; my $escape = 0; my $start = 1;
        for my $c (split //, $text) {
            if ($escape == 2) { $clean .= $c eq "\n" ? "\n" : " "; $escape = 0 if $c eq "\n"; next; }
            if ($escape) { $clean .= $c; $escape = 0; $start = 0; next; }
            if ($c eq "\\" && $quote ne "\x27") { $clean .= $c; $escape = 1; next; }
            if (!$quote && $c eq "#" && $start) {
                $clean .= " "; $escape = 2; next;
            }
            if ($quote) { $quote = "" if $c eq $quote; }
            elsif ($c eq "\x27" || $c eq q{"}) { $quote = $c; }
            $clean .= $c;
            $start = (!$quote && $c =~ /[\s;|&()<>]/) ? 1 : 0;
        }
        # A quoted heredoc is data only when cat or tee writes a plain file.
        my $body = ""; my $delimiter = ""; my $inert = 0;
        for my $line (split /(?<=\n)/, $clean, -1) {
            if (length $delimiter) {
                if ($line =~ /^\Q$delimiter\E\r?\n?$/) { $delimiter = ""; $body .= $line; next; }
                $body .= $inert ? (" " x length($line)) : $line;
                next;
            }
            $body .= $line;
            if ($line =~ /<<[[:space:]]*\x27([A-Za-z0-9_]+)\x27/) {
                $delimiter = $1;
                $inert = ($line =~ /^\s*(?:cat|tee)\b/ &&
                    ($line =~ /\s>\s*[^\s<>]+/ || $line =~ /^\s*tee\s+(?:-a\s+)?[^\s<>]+/)) ||
                    message_header((split /<<[^\n]*?\x27[A-Za-z0-9_]+\x27/, $line, 2));
            }
        }
        $clean = $body;
        my @segments; my $segment = ""; my $quoted = ""; my $escaped = 0;
        for my $c (split //, $clean) {
            $segment .= $c;
            if ($escaped) { $escaped = 0; next; }
            if ($c eq "\\" && $quoted ne "\x27") { $escaped = 1; next; }
            if ($quoted) { $quoted = "" if $c eq $quoted; next; }
            if ($c eq "\x27" || $c eq q{"}) { $quoted = $c; next; }
            if ($c =~ /[;|&\n]/) { push @segments, $segment; $segment = ""; }
        }
        push @segments, $segment if length $segment;
        for my $segment (@segments) {
            my @words;
            while ($segment =~ /(?:\x27[^\x27]*\x27|"(?:\\.|[^"])*"|\\.|[^\s;|&])+/g) {
                push @words, [ $-[0], $+[0], $& ];
            }
            next unless @words;
            my $cmd_index = 0;
            if ($words[0][2] =~ /^(?:\{|builtin|command)$/ && @words > 1) { $cmd_index = 1; }
            elsif ($words[0][2] =~ /^(?:env|sudo)$/) {
                for (my $i = 1; $i < @words; $i++) {
                    if ($words[$i][2] =~ /^(?:echo|printf)$/) { $cmd_index = $i; last; }
                }
            }
            my $cmd = lc($words[$cmd_index][2]);
            my $masked = $segment;
            my $hide = sub { my ($w) = @_; substr($masked, $w->[0], $w->[1] - $w->[0]) = " " x ($w->[1] - $w->[0]); };
            if ($cmd =~ /^(?:echo|printf)$/) {
                for my $w (@words[$cmd_index + 1 .. $#words]) {
                    last if $w->[2] =~ /^[<>]/;
                    $hide->($w);
                }
            } elsif ($cmd eq "git" && $segment =~ /\bgit\s+(?:[^;|&]*?\s)?(?:commit|tag)\b/) {
                for (my $i = 1; $i < @words; $i++) {
                    my $w = $words[$i][2];
                    if ($w eq "-m" || $w eq "--message" || $w =~ /^-[as]*m$/) { $hide->($words[++$i]) if $i + 1 < @words; }
                    elsif ($w =~ /^--message=/ || $w =~ /^-[as]*m./) { $hide->($words[$i]); }
                }
            } elsif ($cmd eq "gh") {
                for (my $i = 1; $i < @words; $i++) {
                    my $w = $words[$i][2];
                    if ($w eq "--title" || $w eq "--body") { $hide->($words[++$i]) if $i + 1 < @words; }
                    elsif ($w =~ /^--(?:title|body)=/) { $hide->($words[$i]); }
                }
            } elsif ($cmd eq "cat" || $cmd eq "tee") {
                my $writing = $cmd eq "cat" ? $segment =~ /\s>\s*[^\s<>]+/ :
                    $segment =~ /^\s*tee\s+(?:-a\s+)?[^\s<>]+/;
                if ($writing) {
                    for (my $i = 1; $i < @words; $i++) {
                        my $w = $words[$i][2];
                        if ($w =~ /^<<</) {
                            $hide->($words[$i]);
                            $hide->($words[++$i]) if $w eq "<<<" && $i + 1 < @words;
                        }
                    }
                }
            } elsif ($cmd =~ /^(?:grep|rg)$/) {
                my $pattern = 0;
                for (my $i = 1; $i < @words; $i++) {
                    my $w = $words[$i][2];
                    if ($w eq "-e" || $w eq "--regexp") { $hide->($words[++$i]) if $i + 1 < @words; next; }
                    if ($w =~ /^--regexp=|^-e./) { $hide->($words[$i]); next; }
                    if ($w eq "-g" || $w eq "--glob" || $w eq "-f" || $w eq "--file") { $i++; next; }
                    next if $w =~ /^-/;
                    if (!$pattern++) { $hide->($words[$i]); }
                    last;
                }
            }
            exit 0 if $masked =~ $protected;
        }
        exit 1;
    ' "${2:-all}"
}

# path PATH [LEXICAL]: expand literal home prefixes relative to the effective cwd.
path() {
    local p="$1"
    # shellcheck disable=SC2088,SC2016  # match literal unexpanded home spellings
    case "$p" in
        '~') p="${HOME:-}"; [[ -n "$p" ]] || return 1 ;;
        '~/'*) p="$HOME/${p:2}" ;;
        '~'?*)
            local user="${p#\~}" suffix=''
            if [[ "$user" == */* ]]; then suffix="/${user#*/}"; user="${user%%/*}"; fi
            local user_home
            user_home="$(perl -e 'my @p = getpwnam($ARGV[0]); @p or exit 2; print $p[7]' "$user")" || return 1
            p="$user_home$suffix" ;;
        '$HOME/'*) p="$HOME/${p:6}" ;;
        '${HOME}/'*) p="$HOME/${p:8}" ;;
        '$XDG_CONFIG_HOME/'*) p="${XDG_CONFIG_HOME:-${HOME:-/dev/null}/.config}/${p:17}" ;;
        '${XDG_CONFIG_HOME}/'*) p="${XDG_CONFIG_HOME:-${HOME:-/dev/null}/.config}/${p:19}" ;;
    esac
    [[ "$p" == /* ]] || p="$CWD/$p"
    # Empty and dot components never change the target. Collapse dot-dot only
    # for lexical credential matching; metadata resolution keeps symlink order.
    local component remaining="${p#/}/" normalized=()
    while [[ "$remaining" == */* ]]; do
        component="${remaining%%/*}"
        remaining="${remaining#*/}"
        case "$component" in
            '' | .) ;;
            ..)
                if [[ "${2:-0}" == 1 ]]; then
                    ((${#normalized[@]} == 0)) || unset 'normalized[${#normalized[@]}-1]'
                else normalized+=("$component"); fi ;;
            *) normalized+=("$component") ;;
        esac
    done
    p=''
    for component in ${normalized[@]+"${normalized[@]}"}; do p+="/$component"; done
    p="${p:-/}"
    printf '%s\n' "$p"
}

# context_credentials: cache lexical and physical witnesses for each cwd scope.
# KUBECONFIG is a path list, not credential contents; never open its files.
context_credentials() {
    local key="${HOME:-}$US${KUBECONFIG:-}$US$CWD" base value target resolved
    local bases=("$CWD" ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}) paths=() configs=()
    for base in "${bases[@]}"; do key+="$US$base"; done
    [[ "${CONTEXT_CREDENTIAL_KEY:-}" != "$key" ]] || return 0
    IFS=: read -r -a configs <<<"${KUBECONFIG:-}"
    paths+=("${HOME:-/dev/null}/.yarnrc.yml")
    for base in "${bases[@]}"; do
        for value in ${configs[@]+"${configs[@]}"}; do
            case "$value" in '' | *'$'* | *'`'* | *"$ACTIVE"*) continue ;; esac
            paths+=("$(CWD="$base" path "$value")")
        done
    done
    # Retain lexical witnesses for absent targets, and resolve existing
    # symlinked ancestors without opening files or collapsing dot-dot first.
    local witnesses=()
    for target in ${paths[@]+"${paths[@]}"}; do
        witnesses+=("$(path "$target" 1)")
        resolved="$(canonical_target "$target")" || resolved=''
        [[ -z "$resolved" || "$resolved" == "${witnesses[${#witnesses[@]}-1]}" ]] || witnesses+=("$resolved")
    done
    local escaped char index
    CONTEXT_CREDENTIAL=''
    for value in "${witnesses[@]}"; do
        value="$(lower "$value")"; escaped=''
        for ((index = 0; index < ${#value}; index++)); do
            char="${value:index:1}"
            case "$char" in
                '.' | '^' | '$' | '*' | '+' | '?' | '(' | ')' | '[' | ']' | '{' | '}' | '|' | \\) escaped+="\\$char" ;;
                *) escaped+="$char" ;;
            esac
        done
        CONTEXT_CREDENTIAL+="${CONTEXT_CREDENTIAL:+|}$escaped"
    done
    CONTEXT_CREDENTIAL_KEY="$key"
}

# is_secret PATH: templates are safe only outside the private store directory.
is_secret() {
    local p base
    p="$(lower "$(path "$1" 1)")"
    base="${p##*/}"
    case "$p" in */.secrets/* | */.secrets) return 0 ;; esac
    credential_path "$p" && return 0
    case "$base" in
        .env.example | .env.sample | .env.template | *.env.example | *.env.sample | *.env.template) return 1 ;;
        *.secret | .secrets.env | .envrc | .netrc | .git-credentials | .env | .env.* | *.env) return 0 ;;
    esac
    return 1
}

# Resolve symlinked ancestors and preserve the missing suffix for write targets.
canonical_target() {
    perl -MCwd=abs_path -e '
        my $p = shift;
        $p =~ m{^/} or exit 2;
        my @tail;
        while (!-e $p && !-l $p && $p ne "/") {
            $p =~ s{/+([^/]+)/*$}{} or exit 2;
            unshift @tail, $1;
            $p = "/" if $p eq "";
        }
        my $root = abs_path($p); defined $root or exit 2;
        for my $bit (@tail) {
            next if $bit eq ".";
            if ($bit eq "..") { $root =~ s{/[^/]+$}{}; $root = "/" if $root eq ""; }
            else { $root .= "/" unless $root eq "/"; $root .= $bit; }
        }
        print $root;
    ' "$1" 2>/dev/null
}

# Git configuration must not be planted by ordinary writes.
git_write_target() {
    local target resolved home_config xdg gitdir gitfile ancestor value="$1" name suffix k assigned root levels
    # Bash dynamically scopes the literal assignments collected by analyse.
    if [[ "$value" =~ ^\$\{?([A-Za-z_][A-Za-z_0-9]*)\}?(/.*)?$ ]]; then
        name="${BASH_REMATCH[1]}"; suffix="${BASH_REMATCH[2]:-}"
        case "$name" in HOME | XDG_CONFIG_HOME) ;;
            *)
                k=0
                local matches=0
                for assigned in ${WRITE_NAMES[@]+"${WRITE_NAMES[@]}"}; do
                    [[ "$assigned" != "$name" ]] || matches=$((matches + 1))
                done
                # Only a single plain assignment and expansions can witness the name.
                local remaining="$CMD"
                remaining="${remaining//\$\{$name\}/}"
                remaining="${remaining//\$$name/}"
                remaining="${remaining/$name=/}"
                if ((matches != 1)) || [[ "$CMD" == *"$name+="* ]] ||
                    [[ "$remaining" =~ (^|[^a-zA-Z0-9_])$name([^a-zA-Z0-9_]|$) ]] ||
                    [[ "$CMD" =~ (^|[[:space:];])(printf[[:space:]][^;]*-v|declare[[:space:]][^;]*-n|typeset[[:space:]][^;]*-n|local[[:space:]][^;]*-n|unset[[:space:]][^;]*-n) ]]; then return 0; fi
                for assigned in ${WRITE_NAMES[@]+"${WRITE_NAMES[@]}"}; do
                    if [[ "$assigned" == "$name" ]]; then value="${WRITE_VALUES[k]}$suffix"; fi
                    k=$((k + 1))
                done ;;
        esac
    fi
    # Unexpanded user homes cannot be anchored to the hook's own home.
    # shellcheck disable=SC2088  # literal tilde spellings, not shell expansion
    case "$value" in '~/'*) ;; '~'?*/*) return 0 ;; esac
    target="$(path "$value")"
    case "$target" in *'*'* | *'?'* | *'['* | *'$'* | *'`'*) return 0 ;; esac
    [[ "$CWD" != /proc/self/cwd || "$1" == /* ]] || return 0
    resolved="$(canonical_target "$target")" || return 0
    case "$(lower "$resolved")" in */.git | */.git/* | */.gitmodules) return 0 ;; esac
    home_config="$(canonical_target "${HOME:-/dev/null}/.gitconfig")" || return 0
    xdg="$(canonical_target "${XDG_CONFIG_HOME:-${HOME:-/dev/null}/.config}/git")" || return 0
    case "$resolved" in "$home_config" | "$xdg" | "$xdg"/*) return 0 ;; esac
    if [[ -n "${GIT_CONFIG_GLOBAL:-}" && "$resolved" == "$(canonical_target "$(path "$GIT_CONFIG_GLOBAL")")" ]]; then return 0; fi
    for root in "${GIT_DIR:-}" "${GIT_COMMON_DIR:-}" ${GIT_ROOTS[@]+"${GIT_ROOTS[@]}"}; do
        [[ -n "$root" ]] || continue
        gitdir="$(canonical_target "$(path "$root")")" || return 0
        case "$resolved" in "$gitdir" | "$gitdir"/*) return 0 ;; esac
    done
    # A separate git directory need not be beneath the current work tree.
    ancestor="$resolved"; levels=0
    while ((levels < 128)); do
        if [[ -f "$ancestor/HEAD" && -d "$ancestor/objects" && -d "$ancestor/refs" ]]; then return 0; fi
        [[ "$ancestor" != / ]] || break
        ancestor="${ancestor%/*}"; ancestor="${ancestor:-/}"
        levels=$((levels + 1))
    done
    # Linked worktrees can keep gitfiles at any ancestor of the effective cwd.
    ancestor="$(canonical_target "$CWD")" || return 0
    while :; do
        gitfile="$ancestor/.git"
        if [[ -f "$gitfile" && ! -L "$gitfile" ]]; then
            gitdir="$(perl -e 'my $f = shift; open my $h, "<", $f or exit 2; read $h, my $s, 1024; $s =~ m{\Agitdir: ([^\r\n]+)\r?\n?\z} or exit 2; print $1' "$gitfile" 2>/dev/null)" || gitdir=''
            if [[ -n "$gitdir" ]]; then
                [[ "$gitdir" == /* ]] || gitdir="$ancestor/$gitdir"
                gitdir="$(canonical_target "$gitdir")" || return 0
                case "$resolved" in "$gitdir" | "$gitdir"/*) return 0 ;; esac
            fi
        fi
        [[ "$ancestor" != / ]] || break
        ancestor="${ancestor%/*}"; ancestor="${ancestor:-/}"
    done
    return 1
}

# gitdir_cwd: the current directory is a protected write context only when
# physically inside a Git directory, not merely a worktree with a gitfile.
gitdir_cwd() {
    local ancestor levels=0
    ancestor="$(canonical_target "$CWD")" || return 0
    while ((levels < 128)); do
        if [[ -f "$ancestor/HEAD" && -d "$ancestor/objects" && -d "$ancestor/refs" ]]; then return 0; fi
        [[ "$ancestor" != / ]] || break
        ancestor="${ancestor%/*}"; ancestor="${ancestor:-/}"
        levels=$((levels + 1))
    done
    return 1
}

# file_secret PATH: resolve aliases using metadata only, including ancestors.
# Ordinary paths use shell metadata tests, avoiding a Perl process per operand.
# Missing paths retain the lexical rule; unresolved existing aliases fail closed.
file_secret() {
    is_secret "$1" && return 0
    case "$1" in
        /proc/cpuinfo | /proc/meminfo | /proc/loadavg | /proc/uptime | /proc/version | /proc/stat | /proc/self/status) ;;
        /proc/* | /dev/fd/* | /dev/stdin/* | /dev/stdout/* | /dev/stderr/*) return 0 ;;
    esac
    local p probe resolved
    p="$(path "$1")"
    if [[ -L "$p" && ! -e "$p" ]]; then
        # A dangling alias may still disclose its protected target name via
        # error text; do not require the target to exist before classifying it.
        resolved="$(readlink "$p" 2>/dev/null)" || return 0
        [[ "$resolved" == /* ]] || resolved="${p%/*}/$resolved"
        is_secret "$resolved"
        return
    fi
    [[ -e "$p" ]] || return 1
    probe="$p"
    while [[ "$probe" == */* ]]; do
        if [[ -L "$probe" ]]; then
            resolved="$(perl -MCwd=abs_path -e 'my $p = abs_path($ARGV[0]); defined $p or exit 1; print $p' "$p" 2>/dev/null)" || return 0
            is_secret "$resolved"
            return
        fi
        probe="${probe%/*}"
    done
    return 1
}

# protected_selector GLOB: search selectors are patterns, not cwd operands.
# Compare final segments with protected names/patterns in both directions;
# explicit private-directory components also target every file below them.
protected_selector() (
    # Ignore-case selectors follow rg semantics without changing hook options.
    [[ "${2:-0}" == 0 ]] || shopt -s nocasematch
    local selector base component name protected parts=() BRACES=() expanded
    brace_expand "$1" 1 || return 0
    if ((${#BRACES[@]} > 1)); then
        for expanded in "${BRACES[@]}"; do
            protected_selector "$expanded" "${2:-0}" && return 0
        done
        return 1
    fi
    selector="$(lower "${BRACES[0]}")"
    base="${selector##*/}"
    case "$selector" in '!'*) return 1 ;; esac
    credential_selector "$selector" && return 0
    for name in "${PROTECTED_NAMES[@]}" .env.local prod.secret; do
        # shellcheck disable=SC2053  # the selector is deliberately a pattern
        [[ "$name" == $base ]] && return 0
    done
    for protected in '.env' '.env.*' '*.env' '*.secret' '.secrets.env' '.netrc' '.git-credentials'; do
        # Reverse matching catches literal prefixes/suffixes in narrower globs.
        # shellcheck disable=SC2053
        [[ "$base" == $protected ]] && return 0
    done
    IFS=/ read -r -a parts <<<"$selector"
    for component in "${parts[@]}"; do
        # Generic directory wildcards alone must not reject ordinary code globs.
        case "$component" in *secret*)
            # shellcheck disable=SC2053
            [[ .secrets == $component ]] && return 0
            ;;
        esac
    done
    return 1
)

# A negative glob, including a brace alternative, never narrows search scope.
# Mode 1 requires every alternative to be negative, for config certification.
selector_negative() {
    local BRACES=() selector negative=0
    brace_expand "$1" 1 || return 1
    for selector in "${BRACES[@]}"; do
        if [[ "$selector" == '!'* ]]; then negative=1
        elif [[ "${2:-0}" == 1 ]]; then return 1; fi
    done
    ((negative))
}

# candidate TOKEN: only filename roles call this. Glob expansion uses a
# deadline and a 10000-name cap; neither filenames nor values are opened.
candidate() (
    local p="$1" item matches=()
    p="$(path "$p")"
    if [[ "$p" == *'*'* || "$p" == *'?'* || "$p" == *'['* ]]; then
        # Missing matches can still name future protected files (for example
        # after archive extraction or a conditional copy).
        # Limit wildcard path components before expanding a potentially broad
        # filesystem pattern. Actual matches, not theoretical names, decide.
        local component wild=0 remaining="$p"
        while [[ "$remaining" == */* ]]; do
            component="${remaining%%/*}"
            case "$component" in *'*'* | *'?'* | *'['*) wild=$((wild + 1)) ;; esac
            remaining="${remaining#*/}"
        done
        case "$remaining" in *'*'* | *'?'* | *'['*) wild=$((wild + 1)) ;; esac
        ((wild <= 3)) || return 0
        local complete=0
        # File::Glob receives one pattern as data; no shell expansion or
        # command text is evaluated. The terminal marker proves completion.
        while IFS= read -r -d '' item; do
            if [[ "$item" == "$US" ]]; then complete=1; break; fi
            matches+=("$item")
            ((${#matches[@]} <= 10000)) || return 0
        done < <(perl - "$p" <<'PERL'
use strict; use warnings; use Time::HiRes qw(alarm);
use File::Glob qw(bsd_glob GLOB_NOSORT);
local $SIG{ALRM} = sub { exit 2 }; alarm 0.5;
for my $match (bsd_glob($ARGV[0], GLOB_NOSORT)) {
    print "$match\0" if -e $match || -l $match;
}
alarm 0;
print "\x1f\0";
PERL
        )
        ((complete)) || return 0
        within_budget || return 0
        if [[ -z "${matches[0]:-}" ]] && protected_selector "$1"; then return 0; fi
        for item in ${matches[@]+"${matches[@]}"}; do file_secret "$item" && return 0; done
        return 1
    fi
    [[ "$1" == */* || -e "$p" || -L "$p" ]] || return 1
    file_secret "$p"
)

# tree_has_secret PATH...: names only; 0 protected, 1 clear, 2 incomplete.
# Default .git/node_modules pruning preserves the existing coverage boundary.
# Explicit roots inside them and searches with --hidden/globs disable pruning.
# Default pruning still cannot prove exclusions for tracked dependencies; it
# remains a compatibility limitation. Vendor is always covered.
# SCAN_ROOTS_ONLY checks explicit operands without scanning their descendants.
# Depth 13 is a sentinel for entries beyond depth 12 in the covered tree.
# All roots share one 200 ms scan deadline; Git ignore checks get 300 ms.
# NUL records preserve newline filenames. Stop starting scans after two hook
# seconds so compound commands stay bounded.
tree_has_secret() {
    context_credentials
    within_budget || return 2
    command -v perl >/dev/null 2>&1 || return 2
    # Pass the resolved executable explicitly: some Perl runtimes resolve
    # exec's bare name against a compiled-in path rather than the hook PATH.
    local find_bin
    find_bin="$(command -v find)" || return 2
    perl - "$CREDENTIAL_PATH" "$CREDENTIAL_PUBLIC" "$CONTEXT_CREDENTIAL" "${SCAN_PRUNED:-1}" "${SCAN_ROOTS_ONLY:-0}" "${SCAN_FOLLOW:-0}" "${SCAN_INCLUDE_TS:-0}" "${SCAN_RG_DEFAULT:-0}" "$find_bin" "${SCAN_NAME_GLOBS:-}" "${SCAN_GIT_IGNORE:-0}" "${SCAN_RG_IGNORE:-0}" "$GIT_BINARY" "$CWD" "$@" <<'PERL'
use strict; use warnings; use Time::HiRes qw(alarm); use Cwd qw(abs_path); use POSIX qw(setsid);
my ($credential, $public, $context, $prune, $roots_only, $follow, $include_ts, $rg_default, $find_bin, $glob_text, $git_ignore, $rg_ignore, $git, $cwd, @roots) = @ARGV;
my @filters;
for my $glob (split /\n/, $glob_text) {
    my $regex = quotemeta($glob);
    $regex =~ s/\\\*\\\*\\\//(?:.*\/)?/g;
    $regex =~ s/\\\*/.*/g;
    $regex =~ s/\\\?/./g;
    $regex =~ s/\\\{/(?:/g; $regex =~ s/\\\}/)/g; $regex =~ s/\\,|,/|/g;
    # Unknown bracket syntax cannot establish a narrower safe scope.
    $regex = ".*" if $glob =~ /[\[\]]/;
    # Fold conservatively for --iglob, -iname and case-insensitive filesystems.
    push @filters, [qr/\A$regex\z/i, index($glob, "/") >= 0];
}
sub selected {
    my ($path, $relative) = @_;
    return 1 unless @filters;
    my ($base) = $path =~ m{([^/]+)\z};
    $relative =~ s{^/}{};
    for my $filter (@filters) {
        return 1 if ($filter->[1] ? $relative : ($base // "")) =~ $filter->[0];
    }
    return 0;
}
# Perl's $ also matches before a final newline; public keys need an exact end.
$public =~ s/\$$/\\z/;
sub protected {
    my ($p) = @_;
    return 0 if $include_ts && $p !~ /\.(?:tsx?|[cm]ts)\z/i;
    return 1 if $p =~ /\A(?:$context)\z/i;
    return 1 if $p =~ /$credential\z/i && $p !~ /$public/i;
    return 1 if $p =~ m{(?:^|/)\.secrets(?:/|\z)}i;
    return 0 if $p =~ /(?:^|\/)(?:[^\/]*\.env|\.env)\.(?:example|sample|template)\z/i;
    return $p =~ m{(?:^|/)(?:\.envrc|\.env(?:\.[^/]*)?|[^/]*\.env|[^/]*\.secret|\.secrets\.env|\.netrc|\.git-credentials)\z}i;
}
# Resolve explicit roots using metadata only, including symlinked ancestors.
# An explicit root inside a normally pruned tree must not disappear from find.
local $SIG{ALRM} = sub { exit 2 };
alarm 0.2;
for my $root (@roots) {
    exit 0 if protected($root);
    my $resolved = abs_path($root);
    defined $resolved && -e $resolved or exit 2;
    exit 0 if protected($resolved);
    # The example globs do not exclude proc environment files. Never use a
    # roots-only proof to certify /proc or a filesystem-wide search.
    exit 2 if $roots_only && ($resolved eq '/' || $resolved =~ m{^/proc(?:/|\z)});
    $root = $resolved;
    if ($git_ignore && $rg_ignore) {
        my $ancestor = -d $root ? $root : $root =~ s{/[^/]+\z}{}r;
        while (length $ancestor) {
            if (-e "$ancestor/.ignore" || -l "$ancestor/.ignore" ||
                -e "$ancestor/.rgignore" || -l "$ancestor/.rgignore") { $git_ignore = 0; $rg_default = 0; last }
            last if $ancestor eq '/';
            $ancestor =~ s{/[^/]+\z}{}; $ancestor = '/' unless length $ancestor;
        }
    }
    $prune = 0 if $root =~ m{(?:^|/)(?:\.git|node_modules)(?:/|\z)};
}
@roots or exit 2;
exit 1 if $roots_only;
my $pid = open my $f, '-|'; defined $pid or exit 2;
if (!$pid) {
    # Follow explicit root symlinks, as rg does, but not descendant links.
    my @pruning = $prune ? ('(', '-type', 'd', '(', '-name', 'node_modules',
        '-o', '-name', '.git', ')', ')', '-prune', '-o') : ();
    exec $find_bin, ($follow ? '-L' : '-H'), @roots, '-maxdepth', '13', @pruning, '-print0';
    exit 2;
}
my ($found, $incomplete, $hidden_protected) = (0, 0, 0);
my @protected;
my $protected_bytes = 0;
local $SIG{ALRM} = sub { kill 'TERM', $pid; waitpid($pid, 0); exit 2 };
local $/ = "\0";
while (my $p = <$f>) {
    chomp $p;
    # Find emits each operand before its descendants, including repeated roots.
    my $root = $roots[0];
    for my $r (@roots) {
        if ($p eq $r || index($p, "$r/") == 0 || $r eq '/') { $root = $r; last }
    }
    my $relative = substr($p, length($root));
    my $depth = ($relative =~ tr{/}{/});
    $depth++ if $root eq '/' && length $relative;
    if ($depth > 12) { $incomplete = 1; last }
    # Ripgrep ignore files can re-include Git-ignored names. Their presence
    # invalidates Git-only certification, even outside the filename filter.
    if ($git_ignore && $rg_ignore && $p =~ m{(?:^|/)\.(?:rgignore|ignore)\z}) {
        $git_ignore = 0; $rg_default = 0;
        if ($hidden_protected) { $found = 1; last }
    }
    # find -L follows directory links before emitting descendants. Refuse a
    # filtered proof rather than judging their lexical (possibly public) names.
    if ($follow && -l $p && -d $p) { $incomplete = 1; last }
    if ($rg_default && length($relative) && $relative =~ m{(?:^|/)\.[^/]+(?:/|\z)}) {
        $hidden_protected = 1 if protected($p) && selected($p, $relative);
        next;
    }
    next unless selected($p, $relative);
    # A selected directory can bring unselected descendants into a reader's
    # scope. Filename-only certification cannot prove that subtree harmless.
    if (@filters && -d $p) { $incomplete = 1; last }
    if (protected($p)) {
        if (!$git_ignore) { $found = 1; last }
        push @protected, $p;
        $protected_bytes += length($p);
        if (@protected > 1000 || $protected_bytes > 40000) { $incomplete = 1; last }
    }
    if ($follow && -l $p) {
        my $resolved = abs_path($p);
        if (!defined $resolved) { $incomplete = 1; last }
        if (protected($resolved)) { $found = 1; last }
    }
}
kill 'TERM', $pid if $found || $incomplete;
close $f; my $status = $?; alarm 0;
exit 0 if $found;
exit 2 if $incomplete || $status;
# Only a real Git work tree can exclude ignored files. One bounded, scrubbed
# metadata probe checks every selected protected name, never file contents.
if (@protected) {
    exit 0 unless $git_ignore;
    exit 2 unless $git =~ m{^/};
    require File::Temp;
    my ($names) = File::Temp::tempfile(UNLINK => 1);
    binmode $names;
    print {$names} join("\0", @protected), "\0";
    seek($names, 0, 0) or exit 2;
    my $pid = open my $ignored, "-|"; defined $pid or exit 2;
    if (!$pid) {
        setsid() >= 0 or exit 2;
        open STDIN, "<&", $names or exit 2;
        exec "env", "-i", "PATH=$ENV{PATH}", "LC_ALL=C",
            "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null",
            "HOME=/dev/null/secret-guard-no-home", $git, "-C", $cwd,
            "-c", "core.fsmonitor=false", "-c", "core.untrackedCache=false",
            "-c", "core.hooksPath=/dev/null", "--no-optional-locks",
            "check-ignore", "--no-index", "--stdin", "-z";
        exit 2;
    }
    local $SIG{ALRM} = sub { kill "TERM", -$pid; waitpid($pid, 0); exit 2 };
    alarm 0.3;
    my %ignored;
    while (my $name = <$ignored>) { chomp $name; $ignored{$name} = 1; }
    close $ignored; my $result = $?; alarm 0;
    exit 2 unless $result == 0 || $result == 256;
    for my $name (@protected) { exit 0 unless $ignored{$name}; }
}
exit 1;
PERL
}

# patch_secret TEXT: inspect Codex patch path headers without parsing or
# applying content. Check both sides of a move, even in malformed patches.
# The scan is linear and only metadata is used to resolve aliases.
patch_secret() {
    local line name nbsp=$'\xc2\xa0' previous
    while IFS= read -r line || [[ -n "$line" ]]; do
        while :; do
            previous="$line"
            line="${line#"${line%%[!$' \t']*}"}"
            [[ "$line" != "$nbsp"* ]] || line="${line#"$nbsp"}"
            [[ "$line" != "$previous" ]] || break
        done
        case "$line" in
            '*** Add File: '* | '*** Update File: '* | '*** Delete File: '* | '*** Move to: '*)
                name="${line#*: }"
                if [[ -n "$name" ]] && file_secret "$name"; then return 0; fi
                ;;
        esac
    done <<<"$1"
    return 1
}

# brace_expand TEXT: syntax-only enumeration, capped at 64 results and 32 KiB
# of scanning. Quotes, escapes, parameters and substitutions retain provenance.
# Expand outer lists first, preserving field order; never execute generated text.
brace_expand() {
    local text="$1" index=0 pos c q start end body prefix suffix part n step finish width value
    local starts=() commas=() alternatives=() item changed level parameter
    local fallback_start fallback_end fallback_comma chosen_comma
    local sequence='^(-?[0-9]+)\.\.(-?[0-9]+)(\.\.(-?[0-9]+))?$'
    local letters='^([a-zA-Z])\.\.([a-zA-Z])(\.\.(-?[0-9]+))?$'
    local SUB_TEXT="" SUB_END=0
    BRACES=("$text")
    [[ "$text" != '{' ]] || return 0
    while ((index < ${#BRACES[@]})); do
        text="${BRACES[index]}"
        starts=() commas=() q="" changed=0 fallback_start=-1 fallback_end=0 fallback_comma=0
        for ((pos = 0; pos < ${#text}; pos++)); do
            BRACE_STEPS=$((BRACE_STEPS + 1))
            ((BRACE_STEPS <= 32768)) || return 1
            c="${text:pos:1}"
            if [[ "$c" == "\\" && "$q" != "'" ]]; then pos=$((pos + 1)); continue; fi
            if [[ "$q" == ansi ]]; then
                [[ "$c" != "'" ]] || q=""
                continue
            fi
            if [[ -n "$q" ]]; then
                [[ "$c" != "$q" ]] || q=""
                continue
            fi
            case "$c" in
                "'" | '"') q="$c"; continue ;;
                '`') substitution "$text" "$pos" || return 1; pos="$SUB_END"; continue ;;
                '$')
                    case "${text:pos+1:1}" in
                        "'") q=ansi; pos=$((pos + 1)) ;;
                        '(') substitution "$text" "$pos" || return 1; pos="$SUB_END" ;;
                        '{')
                            parameter=1
                            pos=$((pos + 2))
                            while ((pos < ${#text} && parameter)); do
                                case "${text:pos:1}" in '{') parameter=$((parameter + 1)) ;; '}') parameter=$((parameter - 1)) ;; esac
                                pos=$((pos + 1))
                            done
                            ((parameter == 0)) || return 1
                            pos=$((pos - 1))
                            ;;
                    esac
                    continue
                    ;;
                '{') starts+=("$pos"); commas+=(0) ;;
                ',')
                    level=${#starts[@]}
                    ((level == 0)) || commas[level-1]=1
                    ;;
                '}')
                    level=${#starts[@]}
                    ((level)) || continue
                    start="${starts[level-1]}" end="$pos"
                    body="${text:start+1:end-start-1}"
                    if ((level > 1)); then
                        # A non-expanding outer pair stays literal, but its first
                        # expandable descendant must still expand, in field order.
                        if ((commas[level-1])) || [[ "$body" =~ $sequence || "$body" =~ $letters ]]; then
                            if ((fallback_start < 0 || start < fallback_start)); then
                                fallback_start="$start" fallback_end="$end" fallback_comma="${commas[level-1]}"
                            fi
                        fi
                        unset 'starts[level-1]' 'commas[level-1]'
                        continue
                    fi
                    chosen_comma="${commas[level-1]}"
                    if ((chosen_comma == 0 && fallback_start >= 0)) && [[ ! "$body" =~ $sequence && ! "$body" =~ $letters ]]; then
                        start="$fallback_start" end="$fallback_end" chosen_comma="$fallback_comma"
                        body="${text:start+1:end-start-1}"
                    fi
                    alternatives=()
                    if ((chosen_comma)) || [[ "${2:-0}" == 1 && "$body" != *","* && "$body" != *"{"* ]]; then
                        # Split only active commas, retaining quoted/escaped bytes.
                        part="" q="" parameter=0
                        for ((n = 0; n < ${#body}; n++)); do
                            c="${body:n:1}"
                            if [[ "$c" == "\\" && "$q" != "'" ]]; then
                                part+="${body:n:2}"; n=$((n + 1)); continue
                            fi
                            if [[ "$q" == ansi ]]; then
                                [[ "$c" != "'" ]] || q=""
                            elif [[ -n "$q" ]]; then
                                [[ "$c" != "$q" ]] || q=""
                            elif [[ "$c" == '$' && "${body:n+1:1}" == "'" ]]; then
                                q=ansi; part+="${body:n:2}"; n=$((n + 1)); continue
                            elif [[ "$c" == "'" || "$c" == '"' ]]; then q="$c"
                            elif [[ "$c" == '{' ]]; then parameter=$((parameter + 1))
                            elif [[ "$c" == '}' ]]; then parameter=$((parameter - 1))
                            elif [[ "$c" == ',' && "$parameter" == 0 ]]; then alternatives+=("$part"); part=""; continue
                            fi
                            part+="$c"
                        done
                        alternatives+=("$part")
                    elif [[ "$body" =~ $sequence || "$body" =~ $letters ]]; then
                        part="${BASH_REMATCH[1]}" finish="${BASH_REMATCH[2]}" step="${BASH_REMATCH[4]:-1}" width=0
                        # Bound arithmetic before conversion, including Bash 3.2.
                        ((${#part} <= 6 && ${#finish} <= 6 && ${#step} <= 6)) || return 1
                        if [[ "$part" == [a-zA-Z] ]]; then
                            printf -v n '%d' "'$part"; printf -v finish '%d' "'$finish"
                            parameter=1
                        else
                            parameter=0
                            [[ "$part" != 0?* && "$finish" != 0?* ]] || width=${#part}
                            if ((width && ${#finish} > width)); then width=${#finish}; fi
                            value="${part#-}"; n=$((10#$value)); [[ "$part" != -* ]] || n=$((-n))
                            value="${finish#-}"; value=$((10#$value)); [[ "$finish" != -* ]] || value=$((-value)); finish="$value"
                        fi
                        step="${step#-}"; step=$((10#$step)); ((step)) || step=1
                        ((n <= finish)) || step=$((-step))
                        while (( (step > 0 && n <= finish) || (step < 0 && n >= finish) )); do
                            ((${#alternatives[@]} < 64)) || return 1
                            if ((parameter)); then
                                printf -v value '\\%03o' "$n"; printf -v value '%b' "$value"
                            else printf -v value '%0*d' "$width" "$n"; fi
                            alternatives+=("$value"); n=$((n + step))
                        done
                    fi
                    unset 'starts[level-1]' 'commas[level-1]'
                    if ((${#alternatives[@]})); then
                        ((${#BRACES[@]} - 1 + ${#alternatives[@]} <= 64)) || return 1
                        prefix="${text:0:start}" suffix="${text:end+1}"
                        for ((n = 0; n < ${#alternatives[@]}; n++)); do
                            item="${alternatives[n]}"
                            alternatives[n]="$prefix$item$suffix"
                        done
                        BRACES=("${BRACES[@]:0:index}" "${alternatives[@]}" "${BRACES[@]:index+1}")
                        changed=1
                        break
                    fi
                    ;;
            esac
        done
        if ((changed == 0)); then
            # Shell grouping braces are words in their own right, not expansions.
            for start in ${starts[@]+"${starts[@]}"}; do
                [[ "${text:start+1:1}" == ' ' || "${text:start+1:1}" == $'\n' ]] || return 1
            done
            index=$((index + 1))
        fi
    done
    return 0
}

context_credentials

case "$TOOL" in
    apply_patch)
        F="$(printf '%s' "$INPUT" | jq -er '.tool_input.command | select(type == "string") | gsub("\u0000"; "\u0001")' 2>/dev/null)" || exit 1
        if patch_secret "$F"; then decide 'patch targets a protected store'; fi
        exit 0
        ;;
    Read | Edit | Write | MultiEdit | NotebookEdit)
        F="$(printf '%s' "$INPUT" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')"
        if [[ -n "$F" ]] && { file_secret "$F" || { [[ "$TOOL" != Read ]] && git_write_target "$F"; }; }; then
            decide 'file access targets a protected store or git configuration'
        fi
        exit 0
        ;;
    Grep)
        F="$(printf '%s' "$INPUT" | jq -r '.tool_input.path // empty')"
        MODE="$(printf '%s' "$INPUT" | jq -r '.tool_input.output_mode // "files_with_matches"')"
        G="$(printf '%s' "$INPUT" | jq -r '.tool_input.glob // ""')"
        TYPE="$(printf '%s' "$INPUT" | jq -r '.tool_input.type // ""')"
        if [[ -n "$G" ]] && selector_negative "$G"; then G=''; fi
        # A literal DIR/** selects that subtree, not the whole envelope cwd.
        if [[ "$G" == */'**' ]]; then
            PREFIX="${G%/**}"
            case "$PREFIX" in *'*'* | *'?'* | *'['* | *'{'* | *'$'* | *'`'*) ;;
                *) F="$(path "${F:-$CWD}")/$PREFIX"; G='' ;;
            esac
        fi
        if [[ -n "$G" ]]; then
            # Grep globs use brace alternatives too. Reuse the bounded shell
            # enumerator, but only for selectors with braces, not shell code.
            BRACES=("$G")
            if [[ "$G" == *'{'* && ("$G" == *'$'* || "$G" == *'`'*) ]] ||
                { [[ "$G" == *'{'* ]] && ! brace_expand "$G"; }; then
                decide 'Grep selector cannot be expanded safely'
                exit 0
            fi
            for SELECTOR in "${BRACES[@]}"; do
                if protected_selector "$SELECTOR"; then
                    # Names-only wildcard searches do not disclose values.
                    if [[ "$MODE" != files_with_matches || ("$SELECTOR" != *'*'* && "$SELECTOR" != *'?'* && "$SELECTOR" != *'['*) ]]; then
                        decide 'Grep selector targets protected names'
                        exit 0
                    fi
                fi
            done
        fi
        case "$TYPE" in env | dotenv | secret | secrets | netrc | git-credentials)
            if [[ "$MODE" != files_with_matches ]]; then
                decide 'Grep type targets protected names'
                exit 0
            fi
            ;;
        esac
        F="$(path "${F:-$CWD}")"
        if [[ ! -d "$F" ]] && { is_secret "$F" || { [[ "$MODE" != files_with_matches ]] && file_secret "$F"; }; }; then
            decide 'Grep targets a protected store'
            exit 0
        fi
        if [[ "$MODE" != files_with_matches ]]; then
            SCAN=0
            SCAN_NAME_GLOBS=''
            if [[ -n "$G" ]]; then
                FILTER_SAFE=1
                for SELECTOR in "${BRACES[@]}"; do
                    if protected_selector "$SELECTOR"; then FILTER_SAFE=0; break; fi
                done
                if ((FILTER_SAFE)); then
                    for SELECTOR in "${BRACES[@]}"; do SCAN_NAME_GLOBS+="$SELECTOR"$'\n'; done
                fi
            fi
            case "$(lower "$TYPE")" in
                ts | typescript) SCAN_NAME_GLOBS=$'*.ts\n*.tsx\n*.mts\n*.cts\n' ;;
                js | javascript) SCAN_NAME_GLOBS=$'*.js\n*.jsx\n*.mjs\n*.cjs\n' ;;
                go) SCAN_NAME_GLOBS=$'*.go\n' ;;
                rust) SCAN_NAME_GLOBS=$'*.rs\n' ;;
                py | python) SCAN_NAME_GLOBS=$'*.py\n' ;;
                md | markdown) SCAN_NAME_GLOBS=$'*.md\n*.markdown\n*.mdown\n*.mkd\n*.mkdn\n*.mdwn\n' ;;
            esac
            tree_has_secret "$F" || SCAN=$?
            if [[ "$SCAN" != 1 ]]; then
                decide 'Grep content/count tree contains protected names or its scan is incomplete (depth, error, deadline); use files_with_matches or narrow the path'
            fi
        fi
        exit 0
        ;;
    Bash) ;;
    *) exit 0 ;;
esac

# skip_heredoc TEXT START: find the line equal to HD_DELIM (leading tabs
# stripped for <<-) from START and set HD_END just past it. A quoted delimiter
# makes the body literal; an unquoted body is skipped only when it holds no
# command substitution, which the shell would run. Returns 1 to analyse
# substitutions in the body, or 2 for a missing closing delimiter.
skip_heredoc() {
    local text="$1" pos="$2" line body=""
    while ((pos <= ${#text})); do
        line="${text:pos}"
        line="${line%%$'\n'*}"
        local cmp="$line"
        ((HD_STRIP == 0)) || cmp="${cmp#"${cmp%%[!$'\t']*}"}"
        if [[ "$cmp" == "$HD_DELIM" ]]; then
            # Literal $( and backtick text is the point here.
            # shellcheck disable=SC2016
            if ((HD_QUOTED == 0)) && [[ "$body" == *'$('* || "$body" == *'`'* ]]; then
                return 1
            fi
            HD_END=$((pos + ${#line}))
            return 0
        fi
        body+="$line"$'\n'
        pos=$((pos + ${#line} + 1))
    done
    # A missing closing delimiter cannot be certified as an inert body.
    return 2
}

# emit_word: enumerate raw word syntax before quote removal, then append every
# resulting field in order. Expansions are fields, never alternative commands.
emit_word() {
    ((word_started)) || return 0
    local raw="${text:word_start:i-word_start}" BRACES=() expanded fields=""
    local lines=() RAW_SEGMENTS=() NO_BRACES=1
    if [[ "${BRACE_DISABLED:-0}" == 0 && "$raw" == *'{'* ]]; then
        brace_expand "$raw" || return 1
        if ((${#BRACES[@]} > 1)) || [[ "${BRACES[0]}" != "$raw" ]]; then
            BRACE_FIELDS=$((BRACE_FIELDS + ${#BRACES[@]}))
            ((BRACE_FIELDS <= 128)) || return 1
            for expanded in "${BRACES[@]}"; do
                lines=() RAW_SEGMENTS=()
                tokenize "$expanded" || return 1
                ((${#lines[@]} <= 1)) || return 1
                [[ ${#lines[@]} == 0 ]] || fields+="${lines[0]:1}"
            done
            seg+="$fields"
            return 0
        fi
    fi
    seg+="$US$tok"
}

# tokenize TEXT: fill lines/RAW_SEGMENTS with quote-aware segments; the leading
# marker records direct pipes. Original text preserves substitution quoting.
# Tokens retain no evaluated shell expansion. Unclosed quotes fail analysis.
tokenize() {
    local text="$1" i=0 c q="" tok="" seg="" mark start=0 SUB_TEXT="" SUB_END=0 word_started=0 word_start=0
    local BRACE_DISABLED="${NO_BRACES:-0}" brace_depth=0
    local HD_DELIM="" HD_STRIP=0 HD_QUOTED=0 HD_END=0 comment escape digits decoded fd word_literal=1
    # shellcheck disable=SC2016  # literal shell expansion syntax
    local ifs_length parameter='^\$(\{[^}]*\}|[[:alnum:]_]+|[@*#?$!_-])'
    local controls='[[:cntrl:]]' tab=$'\t' newline=$'\n' checked
    # Bash 3.2 on musl misclassifies ranges of raw control bytes in EREs.
    # shellcheck disable=SC2295  # fixed non-glob bytes, without nested 3.2 quotes
    checked="${text//$tab/}"
    # shellcheck disable=SC2295
    checked="${checked//$newline/}"
    [[ ! "$checked" =~ $controls ]] || return 1
    while ((i < ${#text})); do
        if ((i % 32 == 0)) && ! within_budget; then
            REASON='command exceeds analysis budget; split the command'; return 1
        fi
        c="${text:i:1}"
        if ((word_started == 0)); then word_literal=1; word_start="$i"; brace_depth=0; fi
        if [[ -z "$q" ]]; then
            case "$c" in
                '{') brace_depth=$((brace_depth + 1)) ;;
                '}') ((brace_depth == 0)) || brace_depth=$((brace_depth - 1)) ;;
            esac
        fi
        # Only unquoted IFS expansions split shell words. Quoted/escaped prose
        # retains its word boundaries; double-quoted command expansions stay active.
        # shellcheck disable=SC2016  # compare literal parameter spellings
        if [[ -z "$q" && "$c" == '$' && "$brace_depth" == 0 ]]; then
            ifs_length=0
            if [[ "${text:i:6}" == '${IFS}' ]]; then ifs_length=6
            elif [[ "${text:i:4}" == '$IFS' && "${text:i+4:1}" != [[:alnum:]_] ]]; then ifs_length=4; fi
            if ((ifs_length)); then
                emit_word || return 1
                tok="" word_started=0
                i=$((i + ifs_length))
                continue
            fi
        fi
        # Mark provenance in token data, not by matching identical inert text
        # elsewhere in the segment. Remove markers after wrapper handling.
        if [[ "$q" != "'" && "$q" != ansi && "$c" == '$' && "${text:i}" =~ $parameter ]]; then tok+="$ACTIVE"; fi
        # Keep active substitutions atomic, including spaces/quotes inside them.
        # Their original segment is analysed later, after preceding cd commands.
        if [[ "$q" != "'" && "$q" != ansi ]] && [[ "$c" == '`' || ("$c" == '$' && "${text:i+1:1}" == '(') ]]; then
            substitution "$text" "$i" || return 1
            word_started=1
            word_literal=0
            tok+="$ACTIVE${text:i:SUB_END-i+1}"
            i=$((SUB_END + 1))
            continue
        fi
        if [[ "$q" == ansi ]]; then
            if [[ "$c" == "'" ]]; then
                q=""
            elif [[ "$c" == "\\" ]]; then
                i=$((i + 1))
                escape="${text:i:1}"
                case "$escape" in
                    x)
                        digits=""
                        while ((${#digits} < 2)) && [[ "${text:i+1:1}" == [[:xdigit:]] ]]; do
                            i=$((i + 1))
                            digits+="${text:i:1}"
                        done
                        [[ -n "$digits" ]] || return 1
                        escape="x$digits"
                        ;;
                    [0-7])
                        digits="$escape"
                        while ((${#digits} < 3)) && [[ "${text:i+1:1}" == [0-7] ]]; do
                            i=$((i + 1))
                            digits+="${text:i:1}"
                        done
                        escape="0$digits"
                        ;;
                    u | U)
                        # Decode ASCII codepoints ourselves: printf %b support
                        # for Unicode escapes differs between Bash 3.2 and 5.
                        digits="${text:i+1:4}"
                        [[ "$escape" != U ]] || digits="${text:i+1:8}"
                        [[ "$digits" =~ ^[[:xdigit:]]{4}$ || "$digits" =~ ^[[:xdigit:]]{8}$ ]] || return 1
                        i=$((i + ${#digits}))
                        decoded=$((16#$digits))
                        ((decoded > 0 && decoded <= 127)) || return 1
                        printf -v escape '%03o' "$decoded"
                        escape="0$escape"
                        ;;
                    "\\" | "'" | '"' | n | t | e | a | b | f | r | v) ;;
                    *) return 1 ;;
                esac
                case "$escape" in
                    "'" | '"') decoded="$escape" ;;
                    *) printf -v decoded '%b' "\\$escape" ;;
                esac
                # NUL cannot live in a variable; separators cannot be token data.
                [[ -n "$decoded" && "$decoded" != "$US" && "$decoded" != "$REDIR" && "$decoded" != "$ACTIVE" ]] || return 1
                tok+="$decoded"
            else tok+="$c"; fi
        elif [[ -n "$q" ]]; then
            if [[ "$c" == "$q" ]]; then
                q=""
            elif [[ "$q" == '"' && "$c" == "\\" ]]; then
                i=$((i + 1))
                [[ "${text:i:1}" == $'\n' ]] || tok+="${text:i:1}"
            else tok+="$c"; fi
        else
            case "$c" in
                '$')
                    word_started=1
                    word_literal=0
                    case "${text:i+1:1}" in
                        "'") q=ansi; i=$((i + 1)) ;;
                        '"') q='"'; i=$((i + 1)) ;;
                        *) tok+="$c" ;;
                    esac
                    ;;
                "'" | '"')
                    word_started=1
                    word_literal=0
                    q="$c"
                    ;;
                '#')
                    if ((word_started == 0)); then
                        if [[ -n "$seg" ]]; then
                            lines+=("-$seg")
                            RAW_SEGMENTS+=("${text:start:i-start}")
                        fi
                        seg=""
                        comment="${text:i}"
                        comment="${comment%%$'\n'*}"
                        i=$((i + ${#comment}))
                        start="$i"
                        continue
                    fi
                    tok+="$c"
                    ;;
                "\\")
                    i=$((i + 1))
                    if [[ "${text:i:1}" != $'\n' ]]; then
                        word_started=1
                        word_literal=0
                        tok+="${text:i:1}"
                    fi
                    ;;
                ' ' | $'\t')
                    emit_word || return 1
                    tok=""
                    word_started=0
                    ;;
                '(' | ')')
                    emit_word || return 1
                    tok=""
                    word_started=0
                    if [[ "$c" == ')' ]]; then
                        if [[ -n "$seg" ]]; then
                            lines+=("-$seg")
                            RAW_SEGMENTS+=("${text:start:i-start}")
                        fi
                        seg=""
                        start="$i"
                    fi
                    seg+="$US$c"
                    ;;
                '<')
                    emit_word || return 1
                    tok="<"
                    if [[ "${text:i+1:2}" == '<<' ]]; then
                        # Here-string: its word is ordinary text, analysed as usual.
                        tok="<<<"
                        i=$((i + 2))
                    elif [[ "${text:i+1:1}" == '<' ]]; then
                        # Heredoc: note its delimiter so the body is skipped at the
                        # next newline instead of being read as commands.
                        tok="<<"
                        i=$((i + 2))
                        HD_STRIP=0 HD_QUOTED=0 HD_DELIM=""
                        [[ "${text:i:1}" != '-' ]] || {
                            HD_STRIP=1
                            i=$((i + 1))
                        }
                        while [[ "${text:i:1}" == ' ' ]]; do i=$((i + 1)); done
                        while ((i < ${#text})); do
                            c="${text:i:1}"
                            case "$c" in
                                ' ' | $'\t' | $'\n' | ';' | '|' | '&' | ')') break ;;
                                "'" | '"' | "\\") HD_QUOTED=1 ;;
                                *) HD_DELIM+="$c" ;;
                            esac
                            i=$((i + 1))
                        done
                        seg+="$US$tok"
                        tok=""
                        word_started=0
                        continue
                    fi
                    seg+="$US$tok"
                    tok=""
                    word_started=0
                    ;;
                '>' | '&')
                    if [[ "$c" == '>' || "${text:i+1:1}" == '>' ]]; then
                        fd=""
                        if ((word_literal)) && [[ "$c" == '>' && "$tok" =~ ^[0-9]+$ ]]; then
                            fd="$tok"
                            while [[ "${fd:0:1}" == 0 && ${#fd} -gt 1 ]]; do fd="${fd:1}"; done
                        else
                            emit_word || return 1
                        fi
                        [[ "$c" != '&' ]] || { fd='&'; i=$((i + 1)); }
                        tok="$REDIR$fd>"
                        if [[ "${text:i+1:1}" == '>' || "${text:i+1:1}" == '&' || "${text:i+1:1}" == '|' ]]; then
                            tok+="${text:i+1:1}"
                            i=$((i + 1))
                        fi
                        seg+="$US$tok"
                        tok=""
                        word_started=0
                        i=$((i + 1))
                        continue
                    fi
                    emit_word || return 1
                    tok=""
                    word_started=0
                    if [[ -n "$seg" ]]; then
                        mark=b
                        [[ "${text:i+1:1}" != '&' ]] || mark=a
                        lines+=("$mark$seg")
                        RAW_SEGMENTS+=("${text:start:i-start}")
                    fi
                    seg=""
                    [[ "${text:i+1:1}" != '&' ]] || i=$((i + 1))
                    start=$((i + 1))
                    ;;
                ';' | '|' | $'\n')
                    emit_word || return 1
                    tok=""
                    word_started=0
                    mark='-'
                    if [[ "$c" == '|' ]]; then
                        if [[ "${text:i+1:1}" == '|' ]]; then mark=o; else mark=p; fi
                    fi
                    if [[ -n "$seg" ]]; then
                        lines+=("$mark$seg")
                        RAW_SEGMENTS+=("${text:start:i-start}")
                    fi
                    seg=""
                    [[ "$c" == $'\n' || "${text:i+1:1}" != "$c" ]] || i=$((i + 1))
                    if [[ "$c" == $'\n' && -n "$HD_DELIM" ]]; then
                        if skip_heredoc "$text" $((i + 1)); then
                            i=$((HD_END - 1))
                        else
                            if [[ "$?" == 2 ]]; then HEREDOC_MALFORMED=1; return 1; fi
                        fi
                        HD_DELIM=""
                    fi
                    start=$((i + 1))
                    ;;
                *)
                    word_started=1
                    tok+="$c"
                    ;;
            esac
        fi
        i=$((i + 1))
    done
    [[ -z "$q" ]] || return 1
    if [[ -n "$HD_DELIM" ]]; then HEREDOC_MALFORMED=1; return 1; fi
    emit_word || return 1
    if [[ -n "$seg" ]]; then
        lines+=("-$seg")
        RAW_SEGMENTS+=("${text:start}")
    fi
    return 0
}

# split_tokens SERIALIZED: preserve decoded newlines and empty quoted words.
# The separator is syntax only; tokenize rejects it in incoming command text.
split_tokens() {
    local rest="$1"
    TOKENS=()
    while [[ "$rest" == *"$US"* ]]; do
        # Bash 3.2 keeps nested quotes literal; US is a fixed non-glob byte.
        # shellcheck disable=SC2295
        TOKENS+=("${rest%%$US*}")
        # shellcheck disable=SC2295
        rest="${rest#*$US}"
    done
    TOKENS+=("$rest")
}

# substitution TEXT START: locate a balanced $(...) or backtick body without
# executing it. Sets SUB_TEXT/SUB_END; nested quotes restore at each parenthesis.
substitution() {
    local text="$1" start="$2" i c q="" depth=1 begin quotes=() case_end=0 suffix prefix
    SUB_TEXT="" SUB_END=0
    if [[ "${text:start:1}" == '`' ]]; then
        begin=$((start + 1))
        i="$begin"
        while ((i < ${#text})); do
            c="${text:i:1}"
            if [[ "$c" == "\\" ]]; then
                i=$((i + 2))
                continue
            fi
            if [[ "$c" == '`' ]]; then
                SUB_TEXT="${text:begin:i-begin}"
                SUB_END="$i"
                return 0
            fi
            i=$((i + 1))
        done
        return 1
    fi
    begin=$((start + 2))
    # Case patterns close with ')' inside a command substitution; that byte
    # does not terminate the substitution until the matching esac is passed.
    suffix="${text:begin}"
    if [[ "$suffix" == case\ * && "$suffix" == *esac* ]]; then
        prefix="${suffix%%esac*}"
        case_end=$((begin + ${#prefix} + 4))
    fi
    i="$begin"
    while ((i < ${#text})); do
        c="${text:i:1}"
        if [[ "$q" == ansi ]]; then
            if [[ "$c" == "\\" ]]; then i=$((i + 2)); continue; fi
            [[ "$c" != "'" ]] || q=""
            i=$((i + 1))
            continue
        fi
        if [[ -z "$q" && "$c" == '$' && "${text:i+1:1}" == "'" ]]; then
            q=ansi
            i=$((i + 2))
            continue
        fi
        if [[ "$c" == "\\" && "$q" != "'" ]]; then
            i=$((i + 2))
            continue
        fi
        if [[ "$c" == '$' && "${text:i+1:1}" == '(' && "$q" != "'" && "$q" != '`' ]]; then
            quotes[depth]="$q"
            depth=$((depth + 1))
            q=""
            i=$((i + 2))
            continue
        fi
        if [[ -n "$q" ]]; then
            [[ "$c" != "$q" ]] || q=""
        else
            case "$c" in
                "'" | '"' | '`') q="$c" ;;
                '(')
                    quotes[depth]=""
                    depth=$((depth + 1))
                    ;;
                ')')
                    if ((case_end && i < case_end && depth == 1)); then i=$((i + 1)); continue; fi
                    depth=$((depth - 1))
                    if ((depth == 0)); then
                        SUB_TEXT="${text:begin:i-begin}"
                        SUB_END="$i"
                        return 0
                    fi
                    q="${quotes[depth]:-}"
                    ;;
            esac
        fi
        i=$((i + 1))
    done
    return 1
}

# collect_substitutions TEXT: ignore single-quoted/escaped literal prose and
# retain active substitution bodies for bounded recursive command analysis.
collect_substitutions() {
    local text="$1" i=0 c q="" SUB_TEXT="" SUB_END=0 operand="${2:-}"
    # shellcheck disable=SC2016  # match literal shell parameter spellings
    local parameter='^\$(\{[^}]*\}|[[:alnum:]_]+|[@*#?$!_-])'
    while ((i < ${#text})); do
        c="${text:i:1}"
        if [[ "$q" == ansi ]]; then
            if [[ "$c" == "\\" ]]; then i=$((i + 2)); continue; fi
            [[ "$c" != "'" ]] || q=""
            i=$((i + 1))
            continue
        fi
        if [[ -z "$q" && "$c" == '$' && "${text:i+1:1}" == "'" ]]; then
            q=ansi
            i=$((i + 2))
            continue
        fi
        if [[ "$c" == "\\" && "$q" != "'" ]]; then
            i=$((i + 2))
            continue
        fi
        if [[ -n "$operand" && "$q" != "'" && "$c" == '$' && "${text:i}" =~ $parameter ]]; then
            [[ "$operand" != *"${BASH_REMATCH[0]}"* ]] || ACTIVE_OPERAND=1
        fi
        if [[ "$q" != "'" ]] && [[ "$c" == '`' || ("$c" == '$' && "${text:i+1:1}" == '(') ]]; then
            substitution "$text" "$i" || return 1
            if [[ -n "$operand" && "$operand" == *"${text:i:SUB_END-i+1}"* ]]; then ACTIVE_OPERAND=1; fi
            SUBSTITUTIONS+=("$SUB_TEXT")
            ((${#SUBSTITUTIONS[@]} <= 200)) || return 1
            i=$((SUB_END + 1))
            continue
        fi
        if [[ -n "$q" ]]; then
            [[ "$c" != "$q" ]] || q=""
        elif [[ "$c" == "'" || "$c" == '"' ]]; then q="$c"; fi
        i=$((i + 1))
    done
    return 0
}

# literal_output TEXT: concatenate only literal echo/printf arguments. This is
# a name witness, not execution or a general shell/printf evaluator.
literal_output() {
    local lines=() RAW_SEGMENTS=() TOKENS=() line t start count=0
    LITERAL_OUTPUT=""
    tokenize "$1" || return 1
    for line in "${lines[@]}"; do
        [[ "${line:0:1}" != p ]] || return 1
        split_tokens "${line:2}"
        count=$((count + ${#TOKENS[@]}))
        ((count <= 128)) || return 1
        start=1
        case "${TOKENS[0]}" in
            echo) [[ "${TOKENS[1]:-}" != -n ]] || start=2 ;;
            printf)
                case "${TOKENS[1]:-}" in
                    '%s' | '%s\n') start=2 ;;
                    *'%'* | *"\\"*) return 1 ;;
                esac
                ;;
            *) return 1 ;;
        esac
        for t in "${TOKENS[@]:start}"; do
            # shellcheck disable=SC2295  # fixed provenance marker
            t="${t//$ACTIVE/}"
            case "$t" in *'$'* | *'`'* | *'*'* | *'?'* | *'['* | "$REDIR"* | '<' | -*) return 1 ;; esac
            LITERAL_OUTPUT+="$t"
        done
    done
}

# reader_operand TOKEN: unresolved operands only gain a deny when the complete
# original request names protected access, or a literal substitution names it.
reader_operand() {
    local raw="${2:-${RAW_SEGMENTS[i]:-}}"
    local operand="$1" pattern='\$[({[:alnum:]_@*#?$!_-]|`' i=0 c name=""
    local SUB_TEXT="" SUB_END=0 LITERAL_OUTPUT="" SUBSTITUTIONS=() ACTIVE_OPERAND=0
    # Pipeline look-behind receives tokens before command marker removal.
    # shellcheck disable=SC2295
    operand="${operand//$ACTIVE/}"
    case "$operand" in --include=* | --exclude=* | --exclude-dir=* | --glob=* | --iglob=*) return 1 ;; esac
    credential_path "$(lower "$(path "$operand" 1)")" && return 0
    candidate "$operand" && return 0
    # Even unresolved KUBECONFIG names a credential-file input by definition.
    # Literal single-quoted and escaped data keep their ordinary filename role.
    # shellcheck disable=SC2016  # variable spellings are syntax, never evaluated
    case "$operand" in '$KUBECONFIG' | '${KUBECONFIG}')
        if [[ "$raw" != *"'$operand'"* && "$raw" != *"\\$operand"* ]]; then return 0; fi ;;
    esac
    if [[ "$raw" != *"'$operand'"* && "$raw" != *"\\$operand"* ]] &&
        [[ "$operand" =~ ^\$([A-Za-z_][A-Za-z_0-9]*)$ ]]; then
        local assigned="${BASH_REMATCH[1]}" n
        for ((n = 0; n < ${#WRITE_NAMES[@]}; n++)); do
            if [[ "$assigned" == "${WRITE_NAMES[n]}" ]] && candidate "${WRITE_VALUES[n]}"; then return 0; fi
        done
    fi
    case "$operand" in /proc/* | /dev/fd/* | /dev/stdin/* | /dev/stdout/* | /dev/stderr/*)
        file_secret "$operand" && return 0 ;;
    esac
    if [[ "$operand" != /* ]]; then
        local possible_cwd="$CWD" alternate_cwd
        for alternate_cwd in ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}; do
            [[ "$alternate_cwd" != /proc/self/cwd ]] || return 0
            CWD="$alternate_cwd"
            if candidate "$operand"; then return 0; fi
        done
        CWD="$possible_cwd"
    fi
    [[ "$CWD" != /proc/self/cwd ]] || { [[ "$operand" == /* ]] || return 0; }
    [[ "$operand" =~ $pattern ]] || return 1
    collect_substitutions "$raw" "$operand" || return 1
    ((ACTIVE_OPERAND)) || return 1
    if ((RAW_OPERAND_PROTECTED < 0)); then
        RAW_OPERAND_PROTECTED=0
        if raw_mentions_protected "$CMD" 3; then RAW_OPERAND_PROTECTED=1; fi
    fi
    ((RAW_OPERAND_PROTECTED == 0)) || return 0
    while ((i < ${#operand})); do
        c="${operand:i:1}"
        if [[ "$c" == '`' || ("$c" == '$' && "${operand:i+1:1}" == '(') ]]; then
            substitution "$operand" "$i" || return 1
            literal_output "$SUB_TEXT" || return 1
            name+="$LITERAL_OUTPUT"
            i=$((SUB_END + 1))
            continue
        fi
        [[ "$c" != '$' ]] || return 1
        name+="$c"
        i=$((i + 1))
    done
    candidate "$name"
}

# wrapper_options BASE: consume known utility options in W, with explicit
# arities. Unknown/missing options return analysis failure, never a guessed child.
# xargs arg-file operands are paths even when no child command follows them.
wrapper_options() {
    local base="$1" option take value file_arg shell_mode=0 code t quote="'" replacement="'\\''"
    while ((${#W[@]})) && [[ "${W[0]}" == -* ]]; do
        option="${W[0]}"
        take=1
        value=""
        file_arg=0
        if [[ "$option" == -- ]]; then
            W=("${W[@]:1}")
            break
        fi
        case "$base:$option" in
            env:-u | env:--unset | env:-C | env:--chdir | env:-S | env:--split-string | sudo:-u | sudo:-g | sudo:-h | sudo:-p | sudo:-C | sudo:-D | sudo:-R | sudo:-T | sudo:-U | sudo:--user | sudo:--group | sudo:--host | sudo:--prompt | sudo:--close-from | sudo:--chdir | sudo:--chroot | sudo:--command-timeout | sudo:--other-user)
                take=2
                ;;
            env:--unset=* | env:--chdir=* | env:--split-string=* | sudo:--user=* | sudo:--group=* | sudo:--host=* | sudo:--prompt=* | sudo:--close-from=* | sudo:--chdir=* | sudo:--chroot=* | sudo:--command-timeout=* | sudo:--other-user=*) value="${option#*=}" ;;
            env:-u?* | env:-C?* | env:-S?* | sudo:-u?* | sudo:-g?* | sudo:-h?* | sudo:-p?* | sudo:-C?* | sudo:-D?* | sudo:-R?* | sudo:-T?* | sudo:-U?*) value="${option:2}" ;;
            env:-i | env:--ignore-environment | env:-0 | env:--null) ;;
            sudo:-s | sudo:--shell | sudo:-i | sudo:--login) shell_mode=1 ;;
            sudo:-A | sudo:-b | sudo:-E | sudo:-H | sudo:-K | sudo:-k | sudo:-l | sudo:-n | sudo:-P | sudo:-S | sudo:-V | sudo:-v | sudo:--askpass | sudo:--background | sudo:--preserve-env | sudo:--set-home | sudo:--reset-timestamp | sudo:--remove-timestamp | sudo:--list | sudo:--non-interactive | sudo:--preserve-groups | sudo:--stdin | sudo:--version | sudo:--validate | sudo:--help) ;;
            timeout:-s | timeout:--signal | timeout:-k | timeout:--kill-after | gtimeout:-s | gtimeout:--signal | gtimeout:-k | gtimeout:--kill-after | nice:-n | nice:--adjustment | exec:-a | stdbuf:-i | stdbuf:-o | stdbuf:-e | stdbuf:--input | stdbuf:--output | stdbuf:--error | caffeinate:-t | caffeinate:-w | xargs:-n | xargs:-L | xargs:-I | xargs:-s | xargs:-P | xargs:-E | xargs:-J | xargs:-d | xargs:-R | xargs:-S | xargs:--max-args | xargs:--max-chars | xargs:--max-procs | xargs:--delimiter)
                take=2
                ;;
            xargs:-a | xargs:--arg-file)
                take=2
                file_arg=1
                ;;
            xargs:-a?*)
                value="${option:2}"
                file_arg=1
                ;;
            xargs:--arg-file=*)
                value="${option#*=}"
                file_arg=1
                ;;
            timeout:-s?* | timeout:-k?* | timeout:--signal=* | timeout:--kill-after=* | gtimeout:-s?* | gtimeout:-k?* | gtimeout:--signal=* | gtimeout:--kill-after=* | nice:-n?* | nice:--adjustment=* | exec:-a?* | stdbuf:-i?* | stdbuf:-o?* | stdbuf:-e?* | stdbuf:--input=* | stdbuf:--output=* | stdbuf:--error=* | caffeinate:-t?* | caffeinate:-w?* | xargs:-n?* | xargs:-L?* | xargs:-I?* | xargs:-s?* | xargs:-P?* | xargs:-E?* | xargs:-J?* | xargs:-d?* | xargs:-R?* | xargs:-S?* | xargs:--max-args=* | xargs:--max-lines=* | xargs:--replace=* | xargs:--max-chars=* | xargs:--max-procs=* | xargs:--eof=* | xargs:--delimiter=*) ;;
            timeout:--foreground | timeout:--preserve-status | timeout:--verbose | timeout:-v | gtimeout:--foreground | gtimeout:--preserve-status | gtimeout:--verbose | gtimeout:-v | exec:-c | exec:-l | exec:-cl | exec:-lc | xargs:-0 | xargs:--null | xargs:--max-lines | xargs:--replace | xargs:--eof | xargs:-r | xargs:--no-run-if-empty | xargs:-t | xargs:--verbose | xargs:-p | xargs:--interactive | xargs:-x | xargs:--exit | xargs:-o | xargs:--open-tty | nohup:--help | nohup:--version | nice:--help | nice:--version | stdbuf:--help | stdbuf:--version | timeout:--help | timeout:--version | gtimeout:--help | gtimeout:--version | xargs:--help | xargs:--version) ;;
            *)
                if [[ "$base" == nice && "$option" =~ ^-[0-9]+$ ]]; then
                    :
                elif [[ "$base" == caffeinate && "$option" =~ ^-[dimsu]+$ ]]; then
                    :
                else return 1; fi
                ;;
        esac
        ((${#W[@]} >= take)) || return 1
        [[ "$take" != 2 ]] || value="${W[1]}"
        case "$base:$option" in
            env:-C* | env:--chdir | env:--chdir=*)
                [[ "$value" != *'$'* && "$value" != *'`'* && "$value" != *'*'* && "$value" != *'?'* && "$value" != *'['* ]] || return 1
                CWD="$(path "$value")"
                ;;
            env:-S* | env:--split-string | env:--split-string=*)
                if [[ "$value" == *doas* || "$value" == *sudo* || "$value" == *run0* || "$value" == *pkexec* ]]; then
                    REASON='launcher split string cannot be certified'; return 0
                fi
                if [[ ("$CMD" == *'\_'* || "$CMD" == *'\t'*) && "$value" =~ (^|[^[:alnum:]_])(paste|cat|grep|env|printenv) ]]; then
                    REASON='env split string contains a reader or printer'; return 0
                fi
                # Split words re-enter env option/assignment parsing before the child.
                code="env $value"
                # Fixed quote byte, without quoted patterns inside 3.2 expansion.
                # shellcheck disable=SC2295
                for t in "${W[@]:take}"; do code+=" '${t//$quote/$replacement}'"; done
                W=(bash -c "$code")
                return 0
                ;;
        esac
        if ((file_arg)); then
            if reader_operand "$value"; then
                REASON='xargs arg-file reads a protected store'
                return 0
            fi
        fi
        W=("${W[@]:take}")
    done
    if ((shell_mode)) && { ((${#W[@]} == 0)) || [[ "${W[0]:-}" == '<' || "${W[0]:-}" == '<<<' ]]; }; then
        REASON='sudo shell without command cannot be certified'; return 0
    fi
    if ((shell_mode && ${#W[@]})); then
        printf -v code '%s ' "${W[@]}"
        W=(bash -c "$code")
    fi
    return 0
}

# Keep package-runner scope local to its child, not later shell siblings.
runner_scope() {
    if ((WORKSPACE_SCOPE_ACTIVE == 0)); then
        WORKSPACE_ORIGINAL_CWDS=(${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"})
        WORKSPACE_SCOPE_ACTIVE=1
    fi
}

# Find a project root using names only. Prefer a workspace/repository marker;
# otherwise retain the outermost package directory within the bounded walk.
runner_project_root() {
    local current="$CWD" root="$CWD" steps=0
    while [[ "$current" != / && "$current" != /proc/self/cwd ]]; do
        steps=$((steps + 1)); ((steps <= 32)) || return 1
        if [[ -e "$current/pnpm-workspace.yaml" ]]; then
            printf '%s\n' "$current"; return 0
        fi
        if [[ -e "$current/.git" || -f "$current/package.json" ]]; then root="$current"; fi
        current="${current%/*}"; current="${current:-/}"
    done
    printf '%s\n' "$root"
}

# Keep the quoted Perl heredoc outside process substitution for Bash 3.2.
runner_project_names() {
    perl - "$1" <<'PERL'
use strict; use warnings; use File::Find; use Time::HiRes qw(alarm);
my $root = shift; -d $root or exit 2;
local $SIG{ALRM} = sub { exit 2 }; alarm 0.2;
local $SIG{__WARN__} = sub { exit 2 };
my ($count, $dirs) = (0, 0);
find({ no_chdir => 1, wanted => sub {
    ++$count <= 10000 or die "scan bound";
    my $name = $File::Find::name;
    if ($name =~ m{/(?:node_modules|\.git)\z}) { $File::Find::prune = 1; return }
    my $relative = substr($name, length($root));
    ($relative =~ tr{/}{/}) <= 12 or die "depth bound";
    -l $name && -d $name and die "directory alias";
    if (-d $name) { -r $name && -x $name or die "directory access"; ++$dirs <= 32 or die "cwd bound"; print "$name\0" }
}}, $root);
alarm 0; print "\x1f\0";
PERL
}

# Unresolved names/recursive selection use a conservative superset of workspace
# directories: the whole project tree, bounded by the existing cwd-set cap.
# No package scripts or config contents are read. Incomplete metadata denies.
runner_project_cwds() {
    local root item complete=0 dirs=()
    root="$(runner_project_root)" || return 1
    [[ "$root" != /proc/self/cwd && "$root" != / ]] || return 1
    while IFS= read -r -d '' item; do
        if [[ "$item" == "$US" ]]; then complete=1; break; fi
        dirs+=("$item")
        ((${#dirs[@]} <= 32)) || return 1
    done < <(runner_project_names "$root")
    ((complete)) || return 1
    for item in ${dirs[@]+"${dirs[@]}"}; do remember_cwd "$item" || return 1; done
}

# pnpm filters are paths only with an explicit path prefix. npm requires a
# package.json in the resolved directory; a plain same-named folder is not proof.
runner_workspace_cwds() {
    local kind="$1" selector resolved base uncertain CWD="$CWD"
    local bases=("$CWD" ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"})
    shift
    runner_scope
    for base in "${bases[@]}"; do
        [[ "$base" != /proc/self/cwd ]] || return 1
        CWD="$base"; uncertain=0
        for selector in "$@"; do
            case "$selector" in *'$'* | *'`'* | *'*'* | *'?'* | *'['* | *"$ACTIVE"*) uncertain=1; continue ;; esac
            resolved="$(path "$selector")"
            if [[ "$kind" == pnpm ]]; then
                case "$selector" in ./* | ../* | /*) ;; *) uncertain=1; continue ;; esac
            elif [[ ! -f "$resolved/package.json" ]]; then uncertain=1; continue; fi
            if [[ -d "$resolved" ]]; then remember_cwd "$resolved" || return 1
            else uncertain=1; fi
        done
        if ((uncertain)); then runner_project_cwds || return 1; fi
    done
}

runner_recursive_cwds() {
    local CWD="$CWD" base roots='' root
    local bases=("$CWD" ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"})
    runner_scope
    for base in "${bases[@]}"; do
        CWD="$base"
        root="$(runner_project_root)" || return 1
        case "$roots" in *"$US$root$US"*) continue ;; esac
        roots+="$US$root$US"
        runner_project_cwds || return 1
    done
}

runner_prefix_cwd() {
    runner_scope
    local prefix="$1"
    case "$prefix" in *'$'* | *'`'* | *"$ACTIVE"*) return 1 ;; esac
    remember_cwd "$(path "$prefix")"
}

# unwrap: normalise executable names and utility wrappers in W. Sets XARGS
# for reader pipelines and propagates unknown option arity as analysis failure.
unwrap() {
    local base
    while ((${#W[@]})); do
        base="${W[0]##*/}"
        case "$base" in
            if | then | elif | else | fi | while | until | do | done | for | in | case | 'esac' | '{' | '}' | '(' | ')' | '!')
                W=("${W[@]:1}")
                ;;
            npx | bunx | uvx | pnpm | yarn | bun | npm | pipx | uv | poetry)
                local offset=1 package='' action='' shell_mode=0 code='' workspaces=() recursive=0 workspace_root=0
                case "$base" in
                    npx | bunx)
                        while [[ "${W[offset]:-}" == -* ]]; do
                            case "${W[offset]}" in
                                -c | --call | -c?* | --call=*) break ;;
                                -p | --package) ((offset + 1 < ${#W[@]})) || return 1; offset=$((offset + 2)) ;;
                                --) offset=$((offset + 1)); break ;;
                                *) offset=$((offset + 1)) ;;
                            esac
                        done ;;
                    uvx)
                        case "${W[offset]:-}" in --from) offset=$((offset + 2)) ;; --from=*) offset=$((offset + 1)) ;; esac ;;
                    npm)
                        local prefixes=() child=() npm_options=1
                        while ((offset < ${#W[@]})); do
                            case "${W[offset]}" in
                                --prefix | -w | --workspace | --loglevel)
                                    ((offset + 1 < ${#W[@]})) || return 1
                                    case "${W[offset]}" in
                                        --prefix) prefixes+=("${W[offset+1]}") ;;
                                        -w | --workspace) workspaces+=("${W[offset+1]}") ;;
                                    esac
                                    offset=$((offset + 2)) ;;
                                --prefix=*) prefixes+=("${W[offset]#*=}"); offset=$((offset + 1)) ;;
                                --workspace=*) workspaces+=("${W[offset]#*=}"); offset=$((offset + 1)) ;;
                                -ws | --workspaces | --workspaces=true) recursive=1; offset=$((offset + 1)) ;;
                                -s | --silent | --if-present | --loglevel=* | -y | --yes | --yes=* | -q | --quiet | -g | --global) offset=$((offset + 1)) ;;
                                -w?*) workspaces+=("${W[offset]:2}"); offset=$((offset + 1)) ;;
                                *) break ;;
                            esac
                        done
                        action="${W[offset]:-}"
                        case "$action" in
                            exec | x | run | run-script | rum | urn) offset=$((offset + 1)) ;;
                            *) W=(npm "${W[@]:offset}"); break ;;
                        esac
                        while ((offset < ${#W[@]})); do
                            if ((npm_options)); then
                                case "${W[offset]}" in
                                    --) npm_options=0; offset=$((offset + 1)); continue ;;
                                    -ws | --workspaces | --workspaces=true) recursive=1; offset=$((offset + 1)); continue ;;
                                    -s | --silent | --if-present | --loglevel=* | -y | --yes | --yes=* | -q | --quiet | -g | --global | --package=* | -p?*) offset=$((offset + 1)); continue ;;
                                    --prefix | -w | --workspace | --loglevel | -p | --package)
                                        ((offset + 1 < ${#W[@]})) || return 1
                                        case "${W[offset]}" in
                                            --prefix) prefixes+=("${W[offset+1]}") ;;
                                            -w | --workspace) workspaces+=("${W[offset+1]}") ;;
                                        esac
                                        offset=$((offset + 2)); continue ;;
                                    --prefix=*) prefixes+=("${W[offset]#*=}"); offset=$((offset + 1)); continue ;;
                                    --workspace=*) workspaces+=("${W[offset]#*=}"); offset=$((offset + 1)); continue ;;
                                    -w?*) workspaces+=("${W[offset]:2}"); offset=$((offset + 1)); continue ;;
                                    -c | --call)
                                        ((offset + 1 < ${#W[@]})) || return 1
                                        code="${W[offset+1]}"; offset=$((offset + 2)); continue ;;
                                    -c?*) code="${W[offset]:2}"; offset=$((offset + 1)); continue ;;
                                    --call=*) code="${W[offset]#*=}"; offset=$((offset + 1)); continue ;;
                                esac
                            fi
                            child+=("${W[offset]}"); offset=$((offset + 1))
                            case "$action" in run | run-script | rum | urn)
                                # Flags after the script name are script data.
                                child+=("${W[@]:offset}"); break ;;
                            esac
                        done
                        case "$action" in
                            run | run-script | rum | urn)
                                if [[ "${child[0]:-}" == env ]]; then
                                    W=(npm run ${child[@]+"${child[@]}"}); break
                                fi
                                NPM_SCRIPT_CHILD=1 ;;
                            exec | x)
                                for package in ${prefixes[@]+"${prefixes[@]}"}; do runner_prefix_cwd "$package" || { REASON='package execution scope cannot be certified'; return 1; }; done
                                if ((${#workspaces[@]})); then runner_workspace_cwds npm "${workspaces[@]}" || { REASON='package execution scope cannot be certified'; return 1; }; fi
                                if ((recursive)); then runner_recursive_cwds || { REASON='package execution scope cannot be certified'; return 1; }; fi ;;
                        esac
                        if [[ -n "$code" ]]; then W=(sh -c "$code"); continue; fi
                        W=(${child[@]+"${child[@]}"}); continue ;;
                    pipx)
                        [[ "${W[1]:-}" == run ]] || break
                        offset=2
                        case "${W[offset]:-}" in --spec) offset=$((offset + 2)) ;; --spec=*) offset=$((offset + 1)) ;; esac ;;
                    uv | poetry)
                        [[ "${W[1]:-}" == run ]] || break
                        offset=2 ;;
                    pnpm | yarn | bun)
                        while ((offset < ${#W[@]})); do
                            case "${W[offset]}" in
                                -C | --dir)
                                    ((offset + 1 < ${#W[@]})) || return 1
                                    CWD="$(path "${W[offset+1]}")"
                                    offset=$((offset + 2)) ;;
                                -C?* | --dir=*)
                                    if [[ "${W[offset]}" == -C* ]]; then package="${W[offset]:2}"; else package="${W[offset]#*=}"; fi
                                    CWD="$(path "$package")"
                                    offset=$((offset + 1)) ;;
                                --filter | -F)
                                    ((offset + 1 < ${#W[@]})) || return 1
                                    workspaces+=("${W[offset+1]}")
                                    offset=$((offset + 2)) ;;
                                --filter=*) workspaces+=("${W[offset]#*=}"); offset=$((offset + 1)) ;;
                                -F?*) workspaces+=("${W[offset]:2}"); offset=$((offset + 1)) ;;
                                -c | --shell-mode)
                                    [[ "$base" == pnpm ]] || break
                                    shell_mode=1; offset=$((offset + 1)) ;;
                                -r | --recursive | --recursive=*) recursive=1; offset=$((offset + 1)) ;;
                                -w | --workspace-root | --workspace-root=*) workspace_root=1; offset=$((offset + 1)) ;;
                                -s | --silent) offset=$((offset + 1)) ;;
                                *) break ;;
                            esac
                        done
                        action="${W[offset]:-}"
                        # Package-manager configuration is data, not a local binary.
                        [[ "$action" != config ]] || break
                        case "$action" in dlx | exec | run) offset=$((offset + 1)) ;; esac
                        if [[ "$action" == dlx ]]; then
                            while ((offset < ${#W[@]})); do
                                case "${W[offset]}" in
                                    -s | --silent | -q | --quiet | --package=*) offset=$((offset + 1)) ;;
                                    -p | --package) ((offset + 1 < ${#W[@]})) || return 1; offset=$((offset + 2)) ;;
                                    *) break ;;
                                esac
                            done
                        fi
                        if [[ "$base:$action" == pnpm:exec ]]; then
                            while [[ "${W[offset]:-}" == -c || "${W[offset]:-}" == --shell-mode ]]; do
                                shell_mode=1; offset=$((offset + 1))
                            done
                        fi
                        [[ "${W[offset]:-}" != -- ]] || offset=$((offset + 1))
                        # pnpm unknown commands fall back to exec. Defer cwd
                        # enumeration for operand-free fallbacks (build/test):
                        # they have no cwd-sensitive reader inputs to certify.
                        # Explicit exec and fallbacks with child operands retain
                        # the bounded workspace proof before reader analysis.
                        if [[ "$base" == pnpm && "$action" != dlx && "$action" != run ]] &&
                            ((offset + 1 < ${#W[@]})) || [[ "$action" == exec ]]; then
                            if ((workspace_root)); then
                                runner_scope
                                package="$(runner_project_root)" || { REASON='package execution scope cannot be certified'; return 1; }
                                remember_cwd "$package" || { REASON='package execution scope cannot be certified'; return 1; }
                            fi
                            if ((${#workspaces[@]})); then runner_workspace_cwds "$base" "${workspaces[@]}" || { REASON='package execution scope cannot be certified'; return 1; }; fi
                            if ((recursive)); then runner_recursive_cwds || { REASON='package execution scope cannot be certified'; return 1; }; fi
                        fi
                        if [[ "$base:$action" == yarn:exec || "$base:$action:$shell_mode" == pnpm:exec:1 ]]; then
                            ((offset < ${#W[@]})) || return 1
                            printf -v code '%s ' "${W[@]:offset}"
                            W=(sh -c "$code"); continue
                        fi ;;
                esac
                # Call options are shell source, not a package command word.
                case "${W[offset]:-}" in
                    -c | --call)
                        ((offset + 1 < ${#W[@]})) || return 1
                        W=(sh -c "${W[offset+1]}"); continue ;;
                    -c?*) W=(sh -c "${W[offset]:2}"); continue ;;
                    --call=*) W=(sh -c "${W[offset]#*=}"); continue ;;
                esac
                package="${W[offset]:-}"
                case "$package" in
                    env | printenv | dotenv | dotenv-cli | dotenvx | dotenvx@* | @dotenvx/dotenvx | @dotenvx/dotenvx@*)
                        W=("${W[@]:offset}")
                        case "${W[0]}" in dotenv-cli) W[0]=dotenv ;; dotenvx@* | @dotenvx/dotenvx*) W[0]=dotenvx ;; esac ;;
                    *)
                        case "$package" in '' | -*) break ;; esac
                        if [[ "$base" == npx || "$base" == bunx || "$base" == uvx ||
                            "$base" == npm || "$base" == pipx || "$base" == uv || "$base" == poetry ||
                            "$base" == yarn || "$base" == pnpm ]]; then
                            W=("${W[@]:offset}"); continue
                        fi
                        # Explicit local-binary runner actions own a command
                        # slot, unlike test selectors or configuration operands.
                        if [[ "$base" == pnpm || "$base" == yarn || "$base" == bun ]]; then
                            case "$action" in dlx | exec | run)
                                W=("${W[@]:offset}"); continue ;;
                            esac
                        fi
                        break ;;
                esac ;;
            direnv)
                if [[ "${W[1]:-}" == exec ]]; then
                    ((${#W[@]} >= 4)) || return 1
                    CWD="$(path "${W[2]}")"; W=("${W[@]:3}")
                else break; fi ;;
            python | python[0-9]*)
                if [[ "${W[1]:-}" == -m && ( "${W[2]:-}" == dotenv || "${W[2]:-}" == keyring ) ]]; then
                    W=("${W[@]:2}")
                else break; fi ;;
            time)
                W=("${W[@]:1}")
                [[ "${W[0]:-}" != -p ]] || W=("${W[@]:1}")
                ;;
            busybox | toybox)
                W=("${W[@]:1}")
                ((${#W[@]})) || return 1
                ;;
            sudo)
                SEARCH_CONFIG_TRUST=0
                W=("${W[@]:1}")
                wrapper_options sudo || return 1
                ;;
            builtin)
                W=("${W[@]:1}")
                if [[ "${W[0]:-}" == -- ]]; then W=("${W[@]:1}")
                elif [[ "${W[0]:-}" == -* ]]; then return 1; fi
                ;;
            command)
                W=("${W[@]:1}")
                while ((${#W[@]})) && [[ "${W[0]}" == -* ]]; do
                    case "${W[0]}" in -u | -g | -h) W=("${W[@]:1}") ;; esac
                    W=("${W[@]:1}")
                done
                ;;
            timeout | gtimeout)
                W=("${W[@]:1}")
                wrapper_options "$base" || return 1
                [[ -z "$REASON" ]] || return 0
                # DURATION is an operand belonging to timeout, not its child.
                ((${#W[@]} >= 2)) || return 1
                W=("${W[@]:1}")
                ;;
            parallel)
                XARGS=1
                W=("${W[@]:1}")
                while [[ "${W[0]:-}" == -* ]]; do
                    case "${W[0]}" in --) W=("${W[@]:1}"); break ;; -j | --jobs | -P)
                        ((${#W[@]} >= 3)) || return 1
                        W=("${W[@]:2}") ;; *) return 1 ;; esac
                done
                ;;
            setsid)
                W=("${W[@]:1}")
                while [[ "${W[0]:-}" == -* ]]; do
                    case "${W[0]}" in -w | --wait | -c | --ctty | -f | --fork) W=("${W[@]:1}") ;; --) W=("${W[@]:1}"); break ;; *) return 1 ;; esac
                done ;;
            script)
                W=("${W[@]:1}")
                [[ "${W[0]:-}" != -q ]] || { REASON='script default shell cannot be certified'; return 0; }
                if [[ "${W[0]:-}" == -qc || "${W[0]:-}" == -cq ]]; then
                    ((${#W[@]} >= 2)) || return 1
                    W=(sh -c "${W[1]}")
                elif [[ "${W[0]:-}" == -c ]]; then
                    ((${#W[@]} >= 2)) || return 1
                    W=(sh -c "${W[1]}")
                else return 1; fi ;;
            unshare)
                W=("${W[@]:1}")
                while [[ "${W[0]:-}" == -* ]]; do
                    [[ "${W[0]}" != -- ]] || { W=("${W[@]:1}"); break; }
                    W=("${W[@]:1}")
                done ;;
            nice | nohup | exec | stdbuf | caffeinate | xargs)
                [[ "$base" != exec ]] || SEARCH_CONFIG_TRUST=0
                [[ "$base" != xargs ]] || XARGS=1
                W=("${W[@]:1}")
                wrapper_options "$base" || return 1
                [[ -z "$REASON" ]] || return 0
                ;;
            env)
                SEARCH_CONFIG_TRUST=0
                if ((${#W[@]} == 1)); then break; fi
                W=("${W[@]:1}")
                wrapper_options env || return 1
                while ((${#W[@]})) && [[ "${W[0]}" == *=* ]]; do W=("${W[@]:1}"); done
                if ((${#W[@]} == 0)); then
                    W=(env)
                    break
                fi
                ;;
            *)
                if [[ "${W[0]}" == *=* ]]; then W=("${W[@]:1}"); else break; fi
                ;;
        esac
    done
}

# rg_config_protects: read the small hook-environment config once per command.
# Certify only negative globs and --hidden, with every example exclusion present.
# 0 certified, 1 absent/partial safe flags, 2 unknown input or scope-changing flags.
# Unknown config flags can redirect input even when the apparent tree is clean.
rg_config_protects() {
    local config="" line required seen=$'\n' file="${RIPGREP_CONFIG_PATH:-}"
    [[ -n "$file" ]] || return 1
    # rg treats this environment value literally, without shell home expansion.
    [[ "$file" == /* ]] || file="$CWD/$file"
    [[ -f "$file" && -r "$file" ]] || return 2
    # Never open a protected target through a config alias.
    file_secret "$file" && return 2
    # Validate bytes before entering Bash, which cannot retain NUL. A bounded
    # regular-file read must reach EOF, not an I/O error or a truncated prefix.
    config="$(perl - "$file" <<'PERL'
use strict; use warnings; use Time::HiRes qw(alarm);
local $SIG{ALRM} = sub { exit 2 }; alarm 0.2;
open my $f, '<', $ARGV[0] or exit 2;
-f $f or exit 2;
my $config = '';
while (1) {
    my $n = read $f, my $part, 8193 - length($config);
    defined $n or exit 2;
    last unless $n;
    $config .= $part;
    exit 2 if length($config) > 8192;
}
close $f or exit 2;
exit 2 if $config =~ /[\x00-\x08\x0b\x0c\x0e-\x1f\x7f]/;
print $config;
PERL
)" || return 2
    while IFS= read -r line; do
        case "$line" in
            '' | '#'*) ;;
            --hidden) SCAN_PRUNED=0 ;;
            --iglob='!'* | --glob='!'*) seen+="$line"$'\n' ;;
            # Display and matching flags cannot add inputs; they keep scan fallback.
            --smart-case | --ignore-case | --case-sensitive | --max-columns=* | --max-columns-preview | --column | --no-column | --line-number | --no-line-number | --heading | --no-heading | --trim | --no-messages | --color=* | --colors=* | --sort=* | --sortr=* | --max-filesize=* | --threads=*) ;;
            *) return 2 ;;
        esac
    done <<<"$config"
    for required in '.env' '.envrc' '.env.*' '*.env' '*.secret' '.secrets/' '.netrc' '.git-credentials' '.npmrc' '.pypirc' '**/.aws/credentials' '**/.docker/config.json' '**/gh/hosts.yml' '**/.ssh/id_*' '**/.kube/config' 'application_default_credentials.json' '**/gcloud/credentials.db' '**/gcloud/access_tokens.db' '**/gcloud/legacy_credentials/' '.vault-token' '**/.terraform.d/credentials.tfrc.json' '**/.cargo/credentials.toml' '**/.cargo/credentials' '.pgpass' '.yarnrc.yml'; do
        [[ "$seen" == *$'\n'"--iglob=!$required"$'\n'* ]] || return 1
    done
    return 0
}

# Pattern inputs are read even in names-only mode. Resolve aliases before
# accepting the operand; '-' remains the caller's standard input.
search_pattern_protected() {
    local scan=0
    [[ "$1" != - ]] || return 1
    reader_operand "$1" && return 0
    SCAN_ROOTS_ONLY=1 tree_has_secret "$(path "$1")" || scan=$?
    ((scan != 1))
}

# search_scope: parse rg/git grep roles without executing shell text. Unknown
# option arity or dynamic/glob paths cannot prove a narrow scope. Names-only
# requests skip tree scans; counts over trees remain content-like, while rg
# counts on explicit files are safe. Git's worktree is a tracked superset.
search_scope() {
    local kind="$1" CWD="$CWD" start=1 j t pattern=1 options=1 names=0 count=0 pager=0 uncertain=0 unknown=0 scan=0
    local config_status=1 config_globs=1 negative_glob=0 SCAN_PRUNED=1 SCAN_GIT_IGNORE=0 SCAN_RG_IGNORE=0 rg_ts=0 paths=() args=() narrow_globs=() no_index=0 untracked=0
    SEARCH_NAMES_ONLY=0
    case "$kind" in ack | ack-grep) SCAN_PRUNED=0 ;; esac
    if [[ "$kind" == git ]]; then
        # Resolve common global options, including repeated -C prefixes.
        while ((start < ${#W[@]})); do
            t="${W[start]}"
            case "$t" in
                -C)
                    start=$((start + 1))
                    CWD="$(path "${W[start]:-}")"
                    ;;
                -c | --git-dir | --work-tree) uncertain=1; start=$((start + 1)) ;;
                --git-dir=* | --work-tree=* | --config-env=*) uncertain=1 ;;
                --no-pager | --paginate | --no-optional-locks) ;;
                -*) uncertain=1 ;;
                grep) break ;;
                *) return 0 ;;
            esac
            start=$((start + 1))
        done
        [[ "${W[start]:-}" == grep ]] || return 0
        start=$((start + 1))
    fi
    args=("${W[@]:start}")
    for ((j = 0; j < ${#args[@]}; j++)); do
        t="${args[j]}"
        if ((options)); then
            case "$t" in
                --) options=0; continue ;;
                -l | --files-with-matches | --files-without-match) names=1; continue ;;
                --files) [[ "$kind" != rg ]] || names=1; continue ;;
                -O | -O?* | --open=* | --open-files=* | --open-files-in-*=* | --open-files-in-pager)
                    [[ "$kind" != git ]] || pager=1
                    continue ;;
                -c | --count | --count-matches)
                    if [[ "$kind" == grep ]]; then names=1; else count=1; fi
                    continue ;;
                --json) pager=1; continue ;;
                -q | --quiet | --silent)
                    names=1
                    continue ;;
                --no-index) no_index=1; continue ;;
                --untracked) untracked=1; continue ;;
                --no-exclude-standard | --cached) uncertain=1; continue ;;
                --hidden) SCAN_PRUNED=0; config_globs=0; continue ;;
                -g | --glob | --iglob)
                    j=$((j + 1))
                    if selector_negative "${args[j]:-}"; then
                        negative_glob=1
                        # Mixed brace alternatives may override config exclusions.
                        selector_negative "${args[j]:-}" 1 || config_globs=0
                    else
                        config_globs=0
                        narrow_globs+=("${args[j]:-}")
                    fi
                    SCAN_PRUNED=0
                    continue ;;
                --glob=* | --iglob=* | -g?*)
                    t="${t#*=}"
                    [[ "${args[j]}" != -g* ]] || t="${args[j]:2}"
                    if selector_negative "$t"; then
                        negative_glob=1
                        selector_negative "$t" 1 || config_globs=0
                    else config_globs=0; narrow_globs+=("$t"); fi
                    SCAN_PRUNED=0
                    continue ;;
                -e | --regexp | -f | --file)
                    pattern=0
                    j=$((j + 1))
                    if [[ "$t" == -f || "$t" == --file ]]; then
                        if search_pattern_protected "${args[j]:-}"; then
                            REASON='pattern file targets a protected store'
                            return 0
                        fi
                    fi
                    continue
                    ;;
                -e?* | --regexp=*) pattern=0; continue ;;
                -f?* | --file=*)
                    pattern=0
                    t="${t#*=}"
                    [[ "${args[j]}" != -f* ]] || t="${args[j]:2}"
                    if search_pattern_protected "$t"; then REASON='pattern file targets a protected store'; return 0; fi
                    continue
                    ;;
                --include)
                    j=$((j + 1))
                    narrow_globs+=("${args[j]:-}")
                    continue ;;
                --include=*)
                    narrow_globs+=("${t#*=}")
                    continue ;;
                --exclude | --exclude-dir) j=$((j + 1)); continue ;;
                --exclude=* | --exclude-dir=*) continue ;;
                -t | --type)
                    j=$((j + 1))
                    [[ "$kind" != rg || "${args[j]:-}" != ts ]] || rg_ts=1
                    continue ;;
                -tts | --type=ts)
                    [[ "$kind" != rg ]] || rg_ts=1
                    continue ;;
                -T | --type-not | --type-add | -A | -B | -C | -m | --max-count | --context | --after-context | --before-context | --encoding | --color | --colors | --max-depth | --threads | -j)
                    j=$((j + 1)); continue ;;
                --type=* | --type-not=* | --type-add=* | --color=* | --colors=* | --encoding=* | --max-count=* | --max-depth=* | --threads=* | --context=* | --after-context=* | --before-context=*) continue ;;
                -r | -R | -[rR][niIlLcCq]* | -[niIlLcCq]*[rR] | --recursive | --dereference-recursive)
                    [[ "$kind" == grep ]] || uncertain=1
                    if [[ "$kind" == grep && "$t" != --* ]]; then
                        case "$t" in *l* | *L* | *c* | *q*) names=1 ;; esac
                    fi
                    continue ;;
                --line-number | --no-line-number | --ignore-case | --case-sensitive | --smart-case | --fixed-strings | --word-regexp | --line-regexp | --heading | --no-heading | --with-filename | --no-filename | --text | --null | --null-data | --only-matching | --invert-match | --pcre2 | --multiline | --multiline-dotall | --stats) continue ;;
                -*)
                    # Known switch-only clusters have no operand to consume.
                    if [[ "$t" =~ ^-[niIsSEFGFwxoHvqahNUPlLc0]+$ ]]; then
                        case "$t" in *l* | *q*) names=1 ;; esac
                        if [[ "$t" == *L* ]]; then
                            if [[ "$kind" == grep ]]; then names=1; else uncertain=1; unknown=1; fi
                        fi
                        if [[ "$t" == *c* ]]; then
                            if [[ "$kind" == grep ]]; then names=1; else count=1; fi
                        fi
                    else uncertain=1; unknown=1; fi
                    continue
                    ;;
            esac
        fi
        if ((pattern)); then pattern=0; continue; fi
        # Only a literal HEAD revision is classified before --; all other
        # revisions retain the conservative unknown-arity boundary.
        if [[ "$kind" == git && "$options" != 0 && "$t" != HEAD && $no_index == 0 && $untracked == 0 ]]; then uncertain=1; unknown=1; fi
        [[ "$kind" != git || "$t" != HEAD ]] || continue
        case "$t" in *'$'* | *'`'* | *'*'* | *'?'* | *'['*) uncertain=1 ;; esac
        paths+=("$(path "$t")")
        if [[ "$t" != /* ]]; then
            local alternate_cwd
            for alternate_cwd in ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}; do paths+=("$alternate_cwd/$t"); done
        fi
    done
    if ((names && !count && !pager)); then
        if [[ "$kind" != git ]] || (( !unknown && !pager )); then
            SEARCH_NAMES_ONLY=1
            if [[ "$kind" == git ]] && ((no_index)); then SEARCH_GIT_SCOPE_SAFE=1; fi
            return 0
        fi
    fi
    # Certification never overrides unknown options, revisions, or dynamic paths.
    if ((uncertain)); then
        # Unknown switches can redirect the search outside its apparent paths.
        REASON='search scope is uncertain; narrow the path or use -l; install examples/ripgreprc for rg'
        return 0
    fi
    if [[ "$kind" == rg ]] && ((count && !pager && ${#paths[@]})); then
        local only_files=1
        for t in "${paths[@]}"; do [[ -f "$t" || ! -e "$t" ]] || only_files=0; done
        if ((only_files)); then SEARCH_NAMES_ONLY=1; return 0; fi
    fi
    # Positive globs form a union; all must exclude protected basenames before
    # a filter can narrow the metadata scan. Negative globs never narrow it.
    local SCAN_NAME_GLOBS='' glob all_narrow=1
    if ((negative_glob == 0 && ${#narrow_globs[@]})); then
        for glob in "${narrow_globs[@]}"; do
            if protected_selector "$glob"; then all_narrow=0; break; fi
            SCAN_NAME_GLOBS+="$glob"$'\n'
        done
        ((all_narrow)) || SCAN_NAME_GLOBS=''
    fi
    # Explicit operands bypass rg ignore globs, including symlink aliases.
    # The implicit cwd also needs checking when searching from inside a store.
    if ((${#paths[@]} == 0)); then
        paths=("$CWD")
        paths+=(${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"})
    fi
    for t in "${paths[@]}"; do
        if is_secret "$t" || [[ "$t" == "$HOME/.aws" ]]; then
            REASON='explicit search input is protected'
            return 0
        fi
        # A missing operand cannot disclose contents with a certified config.
        # Without certification the complete scan below still rejects it.
        if [[ -e "$t" || -L "$t" ]]; then
            scan=0
            SCAN_ROOTS_ONLY=1 SCAN_RG_DEFAULT=0 tree_has_secret "$t" || scan=$?
            if ((scan != 1)); then
                REASON='explicit search input is protected or cannot be resolved safely'
                return 0
            fi
        fi
    done
    if [[ "$kind" == rg ]]; then
        # Inline env changes cannot inherit certification from the hook env.
        case "$CMD" in *RIPGREP_CONFIG_PATH*) config_status=2 ;;
            *)
                if ((SEARCH_CONFIG_TRUST)); then
                    config_status=0
                    rg_config_protects || config_status=$?
                else
                    config_status=2
                fi
                ;;
        esac
        if ((config_status == 2)); then
            REASON='rg config cannot establish safe search inputs'
            return 0
        fi
        # Fixed globs cannot certify arbitrary literal KUBECONFIG paths.
        if [[ -n "${KUBECONFIG:-}" ]]; then config_globs=0; SCAN_PRUNED=0; fi
        ((config_status != 0 || config_globs == 0)) || return 0
    fi
    # Git reads tracked blobs, not untracked worktree files. git_policy below
    # certifies the index and any explicit protected paths.
    if [[ "$kind" == git && $no_index == 0 && $untracked == 0 ]]; then return 0; fi
    scan=0
    if [[ "$kind" == rg ]]; then
        SCAN_RG_IGNORE=1
        if ((rg_ts)); then SCAN_INCLUDE_TS=1; fi
        # Known harmless partial configs preserve rg's ordinary ignore rules.
        # --hidden changes hidden traversal, not Git ignore handling; positive
        # command-line globs, however, can re-include ignored files.
        if ((SCAN_PRUNED)); then SCAN_RG_DEFAULT=1; fi
        if ((${#narrow_globs[@]} == 0)); then SCAN_GIT_IGNORE=1; fi
    fi
    if [[ "$kind" == git ]]; then
        SCAN_GIT_IGNORE="$untracked" tree_has_secret "${paths[@]}" || scan=$?
        # --untracked still searches tracked blobs, even when an ignored
        # working-tree name was excluded above. Only --no-index bypasses it.
        if ((scan == 1 && no_index)); then SEARCH_GIT_SCOPE_SAFE=1; fi
    else
        tree_has_secret "${paths[@]}" || scan=$?
    fi
    if ((scan != 1)); then
        REASON='search content/count scope contains protected names or is incomplete; narrow the path or use -l; install examples/ripgreprc for rg'
    fi
    return 0
}

# analyse_child_words: requote tokenized arguments without evaluating them.
analyse_child_words() {
    local code="" arg quote="'" replacement="'\\''"
    for arg in "$@"; do
        # shellcheck disable=SC2295  # fixed quote byte, Bash 3.2-safe replacement
        code+=" '${arg//$quote/$replacement}'"
    done
    analyse "$code" "$((depth + 1))" "$in_run"
}

# analyse_child START: inspect a wrapped command after its known prefix.
analyse_child() {
    analyse_child_words "${W[@]:$1}"
}

# find_operands: inspect predicate witnesses and commands launched for matches.
# A broad -exec without a protected witness stays allowed: selected file names
# cannot be proven from static shell text by this accident guard.
find_operands() {
    local j k t start end witness=0 scope=0 reading=0 scan=0 child=() roots=() find_words=()
    # Find predicates are order-independent with respect to the selected
    # entries; collect witnesses even when a predicate follows its -exec.
    for ((j = 1; j < ${#W[@]}; j++)); do
        case "${W[j]}" in
            -name | -iname | -path | -ipath | -regex | -iregex | -wholename | -iwholename)
                j=$((j + 1)); ((j < ${#W[@]})) || return 1
                if protected_selector "${W[j]}" || raw_mentions_protected "${W[j]}" 3; then witness=1; fi
                ;;
        esac
    done
    for ((j = 1; j < ${#W[@]}; j++)); do
        t="${W[j]}"
        case "$t" in
            -exec | -execdir | -ok | -okdir) reading=1; break ;;
        esac
    done
    if ((reading)); then
        for ((j = 1; j < ${#W[@]}; j++)); do
            case "${W[j]}" in -*) break ;; *) roots+=("$(path "${W[j]}")") ;; esac
        done
        ((${#roots[@]})) || roots=("$CWD")
        SCAN_FOLLOW=1 tree_has_secret "${roots[@]}" || scan=$?
        ((scan == 1)) || scope=1
    fi
    find_words=("${W[@]}")
    for ((j = 1; j < ${#find_words[@]}; j++)); do
        t="${find_words[j]}"
        case "$t" in
            -files0-from | -files0-from=*)
                if [[ "$t" == -files0-from ]]; then
                    j=$((j + 1)); ((j < ${#W[@]})) || return 1
                    t="${W[j]}"
                else t="${t#*=}"; fi
                if reader_operand "$t"; then REASON='find reads a protected name list'; return 0; fi
                ;;
            -name | -iname | -path | -ipath | -regex | -iregex | -wholename | -iwholename)
                j=$((j + 1)); ((j < ${#W[@]})) || return 1
                if protected_selector "${W[j]}" || raw_mentions_protected "${W[j]}" 3; then witness=1; fi
                ;;
            -exec | -execdir | -ok | -okdir)
                start=$((j + 1)); end=0
                for ((k = start; k < ${#W[@]}; k++)); do
                    if [[ "${W[k]}" == ';' || "${W[k]}" == + ]]; then end="$k"; break; fi
                done
                ((end > start)) || return 1
                child=("${W[@]:start:end-start}")
                j="$end"
                for t in "${child[@]}"; do
                    if reader_operand "$t" || protected_selector "$t"; then witness=1; fi
                done
                if ((witness || scope)); then
                    for ((k = 0; k < ${#child[@]}; k++)); do
                        # Model a selected protected name at the child boundary.
                        # Metadata commands such as echo remain exempt, while
                        # wrappers and nested shell readers get full analysis.
                        [[ "${child[k]}" != '{}' ]] || child[k]='.env'
                    done
                fi
                local child_base="${child[0]##*/}" child_words=()
                child_words=("${child[@]}")
                W=("${child_words[@]}")
                unwrap || return 1
                [[ -z "$REASON" ]] || return 0
                child_base="${W[0]##*/}"
                W=("${child_words[@]}")
                if ((scope)) && [[ " ls stat chmod chown rm rmdir touch mkdir test true false basename dirname realpath readlink file " != *" $child_base "* ]]; then
                    REASON='find execution reads a protected search scope'; return 0
                fi
                analyse_child_words "${child[@]}" || return 1
                [[ -z "$REASON" ]] || return 0
                W=("${find_words[@]}")
                ;;
        esac
    done
    return 0
}

# listing_filter_safe: certify a positive filename filter and its selected
# metadata scope. A public basename inside .secrets is still protected. Inverted
# or disjunctive find selections cannot establish this proof. No contents read.
listing_filter_safe() {
    local kind="$1" t filter='' scan=0 leading=1 roots=()
    if [[ "$kind" == fd || "$kind" == fdfind ]]; then shift; fd_filter_safe "$@"; return; fi
    local SCAN_NAME_GLOBS='' SCAN_PRUNED=0 SCAN_FOLLOW=1
    shift
    while (($#)); do
        t="$1"; shift
        if [[ "$kind" == find ]] && ((leading)); then
            case "$t" in
                -H | -L | -P) continue ;;
                -* | '(' | '!') leading=0 ;;
                *) roots+=("$(path "$t")"); continue ;;
            esac
        fi
        case "$kind:$t" in
            find:-not | find:'!' | find:-o | find:-or | find:-exec* | find:-ok*) return 1 ;;
            find:-a | find:-and | find:'(' | find:')' | find:-print | find:-print0 | find:-depth | find:-mount | find:-xdev) ;;
            find:-type | find:-maxdepth | find:-mindepth)
                (($#)) || return 1
                shift ;;
            find:-name | find:-iname)
                (($#)) || return 1
                filter="$1"; shift
                protected_selector "$filter" && return 1
                SCAN_NAME_GLOBS+="$filter"$'\n' ;;
            find:*) return 1 ;;
        esac
    done
    ((${#roots[@]})) || roots=("$CWD")
    tree_has_secret "${roots[@]}" || scan=$?
    ((scan == 1))
}

# listing_producer_safe ARGV: certify every listing root, never the consumer
# cwd. Unknown option arities or roots cannot establish a metadata-only proof.
listing_producer_safe() {
    local kind t scan=0 roots=() options=1
    local CWD="$CWD" SCAN_PRUNED=0 SCAN_FOLLOW=1 W=("$@") XARGS=0
    local producer_cwds=(${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}) UNCERTAIN_CWDS=() alternate
    local WORKSPACE_SCOPE_ACTIVE=0 WORKSPACE_ORIGINAL_CWDS=() NPM_SCRIPT_CHILD=0
    for alternate in ${producer_cwds[@]+"${producer_cwds[@]}"}; do
        CWD="$alternate" listing_producer_safe "$@" || return 1
    done
    # Model the producer's wrappers too (for example command find or env -C).
    unwrap || return 1
    [[ -z "$REASON" && ${#W[@]} -gt 0 ]] || return 1
    kind="${W[0]##*/}"
    set -- "${W[@]:1}"
    case "$kind" in
        find | fd | fdfind) listing_filter_safe "$kind" "$@"; return ;;
        bash | sh | zsh | ksh | dash) return 1 ;;
        ls)
            while (($#)); do
                t="$1"; shift
                if ((options)); then
                    case "$t" in
                        --) options=0; continue ;;
                        --color=* | --quoting-style=* | --time-style=* | --group-directories-first) continue ;;
                        -[aAbBcCdDfFgGhHiIklLmMnNopqQrRsStTuUvwxX1]*)
                            [[ "$t" =~ ^-[aAbBcCdDfFgGhHiklLmMnNopqQrRsStTuUvwxX1]+$ ]] || return 1
                            continue ;;
                        -*) return 1 ;;
                    esac
                fi
                roots+=("$(path "$t")")
            done ;;
        git)
            [[ -z "${GIT_COMMAND_REPO_OVERRIDE:-}" ]] || return 1
            while (($#)); do
                t="$1"; shift
                case "$t" in
                    -C) (($#)) || return 1; CWD="$(path "$1")"; shift ;;
                    -C?*) CWD="$(path "${t:2}")" ;;
                    --no-pager | --no-optional-locks) ;;
                    ls-files) break ;;
                    *) return 1 ;;
                esac
            done
            [[ "$t" == ls-files ]] || return 1
            # Ordinary pathspecs only narrow this scope. Top-magic, absolute
            # and parent components can escape the apparent producer root.
            for t in "$@"; do
                case "$t" in /* | :/* | :\(*) return 1 ;; esac
                case "/$t/" in */../*) return 1 ;; esac
            done
            roots=("$CWD") ;;
        rg)
            # --files has no pattern operand. Other scope-changing options are
            # deliberately not guessed; the full root scan ignores exclusions.
            [[ " $* " == *' --files '* ]] || return 1
            while (($#)); do
                t="$1"; shift
                case "$t" in
                    --) roots+=("$@"); break ;;
                    -g | --glob | --iglob | -t | --type | -T | --type-not)
                        (($#)) || return 1; shift ;;
                    --files | --hidden | -u | -uu | -uuu | -0 | --null | -L | --follow | --no-ignore*) ;;
                    --glob=* | --iglob=* | --type=* | --type-not=* | -g?* | -t?* | -T?*) ;;
                    -*) return 1 ;;
                    *) roots+=("$(path "$t")") ;;
                esac
            done ;;
        *) roots=("$CWD") ;;
    esac
    ((${#roots[@]})) || roots=("$CWD")
    tree_has_secret "${roots[@]}" || scan=$?
    ((scan == 1))
}

# Parse fd selection independently of child argv. --glob is a switch; the
# first positional is its pattern and every later positional is a search root.
fd_filter_safe() {
    local t pattern='' pattern_seen=0 glob=0 base="$CWD" scan=0 root filter
    local positionals=() search_paths=() roots=() extensions=()
    local SCAN_NAME_GLOBS='' SCAN_PRUNED=0 SCAN_FOLLOW=1
    while (($#)); do
        t="$1"; shift
        case "$t" in
            -g | --glob) glob=1 ;;
            -e | --extension)
                (($#)) || return 1
                extensions+=("*.${1#.}"); shift ;;
            --extension=* | -e?*)
                if [[ "$t" == --* ]]; then filter="${t#*=}"; else filter="${t:2}"; fi
                extensions+=("*.${filter#.}") ;;
            --search-path | --base-directory)
                (($#)) || return 1
                if [[ "$t" == --base-directory ]]; then base="$(path "$1")"; else search_paths+=("$1"); fi
                shift ;;
            --search-path=*) search_paths+=("${t#*=}") ;;
            --base-directory=*) base="$(path "${t#*=}")" ;;
            -H | --hidden | -I | --no-ignore | -u | --unrestricted | -L | --follow | -0 | --print0 | --absolute-path | -a | --full-path | -p | --fixed-strings | -F | --ignore-case | -i | --case-sensitive | -s) ;;
            --) positionals+=("$@"); break ;;
            -*) return 1 ;;
            *) positionals+=("$t") ;;
        esac
    done
    if ((${#positionals[@]})); then
        pattern="${positionals[0]}"; pattern_seen=1
        search_paths+=("${positionals[@]:1}")
    fi
    # Resolve search roots only after the effective base has been collected.
    local CWD="$base"
    for root in ${search_paths[@]+"${search_paths[@]}"}; do roots+=("$(path "$root")"); done
    ((${#roots[@]})) || roots=("$base")
    for filter in ${extensions[@]+"${extensions[@]}"}; do
        protected_selector "$filter" && return 1
        SCAN_NAME_GLOBS+="$filter"$'\n'
    done
    if ((pattern_seen)) && [[ -n "$pattern" && "$pattern" != . ]]; then
        protected_selector "$pattern" && return 1
        if ((glob && ${#extensions[@]} == 0)); then SCAN_NAME_GLOBS="$pattern"$'\n'; fi
    fi
    tree_has_secret "${roots[@]}" || scan=$?
    ((scan == 1))
}

# fd_operands: metadata searches stay available, but exec receives each match
# as an input just like find -exec, including fd implicit argument appending.
fd_operands() {
    local j k exec_start=0 narrow=0 child=() words=("${W[@]}")
    for ((j = 1; j < ${#words[@]}; j++)); do
        case "${words[j]}" in -x | -X | --exec | --exec-batch) exec_start=$((j + 1)); break ;; esac
    done
    ((exec_start)) || return 0
    if listing_producer_safe fd "${words[@]:1:exec_start-2}"; then narrow=1; fi
    child=("${words[@]:exec_start}")
    if ((narrow == 0)); then
        for ((k = 0; k < ${#child[@]}; k++)); do
            [[ "${child[k]}" != '{}' ]] || child[k]="$CWD/.env"
        done
        # An absolute witness is protected even when no cwd .env exists.
        child+=("$CWD/.env")
    fi
    analyse_child_words "${child[@]}"
}

# consumer_operands: env-file options are inputs intentionally exempted by policy.
# Unknown docker option arity fails analysis instead of guessing the image/child.
consumer_operands() {
    local kind="$1" j=1 t sub=""
    if [[ "$kind" == dotenv ]]; then
        if [[ " ${W[*]} " == *' list '* ]]; then REASON='dotenv prints environment values'; return 0; fi
        while ((j < ${#W[@]})); do
            t="${W[j]}"
            case "$t" in
                --) j=$((j + 1)); break ;;
                -p | --print) REASON='dotenv prints an environment value'; return 0 ;;
                -e | --env | -v | --variable)
                    j=$((j + 1)); ((j < ${#W[@]})) || return 1 ;;
                run | -e?* | --env=* | -v?* | --variable=* | --debug | -o | --override | --no-expand) ;;
                -c | --cascade)
                    # The optional environment label cannot be reliably
                    # distinguished from a command: analyse either interpretation.
                    if [[ "${W[j+1]:-}" != -* && -n "${W[j+1]:-}" ]]; then
                        analyse_child "$((j + 1))" || return 1
                        [[ -z "$REASON" ]] || return 0
                        j=$((j + 1))
                    fi
                    ;;
                -c?* | --cascade=*) ;;
                -*) return 1 ;;
                *) break ;;
            esac
            j=$((j + 1))
        done
        if ((j < ${#W[@]})); then analyse_child "$j" || return 1; fi
        return 0
    fi
    while ((j < ${#W[@]})); do
        case "${W[j]}" in
            --context | -c | --host | -H | --config | --log-level | -l) j=$((j + 2)) ;;
            --env-file) j=$((j + 2)) ;;
            --env-file=*) j=$((j + 1)) ;;
            --context=* | --host=* | --config=* | --log-level=* | --tls | --tlsverify | --debug | -D) j=$((j + 1)) ;;
            run | exec | compose) sub="${W[j]}"; j=$((j + 1)); break ;;
            *) return 1 ;;
        esac
    done
    for ((j = j; j < ${#W[@]}; j++)); do
        t="${W[j]}"
        case "$t" in
            -v | --volume | --mount)
                j=$((j + 1)); ((j < ${#W[@]})) || return 1
                if [[ "$t" == --mount ]]; then
                    local mount="${W[j]}" src
                    case "$mount" in *src=* | *source=*)
                        src="${mount#*src=}"; [[ "$src" != "$mount" ]] || src="${mount#*source=}"
                        src="${src%%,*}"
                        if reader_operand "$src"; then REASON='docker mount reads a protected file'; return 0; fi ;;
                    esac
                elif reader_operand "${W[j]%%:*}"; then
                    REASON='docker volume reads a protected file'; return 0
                fi
                continue ;;
            --mount=* | --volume=* | -v?*)
                local mount="${t#*=}" src
                [[ "$t" != -v?* ]] || mount="${t:2}"
                case "$t" in --mount=*)
                    case "$mount" in *src=* | *source=*)
                        src="${mount#*src=}"; [[ "$src" != "$mount" ]] || src="${mount#*source=}"
                        src="${src%%,*}" ;;
                        *) src='' ;;
                    esac ;;
                    *) src="${mount%%:*}" ;;
                esac
                if [[ -n "$src" ]] && reader_operand "$src"; then
                    REASON='docker mount reads a protected file'; return 0
                fi
                continue ;;
            --env-file) j=$((j + 1)); continue ;;
            --env-file=*) continue ;;
            -e | --env | -p | --publish | --name | --network | -w | --workdir | -u | --user | --entrypoint | --pull | -f | --file | --project-name | --profile)
                # An explicit entrypoint changes the child interpretation.
                [[ "$t" != --entrypoint ]] || return 1
                j=$((j + 1)); continue ;;
            --entrypoint=*) return 1 ;;
            --*=* | --rm | -i | -t | -it | -ti | -d | --detach | --init | --privileged | --build | --no-deps | -T) continue ;;
            --) j=$((j + 1)); break ;;
            -*) return 1 ;;
            *) break ;;
        esac
    done
    if [[ "$sub" == compose ]]; then
        if [[ "${W[j]:-}" == config || "${W[j]:-}" == convert ]]; then REASON='compose config prints env-file values'; fi
        if [[ "${W[j]:-}" == run || "${W[j]:-}" == exec ]]; then
            j=$((j + 1))
            for ((j = j; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    -e | --env | -u | --user | -w | --workdir | --name | -p | --publish) j=$((j + 1)) ;;
                    -e?* | -u?* | -w?* | -p?* | --env=* | --user=* | --workdir=* | --name=* | --publish=* | -T | -d | --rm | --no-deps) ;;
                    --entrypoint | --entrypoint=*) return 1 ;;
                    --) j=$((j + 1)); break ;;
                    -*) return 1 ;;
                    *) break ;;
                esac
            done
            ((j < ${#W[@]})) || return 1
            analyse_child "$((j + 1))" || return 1
        fi
    elif ((j < ${#W[@]})); then
        analyse_child "$((j + 1))" || return 1
    fi
    return 0
}

# Inline configuration uses a small inert-key allowlist. Transport and
# protocol controls are never certified by examining their value alone.
git_config_safe_key() {
    local key
    key="$(lower "$1")"
    case "$key" in
        color.* | core.quotepath | core.autocrlf | core.safecrlf | core.abbrev | user.name | user.email | init.defaultbranch | advice.* | log.* | format.pretty | column.* | i18n.* | safe.directory | http.sslverify) return 0 ;;
        pager.*) [[ "$(lower "$2")" == true || "$(lower "$2")" == false ]]; return ;;
    esac
    return 1
}

git_config_value_safe() {
    git_config_safe_key "$1" "$2"
}

# Values assigned in the command text are not inherited configuration. Only
# literal editor/pager programs with literal arguments can be certified.
git_command_assignment() {
    local name="${1%%=*}" value="${1#*=}" program word
    name="${name%+}"
    local words=()
    case "$name" in
        GIT_EXTERNAL_DIFF | GIT_SSH* | GIT_ASKPASS | SSH_ASKPASS | GIT_PROXY_COMMAND)
            REASON='git command environment cannot be certified'; return 0 ;;
        GIT_EDITOR | GIT_SEQUENCE_EDITOR | EDITOR | VISUAL | GIT_PAGER | PAGER) ;;
        GIT_CONFIG_PARAMETERS | BASH_ENV)
            REASON='inline configuration or shell startup file cannot be certified'; return 0 ;;
        LESS?*)
            REASON='pager environment cannot be certified'; return 0 ;;
        LESS)
            [[ "$value" =~ ^[-FRXSKNMi]*$ ]] || REASON='pager environment cannot be certified'
            return 0 ;;
        BASHOPTS | SHELLOPTS)
            case ":$value:" in *:cdable_vars:* | *:autocd:* | *:extglob:* | *:globstar:*)
                REASON='shell options make directory changes indeterminate'; return 0 ;; esac
            return 0 ;;
        *) return 0 ;;
    esac
    # Word splitting is safe here only after metacharacters and expansions
    # have been excluded. A path to an executable is not an allowlisted name.
    case "$value" in
        '' | *'$'* | *'`'* | *\\* | *'"'* | *"'"* | *';'* | *'|'* | *'&'* | *'<'* | *'>'* | *'('* | *')'* | *'{'* | *'}'* | *'['* | *']'* | *'?'* | *'*'* | *$'\n'* | *$'\r'*)
            REASON='git command environment cannot be certified'; return 0 ;;
    esac
    read -r -a words <<<"$value"
    program="${words[0]:-}"
    case "$program" in
        vi | vim | nvim | nano | emacs | emacsclient | code | codium | subl | mate | hx | kak | micro | less | more | most | true | :) ;;
        cat | delta) case "$name" in GIT_PAGER | PAGER) ;; *) REASON='git command environment cannot be certified'; return 0 ;; esac ;;
        *) REASON='git command environment cannot be certified'; return 0 ;;
    esac
    if [[ "$program" == less ]] && ((${#words[@]} > 2)); then
        REASON='git command environment cannot be certified'; return 0
    fi
    for word in "${words[@]:1}"; do
        case "$program:$word" in
            code:-w | code:--wait | code:-n | code:--new-window | code:-r | code:--reuse-window | \
            codium:-w | codium:--wait | codium:-n | codium:--new-window | codium:-r | codium:--reuse-window | \
            subl:-w | subl:--wait | mate:-w | mate:--wait | \
            emacs:-nw | emacs:-t | emacs:-c | emacs:--no-window-system | emacs:--tty | emacs:--create-frame | \
            emacsclient:-nw | emacsclient:-t | emacsclient:-c | emacsclient:--no-window-system | emacsclient:--tty | emacsclient:--create-frame) ;;
            less:-*) [[ "$word" =~ ^-[-FRXSKNMi]+$ ]] || {
                REASON='git command environment cannot be certified'; return 0;
            } ;;
            *) REASON='git command environment cannot be certified'; return 0 ;;
        esac
    done
}

# git_shell_text: inspect command-running configuration as bounded shell text.
git_shell_text() {
    [[ -n "$1" ]] || return 1
    analyse "$1" "$((depth + 1))" "$in_run" && [[ -z "$REASON" ]]
}

# git_probe: run only isolated, bounded Git processes. A separate session
# prevents Git's config helpers from signalling the guard's process group.
git_probe() {
    [[ "$GIT_BINARY" == /* ]] || return 2
    perl -MPOSIX=setsid -MTime::HiRes=alarm -e '
        my $pid = fork(); defined $pid or exit 2;
        if (!$pid) {
            setsid() >= 0 or exit 2;
            exec "env", "-i", "PATH=$ENV{PATH}", "LC_ALL=C",
                "GIT_CONFIG_NOSYSTEM=1", "GIT_CONFIG_GLOBAL=/dev/null",
                "HOME=/dev/null/secret-guard-no-home",
                @ARGV;
            exit 2;
        }
        local $SIG{ALRM} = sub { kill "TERM", -$pid; waitpid($pid, 0); exit 2 };
        alarm 0.3; waitpid($pid, 0) == $pid or exit 2;
        my $status = $?; alarm 0;
        exit($status == 0 ? 0 : 2);
    ' "${GIT_ENV[@]+"${GIT_ENV[@]}"}" "$GIT_BINARY" -C "$root_cwd" \
        -c core.fsmonitor=false -c core.untrackedCache=false \
        -c core.hooksPath=/dev/null --no-optional-locks \
        "${GIT_GLOBALS[@]+"${GIT_GLOBALS[@]}"}" "$@"
}

# git_index_protected: inspect bounded tracked names, never Git blob contents.
# Status 0 means protected/indeterminate; 1 means proven clear.
git_index_protected() {
    context_credentials
    [[ "$GIT_BINARY" == /* ]] || return 0
    if [[ "${INDEX_CACHE_KEY:-}" == "$GIT_SCAN_DIR:$GIT_SCAN_CWD:$CONTEXT_CREDENTIAL" ]]; then return "$INDEX_CACHE_STATUS"; fi
    local result=0
    perl - "$GIT_SCAN_DIR" "$GIT_SCAN_CWD" "${PATH:-/usr/bin:/bin}" "$GIT_BINARY" "$CREDENTIAL_PATH" "$CREDENTIAL_PUBLIC" "$CONTEXT_CREDENTIAL" <<'PERL' || result=$?
use strict; use warnings; use Time::HiRes qw(alarm); use POSIX qw(setsid);
my ($dir, $cwd, $path, $git, $credential, $public, $context) = @ARGV;
my $pid = open my $f, '-|'; defined $pid or exit 0;
if (!$pid) {
    setsid() >= 0 or exit 2;
    chdir $cwd or exit 2;
    exec 'env', '-i', "PATH=$path", 'LC_ALL=C', "GIT_DIR=$dir",
        "GIT_WORK_TREE=$cwd", 'GIT_CONFIG_NOSYSTEM=1',
        'GIT_CONFIG_GLOBAL=/dev/null', 'HOME=/dev/null/secret-guard-no-home',
        $git, '-c', 'core.fsmonitor=false', '-c', 'core.untrackedCache=false',
        '-c', 'core.hooksPath=/dev/null', '--no-optional-locks', 'ls-files', '-z',
        '--full-name', '--', ':/';
    exit 2;
}
local $SIG{ALRM} = sub { kill 'TERM', -$pid; waitpid($pid, 0); exit 0 };
alarm 0.4;
local $/ = "\0";
my ($bytes, $count, $protected) = (0, 0, 0);
while (my $name = <$f>) {
    $bytes += length $name; $count++;
    if ($bytes > 4_000_000 || $count > 100_000) { $protected = 1; last }
    $name =~ s/\0\z//;
    if (("$cwd/$name" =~ /\A(?:$context)\z/i) ||
        ($name =~ /$credential\z/i && $name !~ /$public/i)) { $protected = 1; last }
    if ($name =~ m{(?:^|/)(?:\.secrets(?:/|\z)|\.aws/credentials\z|\.docker/config\.json\z|\.config/gh/hosts\.yml\z|\.ssh/id_[^/]*\z|\.npmrc\z|\.pypirc\z|\.netrc\z|\.git-credentials\z|\.envrc\z|\.env(?:\.[^/]*)?\z|[^/]*\.env\z|[^/]*\.secret\z)}i &&
        $name !~ /\.(?:env\.)?(?:example|sample|template)\z/i && $name !~ /\.ssh\/id_[^\/]*\.pub\z/i) { $protected = 1; last }
}
kill 'TERM', -$pid if $protected;
close $f; my $status = $?; alarm 0;
# An empty index is valid only when the index file was checked by the caller.
exit($protected || $status ? 0 : 1);
PERL
    INDEX_CACHE_KEY="$GIT_SCAN_DIR:$GIT_SCAN_CWD:$CONTEXT_CREDENTIAL"
    INDEX_CACHE_STATUS="$result"
    return "$result"
}

# git_policy: permit only modelled safe forms; gate content on index names.
git_policy() {
    local j=1 t sub='' output=1 repo='' key value count n has_display=0 template=0
    local GIT_GLOBALS=() GIT_ENV=() args=() root_cwd="$CWD" GIT_SCAN_CWD="$CWD" GIT_SCAN_DIR='' gitdir='' worktree=''
    if [[ "$CMD" == *GIT_CONFIG_GLOBAL=* || "$CMD" == *GIT_CONFIG_SYSTEM=* ||
        "$CMD" == *GIT_CONFIG_PARAMETERS=* ]]; then
        REASON='git inline configuration cannot be certified'; return 0
    fi
    # Inherited editor and pager settings are user configuration, not command text.
    if [[ "$CMD" == *GIT_CONFIG_COUNT=* || "$CMD" == *GIT_CONFIG_KEY_* || "$CMD" == *GIT_CONFIG_VALUE_* ]]; then
        REASON='git inline configuration cannot be certified'; return 0
    fi
    if [[ -n "${GIT_CONFIG_PARAMETERS:-}" ]]; then
        REASON='git inline configuration cannot be certified'; return 0
    fi
    count="${GIT_CONFIG_COUNT:-0}"
    [[ "$count" =~ ^[0-9]+$ ]] || { REASON='git configuration count is indeterminate'; return 0; }
    ((count <= 64)) || { REASON='git configuration count exceeds limit'; return 0; }
    for ((n = 0; n < count; n++)); do
        key="GIT_CONFIG_KEY_$n" value="GIT_CONFIG_VALUE_$n"
        if ! git_config_value_safe "${!key:-}" "${!value:-}"; then
            REASON='git configuration may launch a command'; return 0
        fi
    done
    while ((j < ${#W[@]})); do
        t="${W[j]}"
        case "$t" in
            -C | -c | --config-env | --git-dir | --work-tree | --namespace | --attr-source | --exec-path | --super-prefix | --list-cmds)
                ((j + 1 < ${#W[@]})) || return 1
                value="${W[j+1]}"; j=$((j + 2)) ;;
            -C?* | -c?* | --config-env=* | --git-dir=* | --work-tree=* | --namespace=* | --attr-source=* | --exec-path=* | --super-prefix=* | --list-cmds=*)
                if [[ "$t" == -C?* || "$t" == -c?* ]]; then value="${t:2}"; else value="${t#*=}"; fi
                j=$((j + 1)) ;;
            --no-pager | -p | --paginate | --bare | --literal-pathspecs | --glob-pathspecs | --noglob-pathspecs | --icase-pathspecs | --no-optional-locks | --no-replace-objects | --no-lazy-fetch)
                GIT_GLOBALS+=("$t"); j=$((j + 1)); continue ;;
            -*) REASON='unknown git global option'; return 0 ;;
            *) sub="$t"; j=$((j + 1)); break ;;
        esac
        case "$t" in
            -C | -C?*)
                [[ "$value" != *'$'* && "$value" != *'`'* ]] || { REASON='git repository is indeterminate'; return 0; }
                CWD="$(path "$value")"; GIT_GLOBALS+=(-C "$value") ;;
            -c | -c?* | --config-env | --config-env=*)
                if [[ "$t" == --config-env* ]]; then
                    # Git splits name=ENVVAR at the last equals sign; names may contain one.
                    key="${value%=*}"
                    if [[ "$value" != *=* || ! "${value##*=}" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] ||
                        ! git_config_safe_key "$key" ''; then
                        REASON='git configuration may launch a command or read a protected file'; return 0
                    fi
                else
                    key="${value%%=*}"
                    if [[ "$value" != *=* ]] || ! git_config_value_safe "$key" "${value#*=}" ||
                        raw_mentions_protected "$value"; then
                        REASON='git configuration may launch a command or read a protected file'; return 0
                    fi
                fi
                GIT_GLOBALS+=("$t")
                [[ "$t" != -c && "$t" != --config-env ]] || GIT_GLOBALS+=("$value") ;;
            --git-dir | --git-dir=*) gitdir="$value"; GIT_GLOBALS+=("--git-dir=$value") ;;
            --work-tree | --work-tree=*) worktree="$value"; GIT_GLOBALS+=("--work-tree=$value") ;;
            *) GIT_GLOBALS+=("$t"); [[ "$t" != --*=* ]] || continue; GIT_GLOBALS+=("$value") ;;
        esac
    done
    [[ -n "$sub" ]] || { REASON='git subcommand is indeterminate'; return 0; }
    # The credential printer is classified at the direct-stash pipe boundary.
    if [[ "$sub" == credential && "${W[j]:-}" == fill ]]; then return 0; fi
    for value in "$gitdir" "$worktree" "${GIT_DIR:-}" "${GIT_WORK_TREE:-}"; do
        [[ "$value" != *'$'* && "$value" != *'`'* && "$value" != *'*'* && "$value" != *'?'* ]] || { REASON='git repository is indeterminate'; return 0; }
    done
    args=("${W[@]:j}")
    if [[ "$sub" == init || "$sub" == clone ]]; then
        # Git creates configuration even if the destination does not exist yet.
        if [[ -n "$gitdir" ]]; then GIT_ROOTS+=("$(path "$gitdir")"); fi
        if [[ "$sub" == init ]]; then
            for t in "${args[@]+"${args[@]}"}"; do
                case "$t" in --bare | --mirror) ;; -*) ;; *) GIT_ROOTS+=("$(path "$t")");; esac
            done
            for t in "${args[@]+"${args[@]}"}"; do
                if [[ "$t" == --bare ]]; then GIT_ROOTS+=("$CWD"); break; fi
            done
        else
            for ((n = ${#args[@]} - 1; n > 0; n--)); do
                t="${args[n]}"; [[ "$t" != -* ]] || continue
                GIT_ROOTS+=("$(path "$t")"); break
            done
        fi
        if [[ "$sub" == clone ]]; then
            for t in "${args[@]+"${args[@]}"}"; do
                case "$t" in -u | --upload-pack | --upload-pack=* | -u?*)
                    REASON='git clone upload command cannot be certified'; return 0 ;; esac
            done
        fi
        if [[ "$CMD" == *GIT_TEMPLATE_DIR=* ]]; then
            REASON='git template directory cannot be certified'; return 0
        fi
        for ((n = 0; n < ${#args[@]}; n++)); do
            t="${args[n]}"
            case "$t" in
                --te* | --separate-git-dir | --separate-git-dir=*) template=1 ;;
                -c | --config)
                    n=$((n + 1)); ((n < ${#args[@]})) || return 1
                    value="${args[n]}"
                    git_config_value_safe "${value%%=*}" "${value#*=}" || template=1 ;;
                -c?* | --config=*)
                    if [[ "$t" == -c?* ]]; then value="${t:2}"; else value="${t#*=}"; fi
                    git_config_value_safe "${value%%=*}" "${value#*=}" || template=1 ;;
            esac
        done
        if ((template)); then REASON='git template directory cannot be certified'; return 0; fi
    fi
    if [[ "$sub" == submodule && " ${args[*]} " == *' foreach '* ]]; then
        REASON='git submodule foreach cannot be certified'; return 0
    fi
    if [[ "$CMD" == *submodule.* || "$CMD" == *--submodule=diff* || "$CMD" == *--submodule=log* ]]; then
        REASON='git submodule content cannot be certified'; return 0
    fi
    # An alias may execute arbitrary Git configuration; only built-ins can be certified.
    case "$sub" in
        status | clean | log | shortlog | diff | branch | tag | remote | rev-parse | rev-list | ls-files | ls-tree | show-ref | symbolic-ref | merge-base | describe | add | commit | restore | checkout | switch | stash | fetch | pull | push | clone | init | merge | rebase | cherry-pick | revert | reset | rm | mv | worktree | gc | prune | blame | check-ignore | show | cat-file | grep | archive | format-patch | reflog | diff-tree | diff-index | diff-files | range-diff | fast-export | config | credential | bisect | submodule | am | apply | bundle | difftool | mergetool | filter-branch | notes | ls-remote | help | version | whatchanged | annotate) ;;
        *) REASON='git subcommand or alias cannot be certified'; return 0 ;;
    esac
    case "$sub" in
        status) output=0; for t in "${args[@]+"${args[@]}"}"; do case "$t" in -v | --verbose | -vv | -vvv) output=1 ;; esac; done ;;
        branch | tag | remote)
            output=0
            for t in "${args[@]+"${args[@]}"}"; do
                case "$t" in -vv | -vvv | --verbose | --format=* | --format)
                    output=1 ;; esac
            done ;;
        rev-parse | rev-list | ls-files | ls-tree | show-ref | symbolic-ref | merge-base | describe | check-ignore) output=0 ;;
        clean) output=0 ;;
        log | shortlog)
            output=0
            for t in "${args[@]+"${args[@]}"}"; do
                case "$t" in
                    --oneline | --graph | --decorate* | -n | -n[0-9]* | -[0-9]* | --max-count* | --skip* | --since* | --until* | --after* | --before* | --author* | --committer* | --grep* | --all-match | -i | --format* | --pretty* | --stat | --shortstat | --numstat | --name-only | --name-status | --abbrev* | --all | --branches | --tags | --remotes | --reverse | --first-parent | --merges | --no-merges | --date* | --follow | --no-color | --color* | --) ;;
                    -*) output=1 ;;
                esac
            done ;;
        add | commit | restore | checkout | switch | fetch | pull | push | clone | init | merge | cherry-pick | revert | reset | rm | mv | worktree | gc | prune) output=0 ;;
        rebase) output=0; for t in "${args[@]+"${args[@]}"}"; do case "$t" in -x | -x?* | --exec* | -i | --interactive) output=1 ;; esac; done ;;
        stash) case "${args[0]:-}" in "" | push | save | pop | apply | drop | clear | list) output=0 ;; esac
            for t in "${args[@]+"${args[@]}"}"; do case "$t" in -p | --patch) output=1 ;; esac; done ;;
        diff) output=0
            for t in "${args[@]+"${args[@]}"}"; do
                case "$t" in --stat | --name-only | --name-status | --numstat | --shortstat | --quiet | --exit-code) has_display=1 ;; --cached | --staged | -- | -z) ;; -*) output=1 ;; esac
            done
            ((has_display)) || output=1 ;;
        config)
            output=1
            # Match the Go hook's narrow, non-credential getter list.
            if ((${#args[@]} == 1)) || { ((${#args[@]} == 2)) && [[ "${args[0]}" == --get || "${args[0]}" == --get-all ]]; }; then
                if ((${#args[@]} == 1)); then key="$(lower "${args[0]}")"; else key="$(lower "${args[1]}")"; fi
                case "$key" in
                    x | user.name | user.email | core.repositoryformatversion | core.filemode | core.bare | core.logallrefupdates | core.ignorecase | core.precomposeunicode | core.autocrlf | core.eol | core.symlinks | core.abbrev | color.ui | init.defaultbranch | pull.rebase | push.default | fetch.prune) output=0 ;;
                esac
            fi
            ((output == 0)) || { REASON='git configuration cannot be certified'; return 0; } ;;
        apply)
            output=0; has_display=0
            for ((n = 0; n < ${#args[@]}; n++)); do
                t="${args[n]}"
                case "$t" in
                    --check | --stat | --numstat | --summary) has_display=1 ;;
                    -p | -C)
                        n=$((n + 1))
                        if ((n >= ${#args[@]})) || [[ ! "${args[n]}" =~ ^[0-9]+$ ]]; then
                            REASON='git apply write targets cannot be certified'; return 0
                        fi ;;
                    -p[0-9]* | -C[0-9]* | --exclude=* | --include=* | -v | --verbose | -z | --recount | --allow-empty) ;;
                    -*) REASON='git apply write targets cannot be certified'; return 0 ;;
                    *) ;;
                esac
            done
            if ((has_display == 0)); then REASON='git apply write targets cannot be certified'; return 0; fi ;;
        blame) output=0; for t in "${args[@]+"${args[@]}"}"; do case "$t" in --contents | --contents=*) output=1 ;; esac; done ;;
        show | diff-tree | diff-index | diff-files | reflog | range-diff | format-patch | am | cat-file | fast-export | archive | grep | bundle | difftool | filter-branch | bisect | submodule) ;;
        *) REASON='git subcommand or alias cannot be certified'; return 0 ;;
    esac
    local grep_pattern=0
    for ((n = 0; n < ${#args[@]}; n++)); do
        t="${args[n]}"
        if [[ "$sub" == grep ]]; then
            case "$t" in -e | --regexp)
                n=$((n + 1)); continue ;;
                -e?* | --regexp=*) continue ;;
                -[!e]*) continue ;;
                --) continue ;;
                *) if ((grep_pattern == 0)); then grep_pattern=1; continue; fi ;;
            esac
        fi
        if [[ "$sub" == log ]]; then
            case "$t" in -S | -G | --grep) n=$((n + 1)); continue ;;
                -S?* | -G?* | --grep=*) continue ;; esac
        fi
        case "$t" in
            --upload-pack | --receive-pack | --exec | --extcmd | -x)
                ((n + 1 < ${#args[@]})) || return 1
                n=$((n + 1))
                git_shell_text "${args[n]}" || { REASON='git command option cannot be certified'; return 0; }
                continue ;;
            --upload-pack=* | --receive-pack=* | --exec=* | --extcmd=* | -x?*)
                if [[ "$t" == -x?* ]]; then value="${t:2}"; else value="${t#*=}"; fi
                git_shell_text "$value" || { REASON='git command option cannot be certified'; return 0; } ;;
            --contents | --contents=*)
                if [[ "$t" == --contents ]]; then
                    ((n + 1 < ${#args[@]})) || return 1
                    n=$((n + 1)); value="${args[n]}"
                else value="${t#*=}"; fi
                if is_secret "$value" || reader_operand "$value"; then REASON='git contents file targets a protected store'; return 0; fi ;;
            --full-diff) output=1 ;;
        esac
        if [[ "$t" == -- ]]; then continue; fi
        if [[ ("$sub" == commit || "$sub" == tag) && ("$t" == -m || "$t" == --message) ]]; then n=$((n + 1)); continue; fi
        if [[ ("$sub" == commit || "$sub" == tag) && ("$t" == -F || "$t" == --file) ]]; then
            n=$((n + 1))
            if [[ "${args[n]:-}" != - ]] && reader_operand "${args[n]:-}"; then REASON='git message file targets a protected store'; return 0; fi
            continue
        fi
        if [[ ("$sub" == commit || "$sub" == tag) && ("$t" =~ ^-[as]*F.+ || "$t" == --file=*) ]]; then
            if [[ "$t" == --file=* ]]; then value="${t#*=}"; else value="${t#*F}"; fi
            if [[ "$value" != - ]] && reader_operand "$value"; then REASON='git message file targets a protected store'; return 0; fi
            continue
        fi
        if [[ ("$sub" == commit || "$sub" == tag) && "$t" =~ ^-[as]*m$ ]]; then n=$((n + 1)); continue; fi
        if [[ ("$sub" == commit || "$sub" == tag) && ("$t" == --file=- || "$t" == -F- || "$t" == --message=* || "$t" == -m?* || "$t" =~ ^-[as]*m.) ]]; then continue; fi
        if [[ "$sub" == rm && " ${args[*]} " == *' --cached '* ]]; then continue; fi
        value="$t"
        # Content commands can all accept revision:path blob operands. Apply
        # the ordinary protected/template rules to the path, not the revision.
        case "$sub:$t" in
            show:*:* | cat-file:*:* | diff:*:* | diff-files:*:* | diff-index:*:* | diff-tree:*:* | difftool:*:* | range-diff:*:* | log:*:* | shortlog:*:* | whatchanged:*:* | blame:*:* | annotate:*:* | grep:*:* | archive:*:* | format-patch:*:* | fast-export:*:*) value="${t#*:}" ;;
        esac
        if [[ "$sub" != status && "$sub" != clean && "$sub" != ls-files && "$sub" != check-ignore ]] &&
            { is_secret "$value" || reader_operand "$value"; }; then
            REASON='git path targets a protected store'; return 0
        fi
    done
    if [[ "$sub" == grep && ${SEARCH_GIT_SCOPE_SAFE:-0} == 1 ]]; then return 0; fi
    # Alternate indexes can be staged before a later content-producing call.
    if [[ -n "${GIT_COMMAND_REPO_OVERRIDE:-}" ]]; then
        REASON='git repository or object source is indeterminate'; return 0
    fi
    ((output)) || return 0
    if [[ -e "$(path .gitmodules)" ]]; then
        REASON='git submodule content cannot be certified'; return 0
    fi
    if [[ -n "${GIT_COMMAND_REPO_OVERRIDE:-}" || -n "${GIT_INDEX_FILE:-}" || -n "${GIT_COMMON_DIR:-}" ||
        -n "${GIT_OBJECT_DIRECTORY:-}" || -n "${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}" || -n "${GIT_NAMESPACE:-}" ]]; then
        REASON='git repository or object source is indeterminate'; return 0
    fi
    if [[ -z "$gitdir" && -n "$GIT_DIR" ]]; then
        gitdir="$(path "$GIT_DIR")"
        GIT_GLOBALS+=("--git-dir=$gitdir")
    fi
    if [[ -z "$worktree" && -n "$GIT_WORK_TREE" ]]; then
        worktree="$(path "$GIT_WORK_TREE")"
        GIT_GLOBALS+=("--work-tree=$worktree")
    fi
    # Resolve only guard-computed repository paths into the scrubbed child.
    if [[ -n "${GIT_DIR:-}" ]]; then GIT_ENV+=("GIT_DIR=$(path "$GIT_DIR")"); fi
    if [[ -n "${GIT_WORK_TREE:-}" ]]; then GIT_ENV+=("GIT_WORK_TREE=$(path "$GIT_WORK_TREE")"); fi
    repo="$(git_probe rev-parse --show-toplevel 2>/dev/null)" || repo=''
    [[ -n "$repo" ]] || { REASON='git repository is indeterminate'; return 0; }
    GIT_SCAN_CWD="$repo"
    value="$(git_probe rev-parse --is-bare-repository 2>/dev/null)" || value=''
    [[ "$value" == false ]] || { REASON='git repository is indeterminate'; return 0; }
    value="$(git_probe rev-parse --git-path index 2>/dev/null)" || value=''
    [[ -n "$value" ]] || { REASON='git index is indeterminate'; return 0; }
    [[ "$value" == /* ]] || value="$CWD/$value"
    [[ -f "$value" && -r "$value" ]] || { REASON='git index is indeterminate'; return 0; }
    GIT_SCAN_DIR="$(git_probe rev-parse --absolute-git-dir 2>/dev/null)" || GIT_SCAN_DIR=''
    [[ -n "$GIT_SCAN_DIR" ]] || { REASON='git repository is indeterminate'; return 0; }
    if git_index_protected; then
        REASON='git index contains protected names or is indeterminate'
    else
        n=$?
        [[ "$n" == 1 ]] || REASON='git index cannot be inspected safely'
    fi
}

# file_operands KIND: unknown positional operands are inputs, not an exemption.
# Known output/label roles are removed before the shared reader boundary check.
file_operands() {
    local kind="$1" j=1 t options=1 target=0 write_target="" count sub="" create=0 extract=0 listing=0 GIT_ROOT="" CWD="$CWD"
    local inputs=() scan=0 follow=0
    [[ "$kind" != bsdtar ]] || kind=tar
    case "$kind" in
        curl)
            for t in "${W[@]:1}"; do
                if [[ "$t" == file://* ]] && is_secret "${t#file://}"; then
                    REASON='curl reads a protected local file'; return 0
                fi
            done
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    -d | --data | --data-raw | --data-binary | --data-urlencode | --data-ascii | -F | --form | --form-string | -T | --upload-file)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1; t="${W[j]}" ;;
                    -d?* | -F?* | -T?*) t="${t:2}" ;;
                    --data=* | --data-*=* | --form=* | --form-string=* | --upload-file=*) t="${t#*=}" ;;
                    *) continue ;;
                esac
                case "$t" in *@*) t="${t##*@}" ;; esac
                if reader_operand "$t"; then REASON='curl uploads a protected file'; return 0; fi
            done
            return 0 ;;
        gh)
            if [[ "${W[1]:-}" == api ]]; then
                for ((j = 2; j < ${#W[@]}; j++)); do
                    t="${W[j]}"
                    case "$t" in -F | -f | --field | --raw-field)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1; t="${W[j]}" ;;
                    -F?* | -f?*) t="${t:2}" ;;
                    --field=* | --raw-field=*) t="${t#*=}" ;;
                    *) continue ;; esac
                    case "$t" in *@*) t="${t##*@}" ;; *) continue ;; esac
                    if reader_operand "$t"; then REASON='gh field reads a protected file'; return 0; fi
                done
            fi
            return 0 ;;
        echo | printf | export | declare | typeset | set | unset | ls | stat | test | '[' | '[[' | realpath | readlink | basename | dirname | chmod | chown | chgrp | rm) return 0 ;;
        fd | fdfind) fd_operands; return ;;
        tee | touch | truncate)
            for t in "${W[@]:1}"; do
                [[ "$t" == -* ]] && continue
                if git_write_target "$t"; then REASON='write targets git configuration'; return 0; fi
            done
            return 0 ;;
        find) find_operands; return ;;
        docker)
            # Login consumes stdin; it is not an image/child command launcher.
            if [[ "${W[1]:-}" == login ]]; then return 0; fi
            if [[ "${W[1]:-}" == inspect || ("${W[1]:-}" == container && "${W[2]:-}" == inspect) ]]; then return 0; fi
            consumer_operands "$kind"; return ;;
        dotenv) consumer_operands "$kind"; return ;;
        dotenvx)
            if [[ "${W[1]:-}" == run ]]; then
                for ((j = 2; j < ${#W[@]}; j++)); do
                    case "${W[j]}" in
                        -f | --env-file) j=$((j + 1)) ;;
                        -f?* | --env-file=* | --overload) ;;
                        --) analyse_child "$((j + 1))" || return 1; break ;;
                        *) analyse_child "$j" || return 1; break ;;
                    esac
                done
                return 0
            fi ;;

        du | file)
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$kind:$t" in
                    du:--files0-from | du:--exclude-from | du:-X | file:--files-from | file:-f | file:--magic-file | file:-m)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1; t="${W[j]}" ;;
                    du:--files0-from=* | du:--exclude-from=* | file:--files-from=* | file:--magic-file=*) t="${t#*=}" ;;
                    du:-X?* | file:-f?* | file:-m?*) t="${t:2}" ;;
                    *) continue ;;
                esac
                if reader_operand "$t"; then REASON="${kind} option reads a protected file"; return 0; fi
            done
            return 0
            ;;
        kubectl)
            if [[ "${W[1]:-}" == create && "${W[2]:-}" == secret ]]; then return 0; fi ;;
        git) git_policy; return ;;
        7z | 7za | 7zr | cpio)
            for t in "${W[@]:1}"; do
                case "$t" in -so | --to-stdout)
                    REASON='archive extraction to stdout is indeterminate'; return 0 ;; esac
            done
            ;;
        funzip) REASON='archive extraction to stdout is indeterminate'; return 0 ;;
        unzip)
            for t in "${W[@]:1}"; do
                case "$t" in -[!-]*p* | -[!-]*c* | -p* | -c*) REASON='archive extraction to stdout is indeterminate'; return 0 ;; esac
            done
            ;;
        tar | bsdtar)
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    --cr | --cre | --crea | --creat) W[j]=--create ;;
                    --der | --dere | --deref | --derefe | --derefer | --dereferen | --dereferenc) W[j]=--dereference ;;
                    -O | -*O* | --to-s* | --to-c*) REASON='archive extraction to stdout or a command is indeterminate'; return 0 ;;
                    --checkpoint-action=exec=* | --checkpoint-act=exec=*)
                        git_shell_text "${t#*exec=}" || { REASON='archive option may execute an unverified command'; return 0; } ;;
                    --use-compress-program=* | --use-compress-prog=* | --rsh-command=* | --info-script=* | --new-volume-script=*)
                        git_shell_text "${t#*=}" || { REASON='archive option may execute an unverified command'; return 0; } ;;
                    --checkpoint-act* | --use-compress-prog* | --rsh-comm* | --info-scr* | --new-volume-scr* | -I | -F)
                        j=$((j + 1))
                        if [[ -z "${W[j]:-}" ]] || ! git_shell_text "${W[j]}"; then
                            REASON='archive option may execute an unverified command'; return 0
                        fi ;;
                esac
            done
            j=1
            for t in "${W[@]:1}"; do
                [[ "$t" != -- ]] || break
                case "$t" in --create | -c* | -[!-]*c*) create=1 ;; --extract | -x* | -[!-]*x*) extract=1 ;; --list | -t* | -[!-]*t*) listing=1 ;; esac
                case "$t" in --dereference | -h | -[!-]*h*) follow=1 ;; esac
            done
            case "${W[1]:-}" in c*) create=1 ;; x*) extract=1 ;; t*) listing=1 ;; esac
            ;;
    esac
    for ((j = j; j < ${#W[@]}; j++)); do
        t="${W[j]}"
        if ((options)); then
            if [[ "$kind" == tar && "$j" == 1 && "$t" =~ ^[acrtuxzjJvfh]+$ ]]; then t="-$t"; fi
            case "$kind:$t" in
                *:--) options=0; continue ;;
                zip:-) inputs+=("-"); continue ;;
                dd:if=*) inputs+=("${t#if=}"); continue ;;
                dd:of=*) if git_write_target "${t#of=}"; then REASON='write targets git configuration'; return 0; fi; continue ;;
                dd:*) continue ;;
                cp:-t | mv:-t | ln:-t | install:-t | cp:--target-directory | mv:--target-directory | ln:--target-directory | install:--target-directory)
                    target=1; j=$((j + 1)); write_target="${W[j]:-}"; continue ;;
                cp:-t?* | mv:-t?* | ln:-t?* | install:-t?* | cp:--target-directory=* | mv:--target-directory=* | ln:--target-directory=* | install:--target-directory=*) target=1; if [[ "$t" == *=* ]]; then write_target="${t#*=}"; else write_target="${t:2}"; fi; continue ;;
                openssl:-in | openssl:-inkey | scp:-i)
                    j=$((j + 1)); inputs+=("${W[j]:-}"); continue ;;
                openssl:-in=* | openssl:-inkey=*) inputs+=("${t#*=}"); continue ;;
                openssl:-out | openssl:-pass | openssl:-passin | openssl:-passout | gpg:-o | gpg:--output | sops:--output | git:-m | git:--message | git:--format | git:--pretty)
                    j=$((j + 1)); continue ;;
                split:-l | split:-b | split:-C | split:-n | split:-a | split:--lines | split:--bytes | split:--number | split:--suffix-length | install:-m | install:-o | install:-g | rsync:-e | rsync:--exclude | rsync:--include | scp:-P | scp:-o | cp:-S | cp:--suffix | mv:-S | mv:--suffix | ln:-S | ln:--suffix)
                    j=$((j + 1)); continue ;;
                tar:--file | tar:-*[f])
                    j=$((j + 1)); ((create)) || inputs+=("$(path "${W[j]:-}")"); continue ;;
                tar:--file=*) ((create)) || inputs+=("$(path "${t#*=}")"); continue ;;
                tar:-I | tar:-F | tar:--checkpoint-action | tar:--use-compress-program | tar:--rsh-command | tar:--info-script | tar:--new-volume-script)
                    j=$((j + 1)); continue ;;
                tar:-*f?*) ((create)) || inputs+=("$(path "${t#*f}")"); continue ;;
                tar:-C | tar:--directory) j=$((j + 1)); CWD="$(path "${W[j]:-}")"; continue ;;
                tar:--directory=*) CWD="$(path "${t#*=}")"; continue ;;
                jq:-[!-]*f* | jq:--from-file | jq:--from-file=*)
                    if [[ "$t" == --from-file ]]; then j=$((j + 1)); inputs+=("${W[j]:-}")
                    elif [[ "$t" == --from-file=* ]]; then inputs+=("${t#*=}")
                    elif [[ "$t" == *f ]]; then j=$((j + 1)); inputs+=("${W[j]:-}")
                    else inputs+=("${t#*f}"); fi
                    continue ;;
                diff:--from-file=* | diff:--to-file=*) inputs+=("${t#*=}"); continue ;;
                *:-*) continue ;;

            esac
        fi
        # Git object:path operands refer to repository content, not a cwd filename.
        if [[ "$kind" == git && "$t" == *:* ]]; then t="$GIT_ROOT/${t#*:}"; fi
        [[ "$kind" != tar ]] || t="$(path "$t")"
        inputs+=("$t")
    done
    count=${#inputs[@]}
    case "$kind" in
        cp | mv | ln | install | rsync | scp)
            if ((target)); then
                if git_write_target "$write_target"; then REASON='write targets git configuration'; return 0; fi
            elif ((count >= 2)) && git_write_target "${inputs[count-1]}"; then
                REASON='write targets git configuration'; return 0
            fi
            ((target || count < 2)) || count=$((count - 1)) ;;
        split) ((count <= 1)) || count=1 ;;
        zip)
            # The first positional operand is the archive (including stdout
            # archive '-'), not an input file.
            inputs=("${inputs[@]:1}")
            count=${#inputs[@]} ;;
    esac
    if [[ "$kind" == tar && "$create" == 1 ]]; then
        for t in "${inputs[@]}"; do
            scan=0
            SCAN_FOLLOW="$follow" tree_has_secret "$(path "$t")" || scan=$?
            if ((scan != 1)); then REASON='archive input contains protected names or is incomplete'; return 0; fi
        done
    fi
    for ((j = 0; j < count; j++)); do
        if [[ "$kind" == tar && "$listing" == 1 && "$j" != 0 ]]; then continue; fi
        if [[ ("$kind" == tar || "$kind" == unzip) && "$extract" == 1 && "$j" != 0 ]]; then
            if protected_selector "${inputs[j]}"; then REASON='archive member targets a protected name'; return 0; fi
        fi
        if reader_operand "${inputs[j]}"; then
            REASON='file input targets a protected store'
            return 0
        fi
    done
    return 0
}

# sed_script: parse the entire script before accepting any safe command. Perl
# emits only literal file/command operands; it never runs sed or opens scripts.
sed_script() {
    local script="$1" actions line kind operand
    actions="$(perl - "$script" <<'PERL'
use strict; use warnings;
my $s = $ARGV[0]; my $i = 0; my $len = length $s; my $blocks = 0; my @actions;
sub fail { exit 2 }
sub peek { $i < $len ? substr($s, $i, 1) : '' }
sub space { $i++ while $i < $len && (peek() eq ' ' || peek() eq "\t") }
sub delim {
    my ($d) = @_;
    fail() if $d eq '' || $d eq "\n" || $d eq '\\';
    while ($i < $len) {
        my $c = substr($s, $i++, 1);
        if ($c eq '\\') { fail() if $i >= $len; $i++; next }
        return if $c eq $d;
    }
    fail();
}
sub address {
    space(); my $c = peek();
    if ($c =~ /[0-9]/ && $i < $len) {
        $i++ while $i < $len && peek() =~ /[0-9]/;
        if (peek() eq '~') { $i++; fail() unless peek() =~ /[0-9]/; $i++ while $i < $len && peek() =~ /[0-9]/ }
    } elsif ($c eq '$') { $i++ }
    elsif ($c eq '/' || $c eq '\\') {
        my $d = $c eq '\\' ? substr($s, $i + 1, 1) : '/';
        $i += $c eq '/' ? 1 : 2;
        delim($d); $i++ while peek() eq 'I' || peek() eq 'M';
    } else { return 0 }
    return 1;
}
while ($i < $len) {
    space();
    if (peek() eq ';' || peek() eq "\n") { $i++; next }
    if (peek() eq '#') {
        fail() if $i && substr($s, $i - 1, 1) ne "\n";
        $i++ while $i < $len && peek() ne "\n"; next;
    }
    if (peek() eq '}') { fail() unless $blocks; $blocks--; $i++; next }
    my $addr = address(); space();
    if (peek() eq ',') {
        fail() unless $addr; $i++; space();
        if (peek() eq '+' || peek() eq '~') {
            $i++; fail() unless peek() =~ /[0-9]/;
            $i++ while $i < $len && peek() =~ /[0-9]/;
        } else { fail() unless address() }
        space();
    }
    if (peek() eq '!') { fail() unless $addr; $i++; space() }
    fail() unless $i < $len;
    my $cmd = substr($s, $i++, 1);
    if ($cmd eq '{') { $blocks++; next }
    if ($cmd eq 's' || $cmd eq 'y') {
        my $d = substr($s, $i++, 1); delim($d); delim($d);
        if ($cmd eq 's') {
            $i++ while $i < $len && peek() =~ /[gpimIM0-9]/;
        }
    } elsif ($cmd =~ /^[rRwW]$/) {
        space(); my $file = '';
        while ($i < $len && peek() ne "\n") { $file .= substr($s, $i++, 1) }
        fail() unless $file =~ m{^[A-Za-z0-9._/@+\-]+$};
        push @actions, ($cmd =~ /^[rR]$/ ? 'r' : 'w') . "\t$file";
    } elsif ($cmd =~ /^[aic]$/) {
        space();
        my $text = substr($s, $i);
        fail() if $text =~ /[\\\n]/;
        $i = $len;
    } elsif ($cmd =~ /^[:btT]$/) {
        my $name = '';
        $name .= substr($s, $i++, 1) while $i < $len && peek() =~ /[A-Za-z0-9_.]/;
        fail() if $cmd eq ':' && $name eq '';
        fail() if peek() ne '' && peek() ne ';' && peek() ne "\n";
    } elsif ($cmd =~ /^[pPdDnNgGhHxl=qQz]$/) {
    } else { fail() }
    space(); fail() if peek() ne '' && peek() ne ';' && peek() ne "\n" && peek() ne '}';
}
fail() if $blocks;
print "$_\n" for @actions;
PERL
)" || { REASON='sed script cannot be certified'; return 0; }
    [[ -n "$actions" ]] || return 0
    while IFS= read -r line; do
        kind="${line%%$'\t'*}"; operand="${line#*$'\t'}"
        case "$kind" in
            r | w) case "$operand" in
                /dev/* | /proc/*) REASON='sed script targets a device or process file'; return 0 ;;
            esac ;;
        esac
        case "$kind" in
            r) if reader_operand "$operand"; then REASON='sed script reads a protected alias'; return 0; fi ;;
            w) if git_write_target "$operand"; then REASON='sed script writes git configuration'; return 0; fi ;;
            e) if [[ -z "$operand" ]]; then REASON='sed execution cannot be certified'; return 0; fi
                analyse "$operand" "$((depth + 1))" "$in_run" || return 1
                [[ -z "$REASON" ]] || return 0 ;;
            x) REASON='sed substitution execution cannot be certified'; return 0 ;;
            *) REASON='sed script cannot be certified'; return 0 ;;
        esac
    done <<<"$actions"
}

# awk_script: inspect literal read, write and system operands in awk code.
awk_script() {
    local script="$1" matched operand
    local pattern='(getline[[:space:]]*[^;]*<|print[[:space:]]*[^;]*>|system\()[[:space:]]*"([^"]+)"'
    while [[ "$script" =~ $pattern ]]; do
        matched="${BASH_REMATCH[0]:-}"; operand="${BASH_REMATCH[2]:-}"
        if reader_operand "$operand"; then REASON='awk script targets a protected alias'; return 0; fi
        if [[ "$matched" == *system* ]]; then
            analyse "$operand" "$((depth + 1))" "$in_run" || return 1
            [[ -z "$REASON" ]] || return 0
        fi
        [[ -n "$matched" ]] || break
        script="${script#*"$matched"}"
    done
}

# script_file: inspect a bounded regular script after resolving aliases.
script_file() {
    local script="" source="$2" kind="$1"
    if reader_operand "$source"; then REASON='script file targets a protected store'; return 0; fi
    script="$(perl -MTime::HiRes=alarm -e '
        alarm 0.2; my $p = shift; -f $p or exit 2;
        open my $f, "<", $p or exit 2;
        my $n = read $f, my $s, 8193;
        defined $n && $n <= 8192 && index($s, "\\0") == -1 or exit 2;
        print $s;
    ' "$(path "$source")" 2>/dev/null)" || {
        REASON='script file cannot be inspected safely'; return 0
    }
    if [[ "$kind" == sed ]]; then sed_script "$script"; elif [[ "$kind" == shell ]]; then :; else awk_script "$script"; fi
}

# Environment names whose indirect assignment can change reader semantics.
sensitive_assignment() {
    case "$1" in
        GIT_* | EDITOR | VISUAL | PAGER | LESS* | BASH_ENV | ENV | RIPGREP_CONFIG_PATH) return 0 ;;
    esac
    return 1
}

# analyse TEXT DEPTH: trace nested shell and secret run children, track simple
# Generic argument text is best effort; a malformed phrase is not a script.
argument_shell_text() {
    local code="$1" level="$2" inner P18_ARGUMENT_PROSE=1
    [[ "$code" == *[[:space:]]* || "$code" == *[';|&$`><(){}']* ]] || return 0
    case "$code" in --*=*) code="${code#*=}" ;; esac
    if [[ "$code" == source\ * || "$code" == .\ * || "$code" == '<'* ]] && raw_mentions_protected "$code"; then
        REASON='argument text reads a protected store'; return 0
    fi
    # Prose and SQL are not command names. Only a known executable or a
    # brace-expanded candidate can supply a positive finding here.
    case "$code" in
        *'{'* | *';'* | *'|'* | *'&'* | *'<'* | *'>'* | cp\ * | mv\ * | rsync\ * | source\ * | .\ * | cat\ * | sh\ * | bash\ * | python*\ * | node\ * | ruby\ * | perl\ * | git\ * | sed\ * | env\ * | printenv\ * | export\ * | set\ * | declare\ * | typeset\ * | compgen\ * | rg\ * | grep\ * | awk\ * | jq\ * | tee\ * | echo\ * | printf\ *) ;;
        *) return 0 ;;
    esac
    if [[ "$code" == *'{'* ]]; then
        local BRACES=()
        brace_expand "$code" || return 0
        for inner in "${BRACES[@]}"; do
            analyse "$inner" "$((level + 1))" || :
            [[ -z "$REASON" ]] || return 0
        done
    else
        analyse "$code" "$((level + 1))" || :
    fi
    return 0
}

# eval_preserves_shell TEXT: certify literal source without shell-state effects.
# Parse and inspect in a subshell so token arrays and child cwd tracking stay local.
eval_preserves_shell() (
    local text="$1" lines=() RAW_SEGMENTS=() TOKENS=() W=() line word name first
    # Expansions in the second parse are not literal eval source either.
    case "$text" in *'$'* | *'`'*) return 1 ;; esac
    tokenize "$text" || return 1
    for line in ${lines[@]+"${lines[@]}"}; do
        split_tokens "${line:2}"
        W=(${TOKENS[@]+"${TOKENS[@]}"})
        # Only command/builtin prefixes preserve the current shell's semantics.
        while [[ "${W[0]:-}" == command || "${W[0]:-}" == builtin ]]; do
            W=("${W[@]:1}")
            while [[ "${W[0]:-}" == -- || "${W[0]:-}" == -p ]]; do W=("${W[@]:1}"); done
        done
        first="$(lower "${W[0]:-}")"
        case "$first" in
            cd | pushd | popd | dirs | eval | source | . | exec | export | declare | typeset | local | read | mapfile | readarray | unset | set | shopt | trap | alias | unalias | enable | hash | shift | getopts | let | function | '(' | ')' | '{' | '}' | if | then | else | elif | fi | while | until | for | select | do | done | case | 'esac' | coproc | '!') return 1 ;;
            *=*) return 1 ;;
        esac
        for name in ${defined_function_names[@]+"${defined_function_names[@]}"}; do
            [[ "${W[0]:-}" != "$name" ]] || return 1
        done
        for word in ${W[@]+"${W[@]}"}; do
            # Definitions, arithmetic and indirect printf writes affect callers.
            case "$word" in '(' | ')' | '{' | '}' | "$ACTIVE"* ) return 1 ;; esac
            if [[ "$first" == printf && "$word" == -v* ]]; then return 1; fi
        done
    done
    analyse "$text" "$((depth + 1))" "$in_run" && [[ -z "$REASON" ]]
)

# Command slots have strict parsing and cannot be environment dumpers.
strict_command_slot() {
    local code="$1" level="$2" first_word="${1%%[[:space:];|&]*}"
    case "$first_word" in env | printenv | export | set | declare | typeset | compgen)
        REASON='command slot may dump the environment'; return 0 ;; esac
    if raw_text_protected "$code"; then
        REASON='command slot names a protected file or git configuration'; return 0
    else
        local status=$?
        if ((status != 1)); then REASON='command slot cannot be certified'; return 0; fi
    fi
    analyse "$code" "$((level + 1))" || {
        REASON='command slot cannot be certified'; return 0
    }
    return 0
}

# Inspect literal path operands embedded in interpreter code. These operands
# are not shell filenames, but can still address an independent Git directory.
inline_git_target() {
    local code="$1" match candidate pattern="[\"']([\$A-Za-z0-9_./-]+)[\"']"
    while [[ "$code" =~ $pattern ]]; do
        match="${BASH_REMATCH[0]}" candidate="${BASH_REMATCH[1]}"
        if [[ "$candidate" == '$'*/* ]]; then
            local name="${candidate%%/*}" suffix="${candidate#*/}" n
            name="${name#\$}"
            for ((n = 0; n < ${#WRITE_NAMES[@]}; n++)); do
                if [[ "$name" == "${WRITE_NAMES[n]}" ]]; then
                    candidate="${WRITE_VALUES[n]}/$suffix"; break
                fi
            done
        fi
        if [[ "$candidate" == */* ]] && git_write_target "$candidate"; then return 0; fi
        code="${code#*"$match"}"
    done
    return 1
}

# remember_cwd PATH: keep the bounded cwd union deduplicated across branches.
remember_cwd() {
    local known
    for known in ${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}; do
        [[ "$known" != "$1" ]] || return 0
    done
    ((${#UNCERTAIN_CWDS[@]} < 16)) || return 1
    UNCERTAIN_CWDS+=("$1")
}

# cd prefixes, and distinguish filters/options from filename operands.
analyse() {
    local text="$1" depth="$2" saved_cwd="$CWD" in_run="${3:-0}" next_first="" line i j first t prev pattern skip opts printer direct sub ignore_case token shell_code XARGS=0 hook_value
    local lines=() RAW_SEGMENTS=() W=() NEXT=() SUBSTITUTIONS=() TOKENS=() WRITE_NAMES=() WRITE_VALUES=() nested next_cwd="$CWD" sink=() stdout_redirect file_next sink_pos sink_ok indirect_env=0 option_name nameref=0 rg_pattern=0
    # Wrapper environment uncertainty follows nested shells, not later siblings.
    local search_config_inherited="${SEARCH_CONFIG_TRUST:-1}" SEARCH_CONFIG_TRUST="${SEARCH_CONFIG_TRUST:-1}"
    local UNCERTAIN_CWDS=(${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"}) PENDING_CWDS=()
    local SEARCH_NAMES_ONLY=0 SEARCH_GIT_SCOPE_SAFE=0 compound_depth=0 subshell_cwds=()
    local WORKSPACE_SCOPE_ACTIVE=0 WORKSPACE_ORIGINAL_CWDS=() NPM_SCRIPT_CHILD=0
    local function_pending=0 brace_level=0 function_cwds=() function_levels=() function_stack_names=() function_alternatives=() function_name=''
    local function_effect_names=() function_effect_targets=() function_call_names=() function_call_targets=()
    local defined_function_names=() defined_function_roots=()
    local KUBECONFIG="${KUBECONFIG:-}" CONTEXT_CREDENTIAL="$CONTEXT_CREDENTIAL" CONTEXT_CREDENTIAL_KEY="${CONTEXT_CREDENTIAL_KEY:-}"
    local GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-}" GIT_DIR="${GIT_DIR:-}" GIT_WORK_TREE="${GIT_WORK_TREE:-}" GIT_COMMAND_REPO_OVERRIDE="${GIT_COMMAND_REPO_OVERRIDE:-}"
    local GIT_INDEX_FILE="${GIT_INDEX_FILE:-}" GIT_COMMON_DIR="${GIT_COMMON_DIR:-}" GIT_ROOTS=()
    local GIT_OBJECT_DIRECTORY="${GIT_OBJECT_DIRECTORY:-}" GIT_ALTERNATE_OBJECT_DIRECTORIES="${GIT_ALTERNATE_OBJECT_DIRECTORIES:-}" GIT_NAMESPACE="${GIT_NAMESPACE:-}"
    # Grouping punctuation is not a command word or a statement fanout.
    if [[ "$text" =~ ^[\(\)\{\}\;[:space:]]*true[\(\)\{\}\;[:space:]]*$ ]]; then return 0; fi
    ((depth <= 4 && ${#text} <= 8192)) || { REASON='command exceeds analysis budget; split the command'; return 0; }
    # A deep quoted inline-shell chain must not escape the nesting cap on
    # Bash 3.2 when inner quote removal cannot be completed statically.
    if ((depth == 0)) && [[ "$text" == bash\ -c\ * || "$text" == sh\ -c\ * ]]; then
        local shell_launch='bash -c' reduced
        reduced="${text//$shell_launch/}"
        if (((${#text} - ${#reduced}) / ${#shell_launch} > 4)); then
            REASON='command exceeds analysis budget; split the command'; return 0
        fi
    fi
    # Bound statement fanout before the shell tokenizer scans each suffix.
    local separators="${text//[!;|]/}"
    ((${#separators} <= 128)) || { REASON='command exceeds analysis budget; split the command'; return 0; }
    within_budget || { REASON='command exceeds analysis budget; split the command'; return 0; }
    if ((depth)) && [[ "$text" == *case* && "$text" == *cd\ * ]] &&
        [[ "$text" =~ (^|[;[:space:]])(cat|paste|grep|awk|sed|head|tail)[[:space:]] ]]; then
        REASON='compound substitution has an uncertain reader scope'; return 0
    fi
    local active_command
    tokenize "$text" || {
        if [[ "${HEREDOC_MALFORMED:-0}" == 1 ]]; then
            REASON='heredoc delimiter is missing'
            return 0
        fi
        return 1
    }
    for ((i = 0; i < ${#lines[@]}; i++)); do
        within_budget || { REASON='command exceeds analysis budget; split the command'; return 0; }
        CWD="$next_cwd"
        if ((WORKSPACE_SCOPE_ACTIVE)); then
            UNCERTAIN_CWDS=(${WORKSPACE_ORIGINAL_CWDS[@]+"${WORKSPACE_ORIGINAL_CWDS[@]}"})
            WORKSPACE_SCOPE_ACTIVE=0
        fi
        if ((i > 0)) && [[ "${lines[i-1]:0:1}" != a ]]; then
            for t in ${PENDING_CWDS[@]+"${PENDING_CWDS[@]}"}; do
                remember_cwd "$t" || { REASON='working directory alternatives exceed analysis budget; split the command'; return 0; }
            done
            PENDING_CWDS=()
        fi
        SEARCH_CONFIG_TRUST="$search_config_inherited"
        SUBSTITUTIONS=()
        collect_substitutions "${RAW_SEGMENTS[i]}" || return 1
        for nested in ${SUBSTITUTIONS[@]+"${SUBSTITUTIONS[@]}"}; do
            analyse "$nested" "$((depth + 1))" "$in_run" || return 1
            [[ -z "$REASON" ]] || return 0
        done
        line="${lines[i]}"
        split_tokens "${line:2}"
        W=("${TOKENS[@]}")
        ANALYSIS_TOKENS=$((ANALYSIS_TOKENS + ${#W[@]}))
        if ((ANALYSIS_TOKENS > 256)); then
            REASON='command exceeds tokenizer limit'; return 0
        fi
        XARGS=0
        stdout_redirect=0
        NEXT=()
        skip=0
        local redirect_write=0
        for t in "${W[@]}"; do
            if ((skip)); then
                [[ "$t" != "$REDIR"* && "$t" != '<' ]] || return 1
                # shellcheck disable=SC2295  # fixed marker, not a glob
                t="${t//$ACTIVE/}"
                if [[ "$redirect_write" == 1 ]] && { git_write_target "$t" ||
                    [[ "$(lower "$t")" == *git/config* || "$(lower "$t")" == *.gitconfig* ]]; }; then
                    REASON='write targets git configuration'; return 0
                fi
                skip=0
                continue
            fi
            if [[ "$t" == '<<<' ]]; then
                # Literal here-string data is stdin, never a file operand.
                skip=1
                redirect_write=0
                continue
            fi
            if [[ "$t" == "$REDIR"* ]]; then
                redirect_write=0
                case "$t" in "$REDIR"*'>'*) redirect_write=1 ;; esac
                case "$t" in "$REDIR"'>'* | "$REDIR"'1>'* | "$REDIR"'&>'*) stdout_redirect=1 ;; esac
                skip=1
                continue
            fi
            NEXT+=("$t")
        done
        ((skip == 0)) || return 1
        W=("${NEXT[@]}")
        for t in "${W[@]}"; do
            if [[ "$t" =~ ^[A-Za-z_][A-Za-z_0-9]*= ]]; then
                WRITE_NAMES+=("${t%%=*}")
                WRITE_VALUES+=("${t#*=}")
            fi
            case "$t" in
                GIT_*+=* | LESS*+=* | EDITOR+=* | VISUAL+=* | PAGER+=* | BASH_ENV+=* | ENV+=* | RIPGREP_CONFIG_PATH+=*)
                    REASON='appended command environment cannot be certified'; return 0 ;;
            esac
            case "$t" in
                KUBECONFIG=*) KUBECONFIG="${t#*=}"; context_credentials ;;
                GIT_CONFIG_GLOBAL=*) GIT_CONFIG_GLOBAL="${t#*=}" ;;
                GIT_DIR=* | GIT_DIR+=*) GIT_DIR="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_WORK_TREE=* | GIT_WORK_TREE+=*) GIT_WORK_TREE="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_INDEX_FILE=* | GIT_INDEX_FILE+=*) GIT_INDEX_FILE="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_COMMON_DIR=* | GIT_COMMON_DIR+=*) GIT_COMMON_DIR="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_OBJECT_DIRECTORY=* | GIT_OBJECT_DIRECTORY+=*) GIT_OBJECT_DIRECTORY="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_ALTERNATE_OBJECT_DIRECTORIES=* | GIT_ALTERNATE_OBJECT_DIRECTORIES+=*) GIT_ALTERNATE_OBJECT_DIRECTORIES="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                GIT_NAMESPACE=* | GIT_NAMESPACE+=*) GIT_NAMESPACE="${t#*=}"; GIT_COMMAND_REPO_OVERRIDE=1 ;;
                LESS*=* | GIT_CONFIG_PARAMETERS=* | GIT_EXTERNAL_DIFF=* | GIT_EDITOR=* | GIT_SEQUENCE_EDITOR=* | GIT_PAGER=* | GIT_SSH*=* | GIT_ASKPASS=* | GIT_PROXY_COMMAND=* | GIT_EXEC_PATH=* | SSH_ASKPASS=* | EDITOR=* | VISUAL=* | PAGER=*)
                    git_command_assignment "$t"
                    [[ -z "$REASON" ]] || return 0 ;;
                BASH_ENV=* | ENV=* | PS4=* | PROMPT_COMMAND=* | SHELLOPTS=* | BASHOPTS=* | BASH_ENV+=* | ENV+=* | SHELLOPTS+=* | BASHOPTS+=*)
                    git_command_assignment "$t"
                    [[ -z "$REASON" ]] || return 0
                    hook_value="${t#*=}"
                    if [[ "$hook_value" == *'$'* || "$hook_value" == *'`'* || "$hook_value" == *$'\\'* || "$hook_value" == *' '* || "$hook_value" == *';'* || "$hook_value" == *'('* || "$hook_value" == *'"'* || "$hook_value" == *"'"* ]] ||
                        [[ "$hook_value" == *paste* || "$hook_value" == *cat* || "$hook_value" == *env* ]] ||
                        reader_operand "$hook_value" || raw_mentions_protected "$hook_value"; then
                        REASON='shell hook variable can read protected values'; return 0
                    fi ;;
            esac
        done
        for ((j = 0; j < ${#W[@]}; j++)); do
            case "${W[j]}" in
                --git-dir=* | --separate-git-dir=*) GIT_ROOTS+=("${W[j]#*=}") ;;
                --work-tree=*) GIT_ROOTS+=("${W[j]#*=}/.git") ;;
                --git-dir | --separate-git-dir | --work-tree)
                    ((j + 1 < ${#W[@]})) || return 1
                    if [[ "${W[j]}" == --work-tree ]]; then GIT_ROOTS+=("${W[j+1]}/.git")
                    else GIT_ROOTS+=("${W[j+1]}"); fi
                    j=$((j + 1)) ;;
            esac
        done
        # export and declare assignments are not prefix words, but still
        # affect later commands in the same tool request.
        case "${W[0]:-}" in
            export | declare | typeset)
                for t in "${W[@]:1}"; do
                    case "$t" in
                        GIT_DIR=* | GIT_WORK_TREE=* | GIT_INDEX_FILE=* | GIT_COMMON_DIR=* | \
                            GIT_OBJECT_DIRECTORY=* | GIT_ALTERNATE_OBJECT_DIRECTORIES=* | GIT_NAMESPACE=*) GIT_COMMAND_REPO_OVERRIDE=1 ;;
                    esac
                    case "$t" in *=*) git_command_assignment "$t"; [[ -z "$REASON" ]] || return 0 ;; esac
                done ;;
        esac
        # Launchers can consume piped or redirected shell text even with options.
        case "${W[0]:-}" in
            run0 | pkexec | su | runuser | machinectl | doas | sudo | script | expect | systemd-run)
                if [[ "${line:0:1}" == p || ( $i -gt 0 && "${lines[i-1]:0:1}" == p ) || "${RAW_SEGMENTS[i]}" == *'<'* ]]; then
                    REASON='launcher stdin cannot be certified'; return 0
                fi ;;
        esac
        if { [[ "${W[0]##*/}" == machinectl && " ${W[*]} " == *' shell '* ]] ||
            [[ "${W[0]##*/}" == systemd-run && ( " ${W[*]} " == *' -S '* || " ${W[*]} " == *' --shell '* ) ]]; }; then
            REASON='machinectl shell cannot be certified'; return 0
        fi
        # Check interactive launchers before unwrap discards their options.
        case "${W[0]##*/}" in
            run0 | pkexec | su | runuser | machinectl)
                if ((${#W[@]} == 1)) || [[ "${W[1]:-}" == '<<<' || "${W[1]:-}" == '<' ]]; then
                    REASON='interactive launcher cannot be certified'; return 0
                fi ;;
        esac
        case "${W[0]##*/}" in
            sudo | doas | run0)
                for t in "${W[@]:1}"; do
                    case "$t" in --) break ;; -[!-]*)
                        if [[ "$t" == -*s* || "$t" == -*i* ]]; then
                            REASON='interactive launcher cannot be certified'; return 0
                        fi ;;
                    esac
                done ;;
            script)
                if [[ " ${W[*]} " != *' -c '* && " ${W[*]} " != *' -qc '* && " ${W[*]} " != *' -cq '* ]]; then
                    REASON='script default shell cannot be certified'; return 0
                fi ;;
            expect)
                case " ${W[*]} " in *' -f /dev/stdin '* | *' -f - '*) REASON='expect stdin cannot be certified'; return 0 ;; esac
                if [[ " ${W[*]} " != *' -c '* ]]; then REASON='expect default shell cannot be certified'; return 0; fi ;;
            pkexec | runuser | su | machinectl)
                if ((${#W[@]} == 1)); then REASON='interactive launcher cannot be certified'; return 0; fi ;;
        esac
        local xargs_input=0
        if [[ "${RAW_SEGMENTS[i]}" == *'<'* || " ${W[*]} " == *' -a '* || " ${W[*]} " == *' --arg-file '* ||
            " ${W[*]} " == *' --arg-file='* ]]; then xargs_input=1; fi
        NPM_SCRIPT_CHILD=0
        local cd_uncertain=0 function_start=0
        # Function declarations are analysed conservatively, but their private
        # directory changes must not become the outer statement's cwd.
        if [[ "${W[0]:-}" == function ]]; then
            function_pending=1; function_name="${W[1]:-}"; function_start=2
        elif [[ "${W[1]:-}" == '(' ]]; then
            function_pending=1; function_name="${W[0]}"; function_start=1
        fi
        # Only leading grouping words are syntax here. Braces passed to a
        # command such as printf are data, not function-scope boundaries.
        for ((j = function_start; j < ${#W[@]}; j++)); do
            t="${W[j]}"
            case "$t" in
                '{')
                    brace_level=$((brace_level + 1))
                    if ((function_pending)); then
                        function_cwds+=("$CWD"); function_levels+=("$brace_level")
                        function_stack_names+=("$function_name")
                        function_alternatives+=("${#UNCERTAIN_CWDS[@]}")
                        function_pending=0
                    fi ;;
                '}')
                    if ((${#function_levels[@]})) && [[ "${function_levels[${#function_levels[@]}-1]}" == "$brace_level" ]]; then
                        defined_function_names+=("${function_stack_names[${#function_stack_names[@]}-1]}")
                        CWD="${function_cwds[${#function_cwds[@]}-1]}"
                        defined_function_roots+=("$CWD")
                        next_cwd="$CWD"
                        local saved_alternatives="${function_alternatives[${#function_alternatives[@]}-1]}"
                        if ((saved_alternatives)); then UNCERTAIN_CWDS=("${UNCERTAIN_CWDS[@]:0:saved_alternatives}")
                        else UNCERTAIN_CWDS=(); fi
                        PENDING_CWDS=()
                        unset 'function_cwds[${#function_cwds[@]}-1]' 'function_levels[${#function_levels[@]}-1]' 'function_stack_names[${#function_stack_names[@]}-1]' 'function_alternatives[${#function_alternatives[@]}-1]'
                    fi
                    ((brace_level == 0)) || brace_level=$((brace_level - 1)) ;;
                '(' | ')' | then | else | do | '!') ;;
                *) break ;;
            esac
        done
        # Parenthesized commands have a private cwd. Closing punctuation is a
        # separate tokenizer segment, so restore before analysing its successor.
        while [[ "${W[0]:-}" == '(' || "${W[0]:-}" == ')' ]]; do
            if [[ "${W[0]}" == '(' ]]; then subshell_cwds+=("$CWD")
            else
                # A function signature also emits ')', without a subshell.
                if ((${#subshell_cwds[@]})); then
                    CWD="${subshell_cwds[${#subshell_cwds[@]}-1]}"
                    next_cwd="$CWD"
                    unset 'subshell_cwds[${#subshell_cwds[@]}-1]'
                fi
            fi
            W=("${W[@]:1}")
        done
        case "${W[0]:-}" in
            if | while | until | for | select | case) compound_depth=$((compound_depth + 1)) ;;
            fi | done | 'esac') ((compound_depth == 0)) || compound_depth=$((compound_depth - 1)) ;;
        esac
        ((compound_depth == 0)) || cd_uncertain=1
        case "${W[0]:-}" in '!' | then | elif | else | do) cd_uncertain=1 ;; esac
        unwrap || return 1
        [[ -z "$REASON" ]] || return 0
        ((${#W[@]})) || continue
        active_command=0
        local active_eval=0
        [[ "${W[0]}" != *"$ACTIVE"* ]] || active_command=1
        for ((j = 0; j < ${#W[@]}; j++)); do
            [[ "${W[j]}" != *"$ACTIVE"* ]] || active_eval=1
            # shellcheck disable=SC2295  # fixed marker, safe on Bash 3.2
            W[j]="${W[j]//$ACTIVE/}"
        done
        if ((active_command)) && raw_mentions_protected "$CMD"; then
            REASON='unresolved command names protected access'
            return 0
        fi
        first="$(lower "${W[0]##*/}")"
        # Record every cwd-changing body command, not only its final cwd.
        # Calls form a bounded graph so indirect/conditional changes reach the
        # eventual call site. Declarations themselves never move their caller.
        if ((${#function_stack_names[@]})); then
            local effect='' owner target_index=1
            case "$first" in
                cd | pushd)
                    while [[ "${W[target_index]:-}" == -* ]]; do
                        [[ "${W[target_index]}" != -- ]] || { target_index=$((target_index + 1)); break; }
                        target_index=$((target_index + 1))
                    done
                    effect="${W[target_index]:-}"
                    case "$effect" in '' | - | +[0-9]* | -[0-9]* | *'$'* | *'`'*) effect=/proc/self/cwd ;;
                        *) effect="$(path "$effect" 1)" ;;
                    esac
                    # A conditional/dynamic change and stack operations do not
                    # establish a single final cwd for the function's caller.
                    if [[ "$first" == pushd ]] || ((cd_uncertain)) ||
                        [[ "${line:0:1}" == a || "${line:0:1}" == o ]] ||
                        { ((i > 0)) && [[ "${lines[i-1]:0:1}" == a || "${lines[i-1]:0:1}" == o ]]; }; then
                        effect=/proc/self/cwd
                    fi ;;
                popd) effect=/proc/self/cwd ;;
            esac
            for owner in "${function_stack_names[@]}"; do
                if [[ -n "$effect" ]]; then
                    function_effect_names+=("$owner"); function_effect_targets+=("$effect")
                else
                    function_call_names+=("$owner"); function_call_targets+=("${W[0]}")
                fi
            done
        fi
        for ((j = 0; j < ${#defined_function_names[@]}; j++)); do
            [[ "${W[0]}" == "${defined_function_names[j]}" ]] || continue
            local calls=("${W[0]}") visited='' call_index=0 effect_index changed=0 unknown_effect=0
            while ((call_index < ${#calls[@]})); do
                ((${#calls[@]} <= 32)) || { REASON='function directory scope cannot be certified'; return 1; }
                local called="${calls[call_index]}"
                call_index=$((call_index + 1))
                case "$visited" in *"$US$called$US"*) continue ;; esac
                visited+="$US$called$US"
                for ((effect_index = 0; effect_index < ${#function_effect_names[@]}; effect_index++)); do
                    [[ "${function_effect_names[effect_index]}" == "$called" ]] || continue
                    remember_cwd "${function_effect_targets[effect_index]}" || { REASON='function directory scope cannot be certified'; return 1; }
                    changed=$((changed + 1))
                    if [[ "$called" != "${W[0]}" || "$CWD" != "${defined_function_roots[j]}" ]]; then unknown_effect=1; fi
                done
                for ((effect_index = 0; effect_index < ${#function_call_names[@]}; effect_index++)); do
                    [[ "${function_call_names[effect_index]}" != "$called" ]] || calls+=("${function_call_targets[effect_index]}")
                done
            done
            # Only one unconditional literal cd at its definition cwd has a
            # precise target. Multiple/indirect changes also retain unknown cwd.
            if ((changed > 1 || unknown_effect)); then remember_cwd /proc/self/cwd || { REASON='function directory scope cannot be certified'; return 1; }; fi
            break
        done
        # Numbered and restricted shell executables have the same input roles.
        case "$first" in
            bash[0-9]* | bash-[0-9]* | sh[0-9]* | sh-[0-9]*)
                first="${first%%[0-9]*}"; first="${first%-}" ;;
            ksh[0-9]*) first=ksh ;;
            rbash) first=bash ;;
            csh | tcsh) first='sh' ;;
        esac
        if [[ "$first" == coproc ]]; then
            W=("${W[@]:1}")
            if [[ "${W[1]:-}" == '{' ]]; then W=("${W[@]:2}"); fi
            if [[ "${W[0]:-}" == '{' ]]; then W=("${W[@]:1}"); fi
            ((${#W[@]})) || return 1
            unwrap || return 1
            [[ -z "$REASON" ]] || return 0
            ((${#W[@]})) || return 1
            first="$(lower "${W[0]##*/}")"
        fi
        case "$first" in
            rbash) first=bash ;;
            bash[0-9._-]* | sh[0-9._-]* | ksh[0-9._-]* | zsh[0-9._-]* | dash[0-9._-]*)
                first="${first%%[0-9._-]*}" ;;
        esac
        # Dashed Git built-ins dispatch through Git even when called directly.
        if [[ "$first" == git-?* ]]; then
            case "${W[0]}" in
                git-* | */git-core/git-*)
                    [[ "$CMD" != *PATH=* ]] || { REASON='git executable dispatch is indeterminate'; return 0; }
                    for token in "${W[@]:1}"; do
                        if reader_operand "$token"; then REASON='git executable operand targets a protected store'; return 0; fi
                    done
                    W=(git "${first#git-}" "${W[@]:1}")
                    first=git ;;
            esac
        fi
        # P18 examines arguments only when no command model classifies them.
        case "$first" in
            git | secret | cat | head | tail | less | more | ls | stat | file | wc | grep | egrep | fgrep | rg | ack | ack-grep | diff | cmp | find | jq | sed | perl | awk | gawk | echo | printf | bash | sh | zsh | ksh | mksh | dash | ash | yash | posh | hush | msh | fish | python* | node | nodejs | deno | bun | ruby | php | lua | npm | npx | go | make | docker | dotenv | dotenvx | fd | fdfind | timeout | xargs | export | set | cd | pushd | popd | dirs | tee | cp | mv | ln | install | rsync | dd | touch | truncate | tar | bsdtar | unzip | funzip | 7z | 7za | 7zr | cpio | patch | curl | true | false | test | '[' | '[[' | source | . | env | sudo | doas | run0 | pkexec | su | runuser | machinectl | systemd-run | script | expect | gh | kubectl | aws | gcloud | az | heroku | vault | doctl | glab | direnv | helm | op | pass | security | ps | command | builtin | exec | chmod | chown | rm | mkdir | keyring | secret-tool | compgen | declare | typeset | shopt | split | openssl | zip | scp | du | realpath | readlink | basename | dirname | chgrp | printenv | envsubst | pbpaste | wl-paste | xclip | xsel | kwallet-query | gpg | sops | bat | ag | xxd | od | hexdump | strings | cut | sort | uniq | base64 | yq | tr | nl | tac | rev | vim | vi | nvim | nano | emacs | git-*) ;;
            *)
                if [[ "${P18_ARGUMENT_PROSE:-0}" != 1 ]]; then
                    if raw_text_protected "${RAW_SEGMENTS[i]}"; then
                        REASON='unknown command argument names a protected file or git configuration'; return 0
                    else
                        skip=$?
                        if ((skip != 1)); then REASON='unknown command arguments cannot be certified'; return 0; fi
                    fi
                fi ;;
        esac
        [[ "$first" != gmake ]] || first="make"
        # Process substitutions are not regular Makefiles.
        if [[ "$first" == make && "${RAW_SEGMENTS[i]}" == *'-f<('* ]]; then
            REASON='make reads an uncertain file'; return 0
        fi
        # Command slots are shell source, including options following operands.
        case "$first" in
            flock | su | runuser | expect | npm | npx | make | rsync)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    t="${W[j]}"; shell_code=''
                    case "$first:$t" in
                        flock:-c | flock:--command | su:-c | runuser:-c | expect:-c | rsync:-e | rsync:--rsh | npm:-c | npx:-c)
                            if [[ "$first" == npm && " ${W[*]} " != *' exec '* && " ${W[*]} " != *' x '* ]]; then continue; fi
                            ((j + 1 < ${#W[@]})) || return 1
                            shell_code="${W[j+1]}"; j=$((j + 1)) ;;
                        flock:-c?* | su:-c?* | runuser:-c?* | expect:-c?* | rsync:-e?* | flock:--command=* | flock:--comm=* | flock:--co=* | runuser:--command=* | runuser:--comm=* | runuser:--co=* | rsync:--rsh=*)
                            if [[ "$t" == --*=* ]]; then shell_code="${t#*=}"; else shell_code="${t:2}"; fi ;;
                        rsync:-[a-zA-Z]*e*)
                            shell_code="${t#-}"; shell_code="${shell_code#*e}"
                            if [[ -z "$shell_code" ]]; then
                                ((j + 1 < ${#W[@]})) || return 1
                                shell_code="${W[j+1]}"; j=$((j + 1))
                            fi ;;
                        npm:--call | npx:--call)
                            ((j + 1 < ${#W[@]})) || return 1
                            shell_code="${W[j+1]}"; j=$((j + 1)) ;;
                        npm:-c?* | npx:-c?* | npm:--call=* | npx:--call=*)
                            if [[ "$t" == --*=* ]]; then shell_code="${t#*=}"; else shell_code="${t:2}"; fi ;;
                        make:-E | make:-E?* | make:--eval | make:--eval=* | make:--e | make:--e=* | make:--ev | make:--ev=* | make:--eva | make:--eva=*)
                            REASON='make eval cannot be certified'; return 0 ;;
                        make:-f | make:--file | make:--makefile | make:-[a-zA-Z]*f)
                            ((j + 1 < ${#W[@]})) || return 1
                            t="${W[j+1]}"
                            if [[ "$t" == - || "$t" == /dev/* || "$t" == *'<('* || "$t" == *'>('* || ( -e "$t" && ! -f "$t" ) ]]; then
                                REASON='make reads an uncertain file'; return 0
                            fi ;;
                        make:-[a-zA-Z]*f/dev/* | make:-[a-zA-Z]*f- | make:-f/dev/* | make:--file=/dev/* | make:--makefile=/dev/* | make:-f*'<('* | make:-f*'>('* | make:-f- | make:--file=- | make:--makefile=-)
                            REASON='make reads an uncertain file'; return 0 ;;
                    esac
                    # shellcheck disable=SC2016  # these are literal Make syntax markers
                    if [[ "$first" == make && "$t" == *=* && "$t" != -* && ( "$t" == *'$('* || "$t" == *'${'* || "$t" == *'`'* ) ]]; then
                        REASON='make assignment can execute shell code'; return 0
                    fi
                    if [[ -n "$shell_code" ]]; then
                        strict_command_slot "$shell_code" "$depth"
                        [[ -z "$REASON" ]] || return 0
                    fi
                done ;;
            watch | tmux | screen | ssh)
                j=1
                while ((j < ${#W[@]})) && [[ "${W[j]}" == -* ]]; do j=$((j + 1)); done
                [[ "$first" != ssh ]] || j=$((j + 1))
                if ((j < ${#W[@]})); then
                    text="${W[j]}"
                    for t in "${W[@]:j+1}"; do text+=" $t"; done
                    strict_command_slot "$text" "$depth"
                    [[ -z "$REASON" ]] || return 0
                fi ;;
            op)
                if [[ "${W[1]:-}" == run ]]; then
                    for ((j = 2; j < ${#W[@]}; j++)); do
                        if [[ "${W[j]}" == -- ]]; then
                            text="${W[j+1]:-}"
                            for t in "${W[@]:j+2}"; do text+=" $t"; done
                            strict_command_slot "$text" "$depth"
                            [[ -z "$REASON" ]] || return 0
                            break
                        fi
                    done
                fi ;;
            gh)
                if [[ "${W[1]:-}" == alias && "${W[2]:-}" == set ]]; then
                    for t in "${W[@]:3}"; do
                        if [[ "$t" == --shell ]]; then REASON='shell alias cannot be certified'; return 0; fi
                        case "$t" in '!'*) strict_command_slot "${t:1}" "$depth"; [[ -z "$REASON" ]] || return 0 ;; esac
                    done
                fi ;;
        esac
        # Generic shell text is best effort even for printer-model commands.
        rg_pattern=0
        case "$first" in
            bash | sh | zsh | ksh | mksh | dash | ash | yash | posh | hush | msh | fish | git | sed | find | xargs | env | sudo | doas | run0 | pkexec | time | nice | nohup | timeout | command | exec | builtin | echo | printf | secret) ;;
            *)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    token="${W[j]}"
                    if [[ "$first" == gh ]]; then
                        case "${W[j-1]}" in --title | --body) continue ;; esac
                        case "$token" in --title=* | --body=*) continue ;; esac
                    fi
                    if [[ "$first" == rg || "$first" == grep || "$first" == egrep || "$first" == fgrep || "$first" == ack || "$first" == ack-grep ]]; then
                        case "${W[j-1]}" in -e | --regexp) continue ;; esac
                        if [[ "$token" != -* && "$rg_pattern" == 0 ]]; then
                            rg_pattern=1
                            continue
                        fi
                    fi
                    argument_shell_text "$token" "$depth"
                    [[ -z "$REASON" ]] || return 0
                done ;;
        esac
        # Unknown wrappers may pass a command as argv or as a shell-text
        # argument. Check both without executing the wrapper or evaluating text.
        case "$first" in
            su)
                if [[ " ${W[*]} " != *' -c '* ]]; then
                    REASON='su default shell cannot be certified'; return 0
                fi ;;
        esac
        case "$first" in
            git | secret | cat | head | tail | less | more | ls | stat | file | wc | grep | rg | ack | ack-grep | diff | cmp | find | jq | sed | perl | awk | gawk | echo | printf | bash | sh | zsh | ksh | mksh | dash | ash | yash | posh | hush | msh | fish | python* | node | nodejs | ruby | php | npm | go | make | docker | dotenv | dotenvx | fd | fdfind | timeout | xargs | export | set | cd | pushd | popd | dirs | tee | cp | mv | ln | install | rsync | dd | touch | truncate | tar | bsdtar | unzip | patch | git-* | curl | true | false | test | '[' | '[[' | source | . | env | sudo | script | gh | kubectl | aws | gcloud | az | heroku | vault | doctl | glab | direnv | helm | op | pass | security | ps | command | builtin | exec | chmod | chown | rm | mkdir | jest | vitest | pytest | vercel) ;;
            *)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    token="${W[j]}"
                    if [[ "${W[j-1]:-}" == --cmd ]]; then
                        case "$token" in env | printenv | export | set | declare | typeset | compgen)
                            REASON='command slot may dump the environment'; return 0 ;; esac
                    fi
                    # A script's later data operand is not a new command word.
                    if ((NPM_SCRIPT_CHILD)) && [[ "$token" == env || "$token" == printenv ]]; then continue; fi
                    case " $(lower "${token##*/}") " in
                        ' bash ' | ' sh ' | ' cat ' | ' sed ' | ' perl ' | ' git ' | ' rg ' | ' echo ' | ' printf ' | ' python3 ' | ' node ' | ' jq ' | ' tee ' | ' touch ' | ' mkdir ' | ' tar ' | ' unzip ' | ' patch ' | ' rbash ' | ' ksh93 ' | ' csh ' | ' tcsh ' | ' bash5 ' | ' sh5 ' | ' bash-5.2 ' | ' env ' | ' printenv ' | ' head ' | ' tail ' | ' less ' | ' more ' | ' grep ' | ' diff ' | ' cmp ' | ' find ' | ' awk ' | ' gawk ' | ' ruby ' | ' php ' | ' xxd ' | ' base64 ' | ' sort ' | ' wc ' | ' git-config ' | ' git-show ' | ' python ' | ' python2 ' | ' zsh ' | ' dash ' | ' fish ' | ' ksh ' | ' busybox ' | ' toybox ' | ' ps ' | ' chmod ' | ' cp ' | ' mv ' | ' ln ' | ' install ' | ' rsync ' | ' dd ' | ' truncate ' | ' vim ' | ' nano ' | ' op ' | ' pass ' | ' keyring ' | ' secret-tool ' | ' security ' | ' gh ' | ' gcloud ' | ' aws ' | ' az ' | ' heroku ' | ' vault ' | ' doctl ' | ' glab ' | ' direnv ' | ' docker ' | ' npm ' | ' go ' | ' make ' | ' xargs ' | ' timeout ')
                            text=''
                            for t in "${W[@]:j}"; do text+=" '${t//\'/\'\\\'\'}'"; done
                            analyse "$text" "$((depth + 1))" "$in_run" || return 1
                            [[ -z "$REASON" ]] || return 0
                            break ;;
                    esac
                done ;;
        esac
        # Non-readers cannot name protected Git tokens anywhere in argv,
        # including attached options and inline interpreter code.
        local readonly_git=0
        case "$first" in
            git | cat | head | tail | less | more | ls | stat | file | wc | grep | rg | ack | ack-grep | diff | cmp) readonly_git=1 ;;
            jq)
                readonly_git=1
                for token in "${W[@]:1}"; do case "$token" in -i | -i?* | --in-place*) readonly_git=0 ;; esac; done ;;
            find)
                readonly_git=1
                for token in "${W[@]:1}"; do
                    case "$token" in
                        -name | -iname | -path | -ipath | -regex | -iregex | -type | -maxdepth | -mindepth | -newer | -mtime | -mmin | -atime | -amin | -ctime | -cmin | -size | -empty | -perm | -user | -group | -uid | -gid | -links | -inum | -samefile | -readable | -writable | -executable | -print | -print0 | -printf | -prune | -quit | -not | '!' | -o | -a | -or | -and | '(' | ')' | -true | -false | -depth | -xdev | -mount | -follow | -L | -P | -H) ;;
                        -*) readonly_git=0 ;;
                    esac
                done ;;
        esac
        if ((readonly_git == 0)); then
            case "$first" in
                cd | pushd | popd | dirs | true | false | test | '[' | '[[') ;;
                *) if gitdir_cwd; then REASON='command runs inside git directory'; return 0; fi ;;
            esac
            for token in "${W[@]:1}"; do
                # Printer arguments are inert data; redirection targets were
                # already checked independently above.
                if [[ "$first" == echo || "$first" == printf ]]; then continue; fi
                pattern='\.git($|[^a-zA-Z0-9_-])|\.gitmodules|\.gitconfig|git/config'
                if [[ "$first" == cd && "$token" == *.git ]]; then continue; fi
                if [[ "$(lower "$token")" =~ $pattern ]]; then
                    REASON='command argument names git configuration'; return 0
                fi
                # Literal roots cover separate gitdirs; unknown argv globs are
                # not resolved as write destinations.
                # Also inspect attached short-option operands (-Cbare) and
                # bare directory names that identify independent gitdirs.
                local candidate_word
                for candidate_word in "$token" "${token#*=}"; do
                    [[ "$candidate_word" != "$token" || "$token" != *=* ]] || continue
                    case "$candidate_word" in -* | *'*'* | *'?'* | *'['* | *'$'* | *'`'*) continue ;; esac
                    # A non-path argument cannot enter an independent gitdir
                    # unless it already names a directory or a declared root.
                    if [[ "$candidate_word" != */* && "$candidate_word" != '~'* &&
                        ! -e "$CWD/$candidate_word" && -z "${GIT_ROOTS[0]:-}" ]]; then continue; fi
                    if ! within_budget; then REASON='command exceeds analysis budget; split the command'; return 0; fi
                    if git_write_target "$candidate_word"; then REASON='command targets git configuration'; return 0; fi
                done
                if [[ "$token" == -[!-]* && "$token" != *=* ]]; then
                    for ((j = 2; j < ${#token}; j++)); do
                        t="${token:j}"
                        case "$t" in *'*'* | *'?'* | *'['* | *'$'* | *'`'*) continue ;; esac
                        if git_write_target "$t"; then REASON='command targets git configuration'; return 0; fi
                    done
                fi
            done
        fi
        # Names in W have already had shell quotes and concatenation removed.
        # Indirect writes can alter shell/Git/search settings in later statements.
        if ((indirect_env)); then
            case "$first" in
                printf | declare | typeset | local | read | mapfile | readarray | export | eval | : | true | false | echo) ;;
                *) REASON='indirect environment assignment cannot be certified'; return 0 ;;
            esac
        fi
        if [[ "$first" == source || "$first" == . ]]; then
            for t in "${W[@]:1}"; do
                case "$t" in /dev/stdin | /dev/fd/* | /proc/*/fd/*)
                    REASON='source of process input cannot be certified'; return 0 ;; esac
            done
        fi
        case "$first" in
            vi | vim | nvim | nano | emacs | emacsclient | code | codium | subl | mate | hx | kak | micro | ex)
                for t in "${W[@]:1}"; do
                    [[ "$t" == -* || "$t" == +* ]] && continue
                    if git_write_target "$t"; then REASON='editor targets git configuration'; return 0; fi
                done ;;
        esac
        # Here-documents fed to interpreters are code, not inert data.
        case "$first" in
            python* | node | nodejs | perl | ruby | php | lua | deno | bun | rscript)
                if [[ "${RAW_SEGMENTS[i]}" == *'<<'* || "${RAW_SEGMENTS[i]}" == *'<<<'* ]]; then
                    if inline_git_target "$CMD"; then
                        REASON='interpreter stdin targets git configuration'; return 0
                    fi
                    local script_token='\.env|\.netrc|\.npmrc|\.pypirc|\.git-credentials|\.aws/credentials|\.docker/config\.json|\.config/gh/hosts\.yml|\.ssh/id_|\.git($|[^a-zA-Z0-9_-])|\.gitconfig|\.gitmodules|\.secret'
                    if [[ "$CMD" =~ $script_token ]]; then
                        REASON='interpreter stdin names a protected path'; return 0
                    fi
                fi
                local inline_path='\.\./[a-zA-Z0-9._/-]+'
                if [[ "${RAW_SEGMENTS[i]}" =~ $inline_path ]] && git_write_target "${BASH_REMATCH[0]}"; then
                    REASON='inline code targets git configuration'; return 0
                fi ;;
        esac
        case "$first" in
            printf)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    if [[ "${W[j]}" == -v ]]; then
                        option_name="${W[j+1]:-}"
                        if [[ ! "$option_name" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] || sensitive_assignment "$option_name"; then indirect_env=1; fi
                        break
                    fi
                done ;;
            declare | typeset | local)
                nameref=0
                for ((j = 1; j < ${#W[@]}; j++)); do
                    case "${W[j]}" in -n | -?*n*) nameref=1 ;; esac
                done
                for ((j = 1; j < ${#W[@]}; j++)); do
                    option_name="${W[j]}"
                    [[ "$option_name" == -* ]] && continue
                    if [[ "$option_name" == *'$'* || "$option_name" == *'`'* ]]; then indirect_env=1; fi
                    if ((nameref)); then
                        if [[ "$option_name" != *=* ]] || sensitive_assignment "${option_name#*=}"; then indirect_env=1; fi
                    fi
                done ;;
            read | mapfile | readarray)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    option_name="${W[j]}"
                    [[ "$option_name" == -* ]] && continue
                    if [[ ! "$option_name" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] || sensitive_assignment "$option_name"; then indirect_env=1; fi
                done ;;
            export)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    option_name="${W[j]%%=*}"
                    [[ "$option_name" =~ ^[A-Za-z_][A-Za-z_0-9]*$ ]] || indirect_env=1
                done ;;
            eval)
                shell_code=''
                for t in "${W[@]:1}"; do
                    [[ -n "$shell_code" || "$t" != -- ]] || continue
                    shell_code+="${shell_code:+ }$t"
                done
                if ((active_eval)) || ! eval_preserves_shell "$shell_code"; then
                    REASON='eval shell effects cannot be certified'; return 0
                fi ;;
        esac
        direct=0
        if [[ "${line:0:1}" == p ]] && ((i + 1 < ${#lines[@]})); then
            split_tokens "${lines[i + 1]:2}"
            NEXT=("${TOKENS[@]}")
            next_first="${NEXT[0]##*/}"
            sink=()
            skip=0
            for t in "${NEXT[@]}"; do
                if ((skip)); then skip=0; continue; fi
                if [[ "$t" == "$REDIR"* || "$t" == '<' ]]; then skip=1; continue; fi
                sink+=("$t")
            done
            if ((skip == 0 && ${#sink[@]} >= 4)) && [[ "$next_first" == secret && "${sink[1]}" == stash ]]; then
                sink_pos=2
                sink_ok=1
                while ((sink_pos < ${#sink[@]} - 2)); do
                    case "${sink[sink_pos]}" in
                        --env | --label)
                            ((sink_pos + 1 < ${#sink[@]} - 2)) || { sink_ok=0; break; }
                            if [[ "${sink[sink_pos]}" == --env ]]; then
                                [[ "${sink[sink_pos + 1]}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || sink_ok=0
                            else
                                [[ "${sink[sink_pos + 1]}" =~ ^[A-Za-z_][A-Za-z0-9_]*=[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || sink_ok=0
                            fi
                            sink_pos=$((sink_pos + 2)) ;;
                        --env=*)
                            [[ "${sink[sink_pos]#--env=}" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || sink_ok=0
                            sink_pos=$((sink_pos + 1)) ;;
                        --label=*)
                            [[ "${sink[sink_pos]#--label=}" =~ ^[A-Za-z_][A-Za-z0-9_]*=[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || sink_ok=0
                            sink_pos=$((sink_pos + 1)) ;;
                        *) sink_ok=0; break ;;
                    esac
                done
                ((sink_ok && sink_pos == ${#sink[@]} - 2)) && direct=1
            elif [[ ( "$next_first" == docker && "${sink[1]:-}" == login ) ||
                ( "$next_first" == helm && "${sink[1]:-}" == registry && "${sink[2]:-}" == login ) ]]; then
                for t in "${sink[@]:1}"; do [[ "$t" != --password-stdin ]] || direct=1; done
            fi
        fi
        ((stdout_redirect == 0)) || direct=0
        if ((XARGS)) && [[ " ls stat chmod chown rm rmdir touch mkdir test true false basename dirname realpath readlink file " != *" $first "* ]]; then
            if ((xargs_input)); then REASON='xargs reader consumes uncertain stdin'; return 0; fi
            if ((i > 0)) && [[ "${lines[i-1]:0:1}" == p ]]; then
                split_tokens "${lines[i-1]:2}"
                if ! listing_producer_safe "${TOKENS[@]}"; then
                    REASON='xargs reader consumes an uncertain producer scope'; return 0
                fi
            fi
            # Trace listing tokens only through the contiguous input pipeline.
            # Patterns from find/echo need protection even without an existing file.
            for ((j = i - 1; j >= 0; j--)); do
                [[ "${lines[j]:0:1}" == p ]] || break
                split_tokens "${lines[j]:2}"
                NEXT=("${TOKENS[@]}")
                case "${NEXT[0]##*/}" in
                    find | fd | fdfind | ls | git | rg)
                        if listing_producer_safe "${NEXT[@]}"; then continue
                        else REASON='xargs reader consumes an uncertain producer scope'; return 0; fi ;;
                esac
                for token in "${NEXT[@]}"; do
                    if reader_operand "$token" "${RAW_SEGMENTS[j]}" || protected_selector "$token"; then
                        REASON='xargs reader consumes a protected-name listing'
                        return 0
                    fi
                done
            done
        fi
        prev=""
        for t in "${W[@]}"; do
            if [[ "$prev" == '<' ]] && reader_operand "$t"; then
                REASON='input redirect reads a protected store'
                return 0
            fi
            prev="$t"
        done
        case "$first" in
            patch) REASON='patch targets cannot be certified'; return 0 ;;
            apply_patch)
                if [[ "${RAW_SEGMENTS[i]}" == *'<<'* ]]; then
                    if patch_secret "$CMD"; then REASON='patch targets a protected store'; return 0; fi
                fi ;;
            pushd | popd | dirs) next_cwd=/proc/self/cwd; continue ;;
            shopt | set)
                if [[ "$first" == set && ${#W[@]} -eq 1 ]]; then REASON='shell options cannot be certified'; return 0; fi
                for option_name in "${W[@]:1}"; do
                    case "$option_name" in cdable_vars | autocd | extglob | globstar) next_cwd=/proc/self/cwd ;; esac
                done
                continue ;;
            cd)
                local before_cd="$CWD" alternate resolved_cd
                local before_alternatives=(${UNCERTAIN_CWDS[@]+"${UNCERTAIN_CWDS[@]}"})
                j=1
                while ((j < ${#W[@]})); do
                    case "${W[j]}" in -[LPe@]*) j=$((j + 1)) ;; --) j=$((j + 1)); break ;; *) break ;; esac
                done
                if [[ -z "${W[j]:-}" || "${W[j]}" == - || "${W[j]}" == '~-'* || "${W[j]}" == '~+'* || "${W[j]}" == '~'[0-9]* || "${W[j]}" == *'$'* || "$CMD" == *CDPATH=* || -n "${CDPATH:-}" || "$next_cwd" == /proc/self/cwd || "$CMD" == *cdable_vars* || "$CMD" == *autocd* ]]; then
                    CWD=/proc/self/cwd
                else
                    CWD="$(path "${W[j]}")"
                fi
                next_cwd="$CWD"
                # Apply a relative cd to every incoming cwd, not only the last
                # branch visited by the tokenizer. Keep the old possibilities.
                if [[ "$CWD" != /proc/self/cwd && "${line:0:1}" != b ]]; then
                    for alternate in ${before_alternatives[@]+"${before_alternatives[@]}"}; do
                        if [[ "$alternate" == /proc/self/cwd ]]; then resolved_cd=/proc/self/cwd
                        else resolved_cd="$(CWD="$alternate" path "${W[j]}" 1)"; fi
                        [[ "$resolved_cd" == "$CWD" ]] || remember_cwd "$resolved_cd" || {
                            REASON='working directory alternatives exceed analysis budget; split the command'; return 0;
                        }
                    done
                fi
                # A backgrounded cd runs in a child and cannot move its parent.
                if [[ "${line:0:1}" == b ]]; then next_cwd="$before_cd"; fi
                if ((cd_uncertain)) || [[ "${line:0:1}" == p ]] ||
                    { ((i > 0)) && [[ "${lines[i-1]:0:1}" == p ]]; }; then
                    remember_cwd "$before_cd" || { REASON='working directory alternatives exceed analysis budget; split the command'; return 0; }
                fi
                if [[ "${line:0:1}" == a || "${line:0:1}" == o ]] ||
                    { ((i > 0)) && [[ "${lines[i-1]:0:1}" == a || "${lines[i-1]:0:1}" == o ]]; }; then
                    PENDING_CWDS+=("$before_cd")
                fi
                continue
                ;;
            secret)
                sub="${W[1]:-}"
                case "$sub" in
                    list | show | stash | clip | help | --help | -h) continue ;;
                    run)
                        for ((j = 2; j < ${#W[@]}; j++)); do
                            if [[ "${W[j]}" == -- ]]; then
                                # Requote tokens for recursive analysis without evaluation.
                                text=""
                                for t in "${W[@]:j+1}"; do text+=" '${t//\'/\'\\\'\'}'"; done
                                analyse "$text" "$((depth + 1))" 1 || return 1
                                [[ -z "$REASON" ]] || return 0
                                break
                            fi
                        done
                        continue
                        ;;
                    *)
                        REASON='secret get/exec or unknown subcommand is not an agent transport'
                        return 0
                        ;;
                esac
                ;;
            vim | vi | nvim | ex)
                for token in "${W[@]:1}"; do
                    case "$token" in +r\ * | +read\ *)
                        if reader_operand "${token#* }"; then REASON='editor command reads a protected file'; return 0; fi ;;
                    esac
                done ;;
            python* | perl | node | nodejs | ruby | php | deno | bun | lua)
                # Inline interpreter text is an execution surface, unlike a
                # role-classified script or env-file operand.
                for ((j = 1; j < ${#W[@]}; j++)); do
                    shell_code=''
                    case "${W[j]}" in
                        -c | -e | -E | -r | --eval | --require)
                            j=$((j + 1)); ((j < ${#W[@]})) || return 1
                            shell_code="${W[j]}" ;;
                        -c?* | -e?* | -E?* | -r?*) shell_code="${W[j]:2}" ;;
                        --eval=* | --require=*) shell_code="${W[j]#*=}" ;;
                    esac
                    if [[ -n "$shell_code" ]]; then
                        if [[ "$first" == python* && ("$shell_code" == *dotenv_values* || "$shell_code" == *load_dotenv*) &&
                            "$shell_code" == *print* ]]; then
                            REASON='dotenv inline code prints environment values'; return 0
                        fi
                        if inline_git_target "$shell_code"; then
                            REASON='interpreter inline code targets git configuration'; return 0
                        fi
                        if raw_text_protected "$shell_code"; then
                            REASON='interpreter inline code names a protected file'; return 0
                        else
                            skip=$?
                            if ((skip != 1)); then REASON='interpreter inline code cannot be certified'; return 0; fi
                        fi
                    fi
                done
                if [[ "$first" == python* && " ${W[*]} " == *' -m dotenv get '* ]]; then
                    REASON='dotenv prints environment values'; return 0
                fi
                if [[ "$first" == python* && " ${W[*]} " == *' -m dotenv list'* ]]; then
                    REASON='dotenv prints environment values'; return 0
                fi
                if [[ "$first" == perl ]]; then
                    for token in "${W[@]:1}"; do
                        case "$token" in -MEnv | -MEnv,*) REASON='interpreter environment printer'; return 0 ;; esac
                    done
                fi
                # Every argument is checked: interpreter option clusters and
                # script operands need no language-specific arity guesses.
                skip=0
                for token in "${W[@]:1}"; do
                    if ((skip)); then skip=0; continue; fi
                    if [[ "$first" == node || "$first" == nodejs ]]; then
                        case "$token" in --env-file) skip=1; continue ;; --env-file=*) continue ;; esac
                    fi
                    if raw_mentions_protected "$token" 2; then
                        REASON='interpreter argument names a protected file or credential operation'
                        return 0
                    fi
                    # Literal file names inside inline code may name an alias.
                    opts="$token"
                    pattern="[\"']([^\"']+)[\"']"
                    while [[ "$opts" =~ $pattern ]]; do
                        token="${BASH_REMATCH[0]:-}"
                        sub="${BASH_REMATCH[1]:-}"
                        if [[ "$sub" == */* ]] && reader_operand "$sub"; then
                            REASON='interpreter script reads a protected alias'; return 0
                        fi
                        [[ -n "$token" ]] || return 1
                        opts="${opts#*"$token"}"
                    done
                done
                ;;
            bash | sh | zsh | ksh | mksh | dash | ash | yash | posh | hush | msh | fish)
                shell_code=-1
                file_next=0
                local pending_code=0
                for ((j = 1; j < ${#W[@]}; j++)); do
                    t="${W[j]}"
                    if ((file_next)); then file_next=0; continue; fi
                    if ((pending_code)); then
                        case "$t" in - | -- | -?* | +?*) continue ;; esac
                        shell_code=$j; break
                    fi
                    case "$t" in
                        -O | +O | -o | +o)
                            ((j + 1 < ${#W[@]})) || return 1
                            option_name="${W[j+1]}"
                            case "$option_name" in cdable_vars | autocd | extglob | globstar) next_cwd=/proc/self/cwd ;; esac
                            file_next=1; continue ;;
                        --rcfile | --init-file)
                            ((j + 1 < ${#W[@]})) || return 1
                            script_file shell "${W[j+1]}" || return 1
                            [[ -z "$REASON" ]] || return 0
                            file_next=1; continue ;;
                        --rcfile=* | --init-file=*)
                            script_file shell "${t#*=}" || return 1
                            [[ -z "$REASON" ]] || return 0; continue ;;
                        - | --)
                            if ((j + 1 >= ${#W[@]})); then
                                REASON='shell stdin script cannot be certified'; return 0
                            fi
                            script_file shell "${W[j+1]}" || return 1
                            [[ -z "$REASON" ]] || return 0
                            break ;;
                        -s | -[a-zA-Z]*s*) REASON='shell stdin script cannot be certified'; return 0 ;;
                        -c | -[a-zA-Z]*c* | -[a-zA-Z]*C* | --init-command)
                            pending_code=1; continue ;;
                        --init-command=*)
                            W+=("${t#*=}"); shell_code=$((${#W[@]} - 1)); break ;;
                        -d) ((j + 1 < ${#W[@]})) || return 1; file_next=1; continue ;;
                        -d?*) continue ;;
                        -* | +*) continue ;;
                        *) script_file shell "$t" || return 1
                            [[ -z "$REASON" ]] || return 0
                            break ;;
                    esac
                done
                if ((pending_code && shell_code < 0)); then
                    REASON='shell inline code is indeterminate'; return 0
                fi
                if ((shell_code < 0)) && ((j >= ${#W[@]})); then
                    REASON='shell stdin script cannot be certified'; return 0
                fi
                for ((j = 1; j < ${#W[@]}; j++)); do
                    # The -c code itself gets full recursive analysis below.
                    if ((j == shell_code && in_run == 0)); then continue; fi
                    if raw_mentions_protected "${W[j]}"; then
                        # Only credential-expansion markers in filtered child
                        # code may proceed to recursive transport validation.
                        if ((in_run && j == shell_code)); then
                            if raw_mentions_protected "${W[j]}" 1; then
                                REASON='shell argument names a protected file or credential operation'
                                return 0
                            fi
                            continue
                        fi
                        REASON='shell argument names a protected file or credential operation'
                        return 0
                    fi
                done
                if ((shell_code >= 0)); then
                    if raw_text_protected "${W[shell_code]}"; then
                        REASON='shell inline code names a protected file'; return 0
                    else
                        skip=$?
                        if ((skip != 1)); then REASON='shell inline code cannot be certified'; return 0; fi
                    fi
                    # Keep wrapper/workspace cwd changes when entering inline
                    # code, unless shell options made the cwd indeterminate.
                    [[ "$next_cwd" != /proc/self/cwd ]] || CWD="$next_cwd"
                    analyse "${W[shell_code]}" "$((depth + 1))" "$in_run" || return 1
                    [[ -z "$REASON" ]] || return 0
                fi
                ;;
        esac
        if [[ "$first" == grep || "$first" == egrep || "$first" == fgrep ]]; then
            for t in "${W[@]:1}"; do
                case "$t" in --recursive | --dereference-recursive | -r* | -R* | -[!-]*r* | -[!-]*R*)
                    search_scope grep
                    [[ -z "$REASON" ]] || return 0
                    break
                    ;;
                esac
            done
        fi
        if [[ "$first" == rg ]]; then
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    --no-ignore* | --no-config | -uu* | -[!-]*uu*)
                        REASON='unrestricted rg bypasses protected search defaults'
                        return 0
                        ;;
                    --glob=* | --iglob=* | -g?*)
                        opts="${t#*=}"
                        [[ "$t" != -g* ]] || opts="${t:2}"
                        ignore_case=0
                        [[ "$t" != --iglob* ]] || ignore_case=1
                        if ! selector_negative "$opts" 1 && protected_selector "$opts" "$ignore_case"; then
                            REASON='rg positive glob can re-include protected names'
                            return 0
                        fi
                        ;;
                    --glob | --iglob | -g)
                        opts="${W[j + 1]:-}"
                        ignore_case=0
                        [[ "$t" != --iglob* ]] || ignore_case=1
                        if ! selector_negative "$opts" 1 && protected_selector "$opts" "$ignore_case"; then
                            REASON='rg positive glob can re-include protected names'
                            return 0
                        fi
                        ;;
                esac
            done
        fi
        if [[ "$first" == rg || "$first" == git || "$first" == ack || "$first" == ack-grep ]]; then
            SEARCH_GIT_SCOPE_SAFE=0
            search_scope "$first"
            [[ -z "$REASON" ]] || return 0
            case "$first" in ack | ack-grep) continue ;; esac
            if [[ "$first" != git && $SEARCH_NAMES_ONLY == 1 ]]; then continue; fi
        fi
        if [[ "$first" == awk || "$first" == gawk ]]; then
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    -f) j=$((j + 1)); ((j < ${#W[@]})) || return 1
                        script_file awk "${W[j]}" || return 1 ;;
                    -f?*) script_file awk "${t:2}" || return 1 ;;
                esac
                [[ -z "$REASON" ]] || return 0
            done
        fi
        if [[ "$first" == sed || "$first" == perl ]]; then
            local in_place=0
            for t in "${W[@]:1}"; do
                case "$t" in
                    -i | -i?* | --in-place | --in-place=* | --in | --in-* | --in=*) in_place=1 ;;
                esac
                # shellcheck disable=SC2016,SC2088  # literal shell path spellings
                case "$t" in
                    */.git/* | .git/* | */.gitconfig | */git/config | .gitmodules | .gitconfig | '~/'* | '$HOME/'* | '$XDG_CONFIG_HOME/'* | '${HOME}/'* | '${XDG_CONFIG_HOME}/'*)
                        if git_write_target "$t"; then REASON='editor targets git configuration'; return 0; fi ;;
                esac
            done
            if ((in_place)); then
                for t in "${W[@]:1}"; do
                    [[ "$t" == -* ]] && continue
                    if [[ "$t" == *'*'* || "$t" == *'?'* || "$t" == *'['* ]]; then
                        if candidate "$t"; then REASON='in-place edit targets a protected file'; return 0; fi
                        # Existing matches are inspected without executing the edit.
                        local globbed matches=()
                        while IFS= read -r globbed; do matches+=("$globbed"); done < <(
                            (shopt -s nullglob; for globbed in $t; do printf '%s\n' "$globbed"; done))
                        ((${#matches[@]} <= 200)) || { REASON='in-place glob is indeterminate'; return 0; }
                        for globbed in ${matches[@]+"${matches[@]}"}; do
                            if git_write_target "$globbed"; then REASON='in-place edit targets git configuration'; return 0; fi
                        done
                        continue
                    fi
                    if git_write_target "$t"; then REASON='in-place edit targets git configuration'; return 0; fi
                done
            fi
        fi
        if [[ "$first" == sed ]]; then
            if [[ "$CMD" == *POSIXLY_CORRECT=* ]]; then REASON='sed script cannot be certified'; return 0; fi
            local sed_seen_operand=0 sed_next=0 sed_options=1
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                if ((sed_next)); then sed_next=0; continue; fi
                if ((sed_options == 0)); then continue; fi
                case "$t" in
                    --) sed_options=0 ;;
                    -e | -f | --expression | --file)
                        if ((sed_seen_operand)); then
                            REASON='sed option after positional script cannot be certified'; return 0
                        fi
                        sed_next=1 ;;
                    -e?* | -f?* | --expression=* | --file=* | -[a-zA-Z]*[ef]*)
                        if ((sed_seen_operand)); then
                            REASON='sed option after positional script cannot be certified'; return 0
                        fi ;;
                    -*) ;;
                    *) sed_seen_operand=1 ;;
                esac
            done
            for ((j = 1; j < ${#W[@]}; j++)); do
                t="${W[j]}"
                case "$t" in
                    -e | --expression)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1
                        sed_script "${W[j]}" || return 1 ;;
                    -e?* | --expression=*)
                        if [[ "$t" == -e* ]]; then opts="${t:2}"; else opts="${t#*=}"; fi
                        sed_script "$opts" || return 1 ;;
                    -f | --file)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1
                        script_file sed "${W[j]}" || return 1 ;;
                    -f?* | --file=*)
                        if [[ "$t" == -f* ]]; then opts="${t:2}"; else opts="${t#*=}"; fi
                        script_file sed "$opts" || return 1 ;;
                    -*[ef]*)
                        opts="${t:1}"
                        while [[ -n "$opts" ]]; do
                            token="${opts:0:1}"; opts="${opts:1}"
                            if [[ "$token" == e || "$token" == f ]]; then
                                if [[ -z "$opts" ]]; then
                                    j=$((j + 1)); ((j < ${#W[@]})) || return 1
                                    opts="${W[j]}"
                                fi
                                if [[ "$token" == e ]]; then sed_script "$opts" || return 1
                                else script_file sed "$opts" || return 1; fi
                                break
                            fi
                        done ;;
                esac
                [[ -z "$REASON" ]] || return 0
            done
        fi
        printer=0
        if [[ "$READERS" == *" $first "* ]]; then
            pattern=0
            skip=0
            file_next=0
            case "$first" in grep | egrep | fgrep | rg | ag | jq | yq | sed | awk | gawk) pattern=1 ;; esac
            for t in "${W[@]:1}"; do
                if ((skip)); then
                    skip=$((skip - 1))
                    continue
                fi
                if ((file_next)); then
                    if [[ "$first" == jq && "$t" == -n ]]; then continue; fi
                    file_next=0
                    if reader_operand "$t"; then REASON='jq file option targets a protected store'; return 0; fi
                    continue
                fi
                case "$first:$t" in
                    jq:--rawfile | jq:--slurpfile) skip=1; file_next=1; continue ;;
                    jq:-f | jq:--from-file) file_next=1; continue ;;
                    jq:-[!-]*f* | jq:--from-file=*)
                        opts="${t#*=}"
                        [[ "$t" != -[!-]*f* ]] || opts="${t#*f}"
                        if [[ -z "$opts" ]]; then file_next=1
                        elif reader_operand "$opts"; then REASON='jq file option targets a protected store'; return 0; fi
                        continue ;;
                    wc:--files0-from | sort:--files0-from) file_next=1; continue ;;
                    wc:--files0-from=* | sort:--files0-from=*)
                        if reader_operand "${t#*=}"; then REASON='name list option reads a protected store'; return 0; fi
                        continue ;;
                    node:--env-file) skip=1; continue ;;
                    node:--env-file=*) continue ;;
                esac
                # In grep and sed, a clustered -e/-f consumes the rest
                # of this word as a pattern or script, not a filename.
                if [[ "$first" == grep || "$first" == egrep || "$first" == fgrep || "$first" == sed ]]; then
                    if [[ "$t" == -[a-zA-Z0-9]* ]]; then
                        opts="${t:1}"
                        sub=""
                        while [[ -n "$opts" ]]; do
                            token="${opts:0:1}"
                            opts="${opts:1}"
                            if [[ "$token" == e || "$token" == f ]]; then sub="$token"; break; fi
                            [[ "$token" == [a-zA-Z0-9] ]] || break
                        done
                    else
                        sub=""
                    fi
                    if [[ -n "$sub" ]]; then
                        pattern=0
                        if [[ "$sub" == f && -n "$opts" ]] && reader_operand "$opts"; then
                            REASON='pattern file targets a protected store'
                            return 0
                        fi
                        if [[ -z "$opts" ]]; then
                            if [[ "$sub" == f ]]; then file_next=1; else skip=1; fi
                        fi
                        continue
                    fi
                fi
                case "$t" in
                    -e | --regexp | -f | --file)
                        if [[ "$first" == cat ]]; then continue; fi
                        if [[ "$first" == grep || "$first" == rg || "$first" == sed || "$first" == awk ]]; then
                            [[ "$t" != -e && "$t" != --regexp ]] || pattern=0
                            [[ "$t" != -f && "$t" != --file ]] || {
                                skip=0
                                pattern=0
                                continue
                            }
                        fi
                        # Other readers use -e and -f as switches; their next
                        # word is still a filename, not a pattern operand.
                        if [[ "$first" == grep || "$first" == egrep || "$first" == fgrep ||
                            "$first" == rg || "$first" == sed || "$first" == awk ]]; then skip=1; fi
                        continue
                        ;;
                    --arg | --argjson)
                        skip=2
                        continue
                        ;;
                    --regexp=* | --regex=* | --reg=* | --expression=* | --expr=* | --e=* | -e?*)
                        if [[ "$first" == sed ]]; then
                            opts="${t#*=}"
                            sed_script "$opts" || return 1
                            [[ -z "$REASON" ]] || return 0
                        fi
                        if [[ "$first" == grep || "$first" == rg || "$first" == sed || "$first" == awk ]]; then pattern=0; fi
                        continue
                        ;;
                    --file=* | --from-file=* | -f?*)
                        case "$first:$t" in
                            grep:* | rg:* | sed:* | awk:* | jq:* | diff:--from-file=*)
                                opts="${t#*=}"
                                [[ "$t" != -f* ]] || opts="${t:2}"
                                if reader_operand "$opts"; then REASON='pattern file targets a protected store'; return 0; fi
                                pattern=0 ;;
                        esac
                        continue
                        ;;
                    --glob | --iglob | -g | --type | --type-not | --include | --exclude | --exclude-dir | --max-count)
                        # sed -n is a switch, unlike head's line-count option.
                        if [[ "$t" == -n && "$first" != head && "$first" != tail ]]; then continue; fi
                        skip=1
                        continue
                        ;;
                    --) continue ;;
                    -A | -B | -C | -T | -t | -n)
                        if [[ "$first" == grep || "$first" == egrep || "$first" == fgrep || "$first" == rg ]]; then
                            case "$t" in -A | -B | -C) skip=1 ;; esac
                        elif [[ "$first" == head || "$first" == tail ]]; then
                            case "$t" in -n) skip=1 ;; esac
                        fi
                        continue ;;
                    -*) continue ;;
                esac
                if ((pattern)); then
                    if [[ "$first" == jq || "$first" == yq ]]; then
                        if [[ "$t" == '$'* && "${RAW_SEGMENTS[i]}" == *'"$'* ]]; then
                            printer=1
                        fi
                        # Match jq environment builtins, not .env fields or strings.
                        # shellcheck disable=SC2016  # jq's $ENV is literal code
                        opts='(^|[^[:alnum:]_."\x27])(env|\$ENV)([^[:alnum:]_]|$)'
                        opts="${opts//\\x27/\'}"
                        [[ ! "$t" =~ $opts ]] || printer=1
                        opts='(^|[^[:alnum:]_])(strenv|env)\('
                        [[ ! "$t" =~ $opts ]] || printer=1
                    fi
                    if [[ "$first" == awk || "$first" == gawk || "$first" == sed ]]; then
                        opts="${t//process.env/process_env}"
                        opts="${opts//import.meta.env/import_meta_env}"
                        raw_mentions_protected "$opts" 2 && { REASON='script names a protected file or environment'; return 0; }
                        if [[ "$first" == awk || "$first" == gawk ]]; then
                            awk_script "$t" || return 1
                            [[ -z "$REASON" ]] || return 0
                        fi
                        if [[ "$first" == sed ]]; then
                            sed_script "$t" || return 1
                            [[ -z "$REASON" ]] || return 0
                        fi
                    fi
                    pattern=0
                    continue
                fi
                if reader_operand "$t"; then
                    if [[ "$first" == grep || "$first" == egrep || "$first" == fgrep ]]; then
                        case " ${W[*]} " in
                            *' -q '* | *' --quiet '* | *' -c '* | *' --count '* | *' -l '* | *' -L '*) continue ;;
                        esac
                        for token in "${W[@]:1}"; do
                            if [[ "$token" =~ ^-[a-zA-Z]+$ ]]; then
                                opts="${token:1}"
                                opts="${opts%%[ef]*}"
                                [[ "$opts" != *[qclL]* ]] || continue 2
                            fi
                        done
                    fi
                    REASON='reader targets a protected store'
                    return 0
                fi
            done
        else
            file_operands "$first" || return 1
            [[ -z "$REASON" ]] || return 0
        fi
        case "$first" in
            envsubst) printer=1 ;;
            make)
                for t in "${W[@]:1}"; do
                    case "$t" in --print-data-base | -p | -[a-zA-Z]*p*) printer=1 ;; esac
                done ;;
            gh)
                [[ "${W[1]:-}" != auth || "${W[2]:-}" != token ]] || printer=1
                if [[ "${W[1]:-}" == config && "${W[2]:-}" == get ]]; then
                    for t in "${W[@]:3}"; do [[ "$t" != oauth_token ]] || printer=1; done
                fi
                if [[ "${W[1]:-}" == auth && "${W[2]:-}" == status ]]; then
                    for t in "${W[@]:3}"; do case "$t" in -t | --show-token) printer=1 ;; esac; done
                fi ;;
            kubectl)
                local get_secret=0 saw_get=0 saw_create=0
                for ((j = 1; j < ${#W[@]}; j++)); do
                    t="${W[j]}"
                    if [[ "$t" == create ]]; then saw_create=1; continue; fi
                    if ((saw_create)) && [[ "$t" == token ]]; then printer=1; fi
                    if [[ "$t" == get ]]; then saw_get=1; continue; fi
                    if ((saw_get)); then
                        local resources=() resource
                        IFS=, read -r -a resources <<<"$t"
                        for resource in "${resources[@]}"; do
                            case "$resource" in secret | secrets | secret/* | secrets/*) get_secret=1 ;; esac
                        done
                    fi
                done
                if ((get_secret)); then
                    for ((j = 1; j < ${#W[@]}; j++)); do
                        case "${W[j]}" in
                            -o | --output) case "${W[j+1]:-}" in yaml | json | jsonpath* | go-template*) printer=1 ;; esac ;;
                            -o=yaml | -o=json | -o=jsonpath* | -o=go-template* | -oyaml | -ojson | -ojsonpath* | -ogo-template* | --output=yaml | --output=json | --output=jsonpath* | --output=go-template*) printer=1 ;;
                        esac
                    done
                fi
                if [[ "${W[1]:-}" == config && "${W[2]:-}" == view ]]; then
                    for t in "${W[@]:3}"; do [[ "$t" != --raw ]] || printer=1; done
                fi ;;
            pm2) [[ "${W[1]:-}" != env ]] || printer=1 ;;
            dotenv | dotenvx)
                case " ${W[*]} " in *' list'* | *' get '* | *' -p '* | *' --print '* | *' decrypt --stdout'*) printer=1 ;; esac ;;
            docker-compose)
                case " ${W[*]} " in *' config'* | *' convert'*) printer=1 ;; esac ;;
            docker)
                case " ${W[*]} " in *' compose '*' config'* | *' compose '*' convert'*) printer=1 ;; esac
                if [[ "${W[1]:-}" == inspect || ("${W[1]:-}" == container && "${W[2]:-}" == inspect) ]]; then
                    opts=" ${W[*]} "
                    if [[ "$opts" != *--format* && "$opts" != *' -f '* ]] ||
                        [[ "$opts" == *'.Config'* || "$opts" == *'.Env'* || "$opts" == *'json .'* || "$opts" == *'--format json '* || "$opts" == *'--format=json'* ]]; then printer=1; fi
                fi ;;
            php)
                # shellcheck disable=SC2016  # PHP variable names are literal code.
                for t in "${W[@]:1}"; do
                    case "$t" in -i | --info | *'phpinfo('* | *'print_r($_SERVER'* | *'print_r($_ENV'* | *'var_dump($_SERVER'* | *'var_dump($_ENV'* | *'getenv('*) printer=1 ;; esac
                done ;;
            pnpm | yarn)
                j=1
                while ((j < ${#W[@]})); do
                    case "${W[j]}" in
                        -C | --dir | --filter) j=$((j + 2)) ;;
                        -C?* | --dir=* | --filter=*) j=$((j + 1)) ;;
                        *) break ;;
                    esac
                done
                if [[ "${W[j]:-}" == config ]]; then
                    case "${W[j+1]:-}" in
                        list | ls) printer=1 ;;
                        get)
                            for t in "${W[@]:j+2}"; do
                                case "$(lower "$t")" in *token* | *auth* | *password* | *credential*) printer=1 ;; esac
                            done ;;
                    esac
                fi ;;
            npm)
                if [[ "${W[1]:-}" == run && "${W[2]:-}" == env ]] ||
                    { [[ "${W[1]:-}" == exec || "${W[1]:-}" == x ]] &&
                        [[ " ${W[*]} " == *' env '* ]]; }; then printer=1; fi
                if [[ "${W[1]:-}" == config && ("${W[2]:-}" == get || "${W[2]:-}" == list) ]]; then
                    for t in "${W[@]:3}"; do
                        case "$(lower "$t")" in *token* | *auth* | *password*) printer=1 ;; esac
                        if [[ "${W[2]}" == list ]]; then case "$t" in -l | --long | --json) printer=1 ;; esac; fi
                    done
                fi ;;
            npx)
                for ((j = 1; j < ${#W[@]}; j++)); do
                    case "${W[j]}" in -e | --eval)
                        j=$((j + 1)); ((j < ${#W[@]})) || return 1
                        if raw_text_protected "${W[j]}"; then
                            REASON='runner inline code names a protected file'; return 0
                        fi ;;
                        -e?* | --eval=*)
                        if raw_text_protected "${W[j]#*=}"; then
                            REASON='runner inline code names a protected file'; return 0
                        fi ;;
                    esac
                done ;;
            compgen)
                for t in "${W[@]:1}"; do
                    case "$t" in -e | -v | -Avariable | -A) printer=1 ;; esac
                done ;;
            env | printenv | pbpaste | wl-paste) printer=1 ;;
            xclip | xsel)
                for t in "${W[@]:1}"; do
                    case "$t" in -o | --output | -out) printer=1 ;; esac
                done
                ;;
            gcloud)
                NEXT=(); skip=0
                for t in "${W[@]:1}"; do
                    if ((skip)); then skip=0; continue; fi
                    case "$t" in
                        --project | --account | --configuration | --impersonate-service-account | --billing-project | --verbosity | --format | --flags-file | --access-token-file | --trace-token) skip=1; continue ;;
                        --project=* | --account=* | --configuration=* | --impersonate-service-account=* | --billing-project=* | --verbosity=* | --format=* | --flags-file=* | --access-token-file=* | --trace-token=* | --quiet | --quiet=* | -q | --log-http | --log-http=* | --no-log-http | --no-user-output-enabled | --user-output-enabled | --user-output-enabled=*) continue ;;
                    esac
                    NEXT+=("$t")
                done
                [[ "${NEXT[0]:-}:${NEXT[1]:-}" != config:config-helper ]] || printer=1
                if [[ "${NEXT[0]:-}" == auth ]]; then
                    j=1
                    [[ "${NEXT[j]:-}" != application-default ]] || j=$((j + 1))
                    case "${NEXT[j]:-}" in print-access-token | print-identity-token) printer=1 ;; esac
                fi
                ;;
            aws)
                NEXT=()
                skip=0
                for t in "${W[@]:1}"; do
                    if ((skip)); then
                        skip=0
                        continue
                    fi
                    case "$t" in --profile | --region | --output | --query | --endpoint-url | --ca-bundle | --cli-read-timeout | --cli-connect-timeout | --color)
                        skip=1
                        continue
                        ;;
                    --profile=* | --region=* | --output=* | --query=* | --endpoint-url=* | --ca-bundle=* | --cli-read-timeout=* | --cli-connect-timeout=* | --color=* | --debug | --no-verify-ssl | --no-sign-request | --no-paginate | --no-cli-pager | --no-cli-auto-prompt | --cli-auto-prompt) continue ;; esac
                    NEXT+=("$t")
                done
                case "${NEXT[0]:-}:${NEXT[1]:-}" in
                    ecr:get-login-password | sts:get-session-token | sso:get-role-credentials) printer=1 ;;
                esac
                if [[ "${NEXT[0]:-}" == configure ]]; then
                    case "${NEXT[1]:-}" in
                        export-credentials) printer=1 ;;
                        get)
                            opts='^[Aa][Ww][Ss]_([Aa][Cc][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]_[Ii][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]_[Aa][Cc][Cc][Ee][Ss][Ss]_[Kk][Ee][Yy]|[Ss][Ee][Ss][Ss][Ii][Oo][Nn]_[Tt][Oo][Kk][Ee][Nn])$'
                            [[ ! "${NEXT[2]:-}" =~ $opts ]] || printer=1
                            ;;
                    esac
                fi
                ;;
            az)
                case " ${W[*]} " in
                    *' account get-access-token '*) printer=1 ;;
                    *' acr login '*) for t in "${W[@]:1}"; do case "$t" in --expose-token | --expose-token=true) printer=1 ;; esac; done ;;
                esac ;;
            heroku) [[ "${W[1]:-}" != auth:token ]] || printer=1 ;;
            vault)
                case "${W[1]:-}:${W[2]:-}" in print:token | token:lookup) printer=1 ;; esac ;;
            doctl)
                NEXT=(); skip=0
                for t in "${W[@]:1}"; do
                    if ((skip)); then skip=0; continue; fi
                    case "$t" in
                        --context | --config | -c | --access-token | -t | --api-url | --output | -o | --http-retry-max | --http-retry-wait-min | --http-retry-wait-max) skip=1; continue ;;
                        --context=* | --config=* | --access-token=* | --api-url=* | --output=* | --http-retry-max=* | --http-retry-wait-min=* | --http-retry-wait-max=* | --verbose | --verbose=* | -v | --trace | --trace=* | --interactive | --interactive=* | --no-header | --no-header=*) continue ;;
                    esac
                    NEXT+=("$t")
                done
                [[ "${NEXT[0]:-}:${NEXT[1]:-}" != auth:token ]] || printer=1 ;;
            glab)
                if [[ "${W[1]:-}:${W[2]:-}" == auth:status ]]; then
                    for t in "${W[@]:3}"; do case "$t" in --show-token | --show-token=true) printer=1 ;; esac; done
                fi ;;
            direnv) [[ "${W[1]:-}" != export ]] || printer=1 ;;
            op)
                if [[ "${W[1]:-}" == read ]]; then
                    printer=1
                elif [[ "${W[1]:-}" == item && "${W[2]:-}" == get ]]; then
                    # Field selection can reveal a password without --reveal.
                    for t in "${W[@]:3}"; do
                        case "$t" in --reveal | --fields | --fields=*) printer=1 ;; esac
                    done
                fi
                ;;
            pass)
                case "${W[1]:-}" in
                    '' | ls | list | insert | add | edit | generate | rm | remove | delete | mv | rename | cp | copy | init | git | help | version | -*) ;;
                    *) printer=1 ;;
                esac
                ;;
            keyring)
                j=1
                while ((j < ${#W[@]})); do
                    case "${W[j]}" in
                        -b | --keyring-backend | -p | --keyring-path | --mode | --output)
                            ((j + 1 < ${#W[@]})) || return 1
                            j=$((j + 2)) ;;
                        --keyring-backend=* | --keyring-path=* | --mode=* | --output=* | -b?* | -p?*) j=$((j + 1)) ;;
                        --) j=$((j + 1)); break ;;
                        *) break ;;
                    esac
                done
                [[ "${W[j]:-}" != get ]] || printer=1 ;;
            secret-tool)
                case "${W[1]:-}" in
                    lookup) printer=1 ;;
                    search)
                        REASON='secret-tool search prints secrets and is always denied'
                        return 0
                        ;;
                esac
                ;;
            kwallet-query)
                for t in "${W[@]:1}"; do
                    case "$t" in -r | --read-password | --read-password=*) printer=1 ;; esac
                done
                ;;
            ps)
                skip=0
                for t in "${W[@]:1}"; do
                    if ((skip)); then
                        skip=0
                        continue
                    fi
                    case "$t" in -o | o | -O | O | --format | -p | p | --pid | -C | -t | t | -u | U | -U | -g | -G)
                        skip=1
                        continue
                        ;;
                    esac
                    # Linux documents bare BSD e; reserve macOS -E as well.
                    [[ ! "$t" =~ ^[a-zA-Z]*e[a-zA-Z]*$ && ! "$t" =~ ^-[a-zA-Z]*E[a-zA-Z]*$ ]] || printer=1
                done
                ;;

            git) [[ "${W[1]:-}" != credential || "${W[2]:-}" != fill ]] || printer=1 ;;
            security)
                if [[ "${W[1]:-}" == find-generic-password || "${W[1]:-}" == find-internet-password ]]; then
                    for t in "${W[@]:2}"; do
                        if [[ "$t" == -g ]]; then
                            REASON='security -g prints passwords to stderr and is always denied'
                            return 0
                        fi
                        [[ "$t" != -w ]] || printer=1
                    done
                fi
                ;;
            export) [[ ${#W[@]} != 1 && "${W[1]:-}" != -p ]] || printer=1 ;;
            declare | typeset)
                [[ ${#W[@]} != 1 ]] || printer=1
                for t in "${W[@]:1}"; do [[ ! "$t" =~ ^-[a-zA-Z]*[xp] ]] || printer=1; done
                ;;
            set) [[ ${#W[@]} != 1 ]] || printer=1 ;;
            echo | printf)
                for t in "${W[@]:1}"; do [[ ! "$t" =~ $CRED_VAR ]] || printer=1; done
                ;;
        esac
        # Child-scoped curl headers may use printf on a direct pipe to curl.
        # This is transport, not retrieval; ordinary credential printing stays denied.
        if ((in_run)) && [[ "$first" == printf && "${line:0:1}" == p && "$next_first" == curl ]]; then printer=0; fi
        if ((printer && direct == 0)); then
            REASON='credential printer requires a direct pipe to secret stash FILE KEY or a password-stdin login'
            return 0
        fi
    done
    CWD="$saved_cwd"
    return 0
}

# Preserve NUL as an invalid control marker rather than silently dropping it
# when jq output enters a Bash variable. Raw recovery still sees the names.
COMMAND_TYPE="$(printf '%s' "$INPUT" | jq -r '.tool_input.command | type' 2>/dev/null)" || exit 1
if [[ "$COMMAND_TYPE" == array ]]; then
    # Codex currently passes {"command": cmd} as a string. Accept argv from
    # other shell adapters without evaluating arguments as shell source.
    printf '%s' "$INPUT" | jq -e '.tool_input.command | length > 0 and all(.[]; type == "string" and (index("\u0000") | not))' >/dev/null 2>&1 || { decide 'invalid command argv' 0; exit 0; }
    ARGV=() CMD="" WRAPPED=0
    while IFS= read -r ENCODED; do
        # A sentinel retains trailing newlines through command substitution.
        ARG="$(printf '%s' "$ENCODED" | perl -MMIME::Base64 -ne 'print decode_base64($_)'; printf '\037')"
        ARGV+=("${ARG%$'\037'}")
    done < <(printf '%s' "$INPUT" | jq -r '.tool_input.command[] | @base64')
    case "${ARGV[0]}" in
        bash | */bash | sh | */sh)
            if [[ "${ARGV[1]:-}" == -lc || "${ARGV[1]:-}" == -c ]] && ((${#ARGV[@]} >= 3)); then
                CMD="${ARGV[2]}" WRAPPED=1
            fi
            ;;
    esac
    if ((WRAPPED == 0)); then
        for ARG in "${ARGV[@]}"; do
            printf -v QUOTED '%q' "$ARG"
            CMD+="${CMD:+ }$QUOTED"
        done
    fi
elif [[ "$COMMAND_TYPE" == string ]]; then
    CMD="$(printf '%s' "$INPUT" | jq -er '.tool_input.command | gsub("\u0000"; "\u0001")' 2>/dev/null)" || exit 1
else
    exit 0
fi
# Only line-ending CR is insignificant; embedded controls stay invalid.
if [[ "$CMD" == *$'\r'* ]]; then
    CMD="${CMD//$'\r'$'\n'/$'\n'}"
    CMD="${CMD%$'\r'}"
fi
RAW_CMD="$CMD"
if ((${#CMD} > 8192)); then
    if ((${#CMD} > 1048576 + 256)) || [[ "$CMD" != *$'\n'* ]]; then
        decide 'command exceeds analysis budget; split the command' 0
        exit 0
    fi
    header="${CMD%%$'\n'*}"
    interpreter_heredoc="^(python3?|node)[[:space:]]+(-[[:space:]]+)?<<[[:space:]]*'([A-Za-z0-9_]+)'$"
    if [[ "$header" =~ $interpreter_heredoc ]] && ((${#CMD} <= 1048576 + 256)); then
        delimiter="${BASH_REMATCH[3]}"
        if [[ "${CMD##*$'\n'}" == "$delimiter" ]] &&
            [[ "$CMD" != *$'\n'"$delimiter"$'\n'* ]]; then
            if raw_text_protected "$CMD" body || inline_git_target "$CMD"; then
                decide 'interpreter heredoc names a protected path'
            fi
            DECISION_WRITTEN=1
            exit 0
        fi
    fi
    # A quoted heredoc is data, not command text. Only trim bodies whose
    # receiving command is a plain file writer or a commit/PR message. The
    # original body is still checked below for non-inert protected names.
    NORMALIZED="$(printf '%s' "$CMD" | perl -0777 -e '
        use strict; use warnings;
        my $text = <STDIN> // "";
        my $count = 0;
        # Only the command receiving this heredoc can own inert message data.
        # Inert cat substitutions and cat-to-message pipes are also recognised.
        sub message_header {
            my ($before, $after) = @_;
            my $receiver = $before;
            $receiver =~ s/^.*(?:&&|\|\||;|\|)//;
            $receiver =~ s/^.*\$\(\s*//;
            my $message = qr{^\s*(?:git\s+(?:commit|tag)\b[^\n]*(?:-[as]*m\b|--message\b|-F\s+-|--file=-)|gh\b[^\n]*(?:--title|--body))};
            return 1 if $receiver =~ $message;
            return 0 unless $receiver =~ /^\s*cat\s*$/;
            return 1 if $after =~ /^\s*\|\s*(?:git\s+(?:commit|tag)\b[^\n]*(?:-F\s+-|--file=-)|gh\b[^\n]*--body-file\s+-)/;
            return $before =~ $message && $before =~ /\$\(\s*cat\s*$/;
        }
        $text =~ s{(^[^\n]*?<<[[:space:]]*\x27([A-Za-z0-9_]+)\x27[^\n]*\n)(.*?)^(\2)(?=\r?$)}{
            my ($header, $body, $end) = ($1, $3, $4);
            my $message = message_header((split /<<[^\n]*?\x27[A-Za-z0-9_]+\x27/, $header, 2));
            my $writer = $header =~ /\b(?:cat|tee)\b/ &&
                ($header =~ /\s>\s*[^\s<>]+/ || $header =~ /\btee\s+(?:-a\s+)?[^\s<>]+/);
            ($message || $writer) or die "unsafe heredoc\n";
            $count++;
            "$header\n$end"
        }gmes;
        $count or die "no inert heredoc\n";
        print $text;
    ' 2>/dev/null)" || { decide 'command exceeds analysis budget; split the command' 0; exit 0; }
    if ((${#NORMALIZED} > 8192)); then
        decide 'command exceeds analysis budget; split the command' 0
        exit 0
    fi
    CMD="$NORMALIZED"
fi
if analyse "$CMD" 0; then
    if [[ -n "$REASON" ]]; then
        decide "$REASON"
    elif raw_text_protected "$RAW_CMD" body; then
        decide 'shell input body names a protected file or git configuration'
    else
        RAW_STATUS=$?
        ((RAW_STATUS == 1)) || decide 'shell input body cannot be certified' 0
    fi
else
    if raw_text_protected "$CMD"; then
        decide 'command too complex to analyse for secret access; split it or use secret run' 0
    else
        RAW_STATUS=$?
        if ((RAW_STATUS != 1)) || [[ -n "$REASON" ]] || raw_mentions_protected "$CMD" ||
            [[ "$CMD" == *--unrecognised* || "$CMD" == *--unknown* ]]; then
            decide 'command too complex to analyse for secret access; split it or use secret run' 0
        fi
    fi
fi
DECISION_WRITTEN=1
exit 0
