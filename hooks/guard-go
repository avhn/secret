#!/bin/sh
# A cold hook denies immediately. Explicit preinstallation owns network work.
set -f
bootstrap() {
    entry=$0
    case $entry in /*) ;; *) entry=$PWD/$entry ;; esac
    n=0
    while :; do
        parent=$(CDPATH='' cd -P "$(dirname "$entry")" && pwd -P) || return 1
        entry=$parent/${entry##*/}
        [ -L "$entry" ] || break
        n=$((n + 1))
        [ "$n" -le 32 ] || return 1
        link=$(readlink "$entry") || return 1
        case $link in /*) entry=$link ;; *) entry=$parent/$link ;; esac
    done
    [ -f "$entry" ] || return 1
    root=$(CDPATH='' cd -P "$parent/.." && pwd -P) || return 1
    uid=$(id -u) || return 1
    # Do not execute even the checker through a writable or aliased checkout.
    path=$root/scripts/install-release.sh
    while :; do
        [ ! -L "$path" ] || return 1
        attrs=$(stat -c '%u %a %h' "$path" 2>/dev/null) ||
            attrs=$(stat -f '%u %Lp %l' "$path") || return 1
        owner=${attrs%% *}
        rest=${attrs#* }; mode=${rest%% *}; links=${rest#* }
        case $owner:$links in *[!0-9:]*|:*) return 1 ;; esac
        case $mode in *[!0-7]*|'') return 1 ;; esac
        if [ -f "$path" ]; then [ "$links" = 1 ] || return 1; fi
        [ "$owner" = "$uid" ] || [ "$owner" = 0 ] || return 1
        if [ $((0$mode & 022)) -ne 0 ]; then
            [ -d "$path" ] && [ "$owner" = 0 ] && [ $((0$mode & 01000)) -ne 0 ] || return 1
        fi
        [ "$path" != / ] && [ "$path" != "${HOME-}" ] || break
        path=${path%/*}; [ -n "$path" ] || path=/
    done
    "$root/scripts/install-release.sh" --offline >/dev/null 2>&1 </dev/null || return 1
    if [ -n "${SECRET_RELEASE_TEST_ROOT-}" ]; then
        # The checker enforces the unshipped marker and private fixture root.
        base=$SECRET_RELEASE_TEST_ROOT
    else
        base=${XDG_CACHE_HOME:-$HOME/.cache}
    fi
    while [ "${base%/}" != "$base" ]; do base=${base%/}; done
    cached=$base/secret/v0.3.5/secret
}
if bootstrap 2>/dev/null; then
    exec "$cached" hook claude
fi
# No external dependencies, including JSON tools, are needed to deny.
trap '' PIPE
# Do not let a builtin's temporary stderr redirection reuse a closed stdout.
# The subshell's exec redirection needs no saved descriptor or restoration.
if (
    exec 2>/dev/null
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"secret: verified binary unavailable; run scripts/install-release.sh"}}'
); then
    exit 0
fi
printf '%s\n' 'secret: verified binary unavailable' >&2
exit 2
