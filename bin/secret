#!/usr/bin/env bash
#
# Explicit secret transport for personal launchers and agent commands.
# Stores are parsed, never sourced. run filters literal values on each stream;
# exec preserves interactive/MCP bytes and is not an agent retrieval route.
# This prevents accidents, not deliberate shell bypasses or transformed leaks.
# Usage: secret help
set +x
set -euo pipefail

SECRETS_DIR="${SECRETS_DIR:-$HOME/.secrets}"
SECRETS_ENV="${SECRETS_ENV:-$HOME/.secrets.env}"
WORK="" LOCK_TOKEN="" WRITE_TMP="" CHILD="" OUT_PID="" ERR_PID="" TTY_STATE=""
KEYS=() VALUES=() ALL_VALUES=()

# die MESSAGE: emit a value-free diagnostic and fail.
die() {
    printf 'secret: %s\n' "$*" >&2
    exit 1
}

# cleanup: stop owned children and release only the lock bearing our token.
cleanup() {
    local pid n owner=""
    if [[ -n "$TTY_STATE" ]]; then stty "$TTY_STATE" 2>/dev/null || true; fi
    for pid in "$CHILD" "$OUT_PID" "$ERR_PID"; do
        [[ -n "$pid" ]] || continue
        kill "$pid" 2>/dev/null || true
        for ((n = 0; n < 10; n++)); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.01
        done
        kill -KILL "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    done
    if [[ -n "$LOCK_TOKEN" ]]; then
        [[ ! -f "$SECRETS_DIR/.write-lock/token" ]] || IFS= read -r owner <"$SECRETS_DIR/.write-lock/token" || true
        if [[ "$owner" == "$LOCK_TOKEN" ]]; then
            rm -f "$SECRETS_DIR/.write-lock/token" "$SECRETS_DIR/.write-lock/pid"
            rmdir "$SECRETS_DIR/.write-lock" 2>/dev/null || true
        fi
    fi
    [[ -z "$WRITE_TMP" ]] || rm -f "$WRITE_TMP"
    [[ -z "$WORK" ]] || rm -rf "$WORK"
    return 0
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# usage: document selectors, transport limits, and stable exit statuses.
usage() {
    cat <<'EOF'
Usage: secret list | show [FILE ...] | help
       secret run|exec -f FILE [-f FILE ...] [--key KEY] [--optional-key KEY] -- CMD [ARG ...]
       secret stash FILE KEY
       secret get FILE KEY
       secret clip FILE KEY [SECONDS]
Bare NAME resolves to ~/.secrets/NAME.secret, then ~/.secrets/.NAME.secret.
list prints paths only; show prints names, masked lengths, and ignored line numbers.
run and exec require explicit files and --. Later files win. Selectors export
only selected keys; required keys must be nonempty, missing optional keys vanish.
run redacts ALL nonempty loaded values, longest first, on stdout and stderr.
Redaction cannot catch transformed values. Do not print or inspect credentials.
exec is unfiltered: only human interactive or configured MCP launchers use it.
get prints a value only to a human terminal, never through Claude's ! command.
stash reads hidden terminal input or stdin; writes reject empty, NUL, CR, embedded
newline, boundary whitespace, and surrounding quote pairs. One final LF is allowed.
clip copies and conditionally clears the clipboard (default 45 seconds).
Values are not in this tool's argv or filter argv; a child can expose its own
values in argv. Prefer stdin/header files for consumers that support them.
Exit: 0 success/help/empty inventory, 1 usage/store/filter error; run preserves
a failing child status. exec preserves child status, framing, and signals.
EOF
}

# workspace: allocate private scratch space only when needed.
workspace() {
    command -v perl >/dev/null 2>&1 || die "perl is required"
    if [[ -z "$WORK" ]]; then
        umask 077
        WORK="$(mktemp -d "${TMPDIR:-/tmp}/secret.XXXXXXXX")" || die "cannot create scratch directory"
    fi
}

# resolve NAME: existing relative files win; hidden stores are the fallback.
resolve() {
    if [[ "$1" == */* || -f "$1" ]]; then
        printf '%s\n' "$1"
    elif [[ -f "$SECRETS_DIR/$1.secret" || ! -f "$SECRETS_DIR/.$1.secret" ]]; then
        printf '%s\n' "$SECRETS_DIR/$1.secret"
    else
        printf '%s\n' "$SECRETS_DIR/.$1.secret"
    fi
}

# defaults: include hidden stores without mutating caller glob options.
defaults() (
    shopt -s nullglob
    local f
    [[ ! -f "$SECRETS_ENV" ]] || printf '%s\n' "$SECRETS_ENV"
    for f in "$SECRETS_DIR"/*.secret "$SECRETS_DIR"/.*.secret; do
        case "$f" in *~ | *.swp | *.bak) continue ;; esac
        [[ ! -f "$f" ]] || printf '%s\n' "$f"
    done
    return 0
)

# load FILE: tolerate legacy shell lines without executing them. Perl preserves
# bytes before Bash sees them; malformed assignments only report line numbers.
# Sets KEYS/VALUES (later wins), and ALL_VALUES for complete literal redaction.
load() {
    local file="$1" key value i found
    [[ -f "$file" ]] || die "$file is missing or not a regular file"
    workspace
    perl - "$file" >"$WORK/parsed" <<'PERL' || die "store parsing failed"
use strict; use warnings;
open my $f, '<', $ARGV[0] or die "secret: cannot open store\n";
binmode $f; binmode STDOUT;
my (%v, %line, @keys, @ignored, @assignments);
while (my $s = <$f>) {
    my $n = $.; $s =~ s/\r?\n\z//;
    next if $s =~ /^\s*(?:#|$)/;
    if ($s =~ /^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)\z/s && $s !~ /[\x00\r]/) {
        my ($k, $value) = ($1, $2);
        if ($value =~ /^(["'])(.*)\1\z/s) { $value = $2 }
        elsif ($value =~ /^["']/) { warn "secret: malformed assignment ignored (line: $n)\n"; push @ignored, $n; next }
        if (exists $v{$k}) { warn "secret: duplicate $k (lines: $line{$k},$n); last wins\n" }
        else { push @keys, $k }
        $v{$k} = $value; $line{$k} = $n; push @assignments, [$k, $value];
    } else {
        warn "secret: malformed assignment ignored (line: $n)\n" if $s =~ /=/;
        push @ignored, $n;
    }
}
warn scalar(@ignored)." non-assignment lines ignored (lines: ".join(',', @ignored).")\n" if @ignored;
for my $pair (@assignments) { print $pair->[0], "\0", $pair->[1], "\0" or die "secret: parser output failed\n" }
PERL
    while IFS= read -r -d '' key && IFS= read -r -d '' value; do
        ALL_VALUES+=("$value")
        found=0
        for ((i = 0; i < ${#KEYS[@]}; i++)); do
            if [[ "${KEYS[i]}" == "$key" ]]; then
                VALUES[i]="$value"
                found=1
                break
            fi
        done
        if ((found == 0)); then
            KEYS+=("$key")
            VALUES+=("$value")
        fi
    done <"$WORK/parsed"
}

# lookup KEY: return its array index without emitting its value.
lookup() {
    local i
    for ((i = 0; i < ${#KEYS[@]}; i++)); do
        if [[ "${KEYS[i]}" == "$1" ]]; then
            printf '%s\n' "$i"
            return 0
        fi
    done
    return 1
}

# cmd_list: print paths only on stdout, with a clear empty diagnostic on stderr.
cmd_list() {
    (($# == 0)) || die "list takes no arguments"
    local files
    files="$(defaults)"
    if [[ -n "$files" ]]; then
        printf '%s\n' "$files"
    else printf 'no secret stores found\n' >&2; fi
}

# cmd_show FILES: default discovery succeeds even with no stores.
cmd_show() {
    local files=() f i
    if (($#)); then
        for f in "$@"; do files+=("$(resolve "$f")"); done
    else
        while IFS= read -r f; do files+=("$f"); done < <(defaults)
    fi
    if ((${#files[@]} == 0)); then
        printf 'no secret stores found\n'
        return 0
    fi
    for f in ${files[@]+"${files[@]}"}; do
        KEYS=() VALUES=()
        load "$f"
        printf '%s\n' "$f"
        for ((i = 0; i < ${#KEYS[@]}; i++)); do
            printf '  %s=<%s bytes>\n' "${KEYS[i]}" "${#VALUES[i]}"
        done
    done
}

# filter FIFO READY: bounded streaming literal replacement, including short
# values and chunk boundaries. Read values from private bytes, never argv.
filter() {
    exec 4>&- 5>&-
    exec perl - "$WORK/values" "$1" "$2" <<'PERL'
use strict; use warnings;
open my $v, '<', $ARGV[0] or die "secret: filter values unavailable\n";
binmode $v; local $/; my $values = <$v>;
my @v = sort { length($b) <=> length($a) } grep { length } split /\0/, $values;
my $max = @v ? length($v[0]) : 1;
my $re = @v ? join('|', map { quotemeta } @v) : '(?!)';
open my $in, '<', $ARGV[1] or die "secret: filter input failed\n";
open my $ready, '>', $ARGV[2] or die "secret: filter readiness failed\n";
print $ready "ready\n"; close $ready or die "secret: readiness write failed\n";
binmode $in; binmode STDOUT; $| = 1;
my $buf = '';
while (1) {
    my $n = sysread($in, my $chunk, 8192);
    defined $n or die "secret: filter read failed\n";
    $buf .= $chunk;
    my $limit = $n ? length($buf) - $max + 1 : length($buf);
    my $pos = 0; my $out = '';
    while ($pos < $limit) {
        pos($buf) = $pos;
        if ($buf =~ /\G(?:$re)/gc) { $out .= '<redacted>'; $pos = pos($buf) }
        else { $out .= substr($buf, $pos++, 1) }
    }
    substr($buf, 0, $pos, '');
    print STDOUT $out or die "secret: filter output failed\n";
    last unless $n;
}
close STDOUT or die "secret: filter flush failed\n";
PERL
}

# child_env DATA UNSET_NAMES CMD: install user keys in Perl, not Bash's own
# variables. Transport stays in the environment and never enters argv/diagnostics.
child_env() {
    local data="$1" unset_names="$2"
    shift 2
    SECRET_CHILD_DATA="$data" SECRET_CHILD_UNSET="$unset_names" exec perl -e '
        use strict; use warnings;
        my $data = delete $ENV{SECRET_CHILD_DATA};
        my $unset = delete $ENV{SECRET_CHILD_UNSET};
        delete @ENV{split /\n/, $unset};
        my @parts = split /\n/, $data, -1;
        pop @parts;
        while (@parts) { my $key = shift @parts; $ENV{$key} = shift @parts }
        exec @ARGV or die "secret: child launch failed\n";
    ' -- "$@"
}

# cmd_launch MODE OPTIONS -- CMD: explicit stores, optional scoped exports,
# supervised filters, and status preservation. exec deliberately skips filters.
cmd_launch() {
    local mode="$1" files=() required=() optional=() selected=() child_data="" unset_names="" f key i rc=0 out_rc=0 err_rc=0 n marker=0
    shift
    while (($#)); do
        case "$1" in
            -f | --key | --optional-key)
                (($# >= 2)) || die "option needs an argument"
                case "$1" in
                    -f) files+=("$(resolve "$2")") ;;
                    --key) required+=("$2") ;;
                    --optional-key) optional+=("$2") ;;
                esac
                shift 2
                ;;
            --)
                marker=1
                shift
                break
                ;;
            *) die "expected -f, --key, --optional-key, or --" ;;
        esac
    done
    ((marker && $# && ${#files[@]})) || die "run/exec require -f FILE and -- CMD"
    for f in ${files[@]+"${files[@]}"}; do load "$f"; done
    for key in ${required[@]+"${required[@]}"} ${optional[@]+"${optional[@]}"}; do
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid selector name"
    done
    for key in ${required[@]+"${required[@]}"}; do
        if ! i="$(lookup "$key")" || [[ -z "${VALUES[i]}" ]]; then
            die "$key is missing or empty; stash it with: secret stash $SECRETS_ENV $key"
        fi
        selected+=("$i")
    done
    for key in ${optional[@]+"${optional[@]}"}; do
        if i="$(lookup "$key")"; then selected+=("$i"); fi
    done
    if ((${#required[@]} + ${#optional[@]} == 0)); then
        for ((i = 0; i < ${#KEYS[@]}; i++)); do selected+=("$i"); done
    fi
    # Unselected store keys must not leak in from the caller's environment.
    # Never unset/export arbitrary user key names in the transport's own shell.
    for key in ${KEYS[@]+"${KEYS[@]}"} ${optional[@]+"${optional[@]}"}; do unset_names+="$key"$'\n'; done
    for i in ${selected[@]+"${selected[@]}"}; do child_data+="${KEYS[i]}"$'\n'"${VALUES[i]}"$'\n'; done
    if [[ "$mode" == exec ]]; then
        cleanup
        trap - EXIT INT TERM HUP
        child_env "$child_data" "$unset_names" "$@"
    fi
    workspace
    printf '%s\0' ${ALL_VALUES[@]+"${ALL_VALUES[@]}"} >"$WORK/values"
    mkfifo "$WORK/out" "$WORK/err"
    # Temporary FIFO guardians make filter startup and writer attachment safe.
    exec 4<>"$WORK/out" 5<>"$WORK/err"
    filter "$WORK/out" "$WORK/out.ready" &
    OUT_PID=$!
    filter "$WORK/err" "$WORK/err.ready" >&2 &
    ERR_PID=$!
    for ((n = 0; n < 100; n++)); do
        if ! kill -0 "$OUT_PID" 2>/dev/null || ! kill -0 "$ERR_PID" 2>/dev/null; then die "redaction filter failed before launch"; fi
        [[ -f "$WORK/out.ready" && -f "$WORK/err.ready" ]] && break
        sleep 0.01
    done
    [[ -f "$WORK/out.ready" && -f "$WORK/err.ready" ]] || die "redaction filters did not become ready"
    # Preserve stdin for the asynchronous child (Bash otherwise uses /dev/null).
    exec 3<&0
    (
        exec 4>&- 5>&-
        printf 'started\n' >"$WORK/child.started"
        child_env "$child_data" "$unset_names" "$@"
    ) <&3 >"$WORK/out" 2>"$WORK/err" &
    CHILD=$!
    exec 3<&-
    for ((n = 0; n < 100; n++)); do
        [[ ! -f "$WORK/child.started" ]] || break
        if ! kill -0 "$OUT_PID" 2>/dev/null || ! kill -0 "$ERR_PID" 2>/dev/null; then die "redaction filter failed during writer attachment"; fi
        sleep 0.01
    done
    [[ -f "$WORK/child.started" ]] || die "child did not attach to redaction filters"
    exec 4>&- 5>&-
    wait "$CHILD" || rc=$?
    CHILD=""
    wait "$OUT_PID" || out_rc=$?
    OUT_PID=""
    wait "$ERR_PID" || err_rc=$?
    ERR_PID=""
    if ((rc == 0 && (out_rc || err_rc))); then die "redaction filter failed"; fi
    return "$rc"
}

# cmd_stash FILE KEY: byte validation before Bash, bounded private lock, and
# atomic sibling replacement. Never steal locks or follow write-target links.
cmd_stash() {
    (($# == 2)) || die "stash needs FILE KEY"
    local file key="$2" n
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid key name"
    file="$(resolve "$1")"
    workspace
    if [[ -t 0 ]]; then
        # Perl retains NUL bytes that Bash read would silently discard. Restore
        # the terminal both normally and through cleanup on an interrupt.
        TTY_STATE="$(stty -g)" || die "cannot inspect terminal settings"
        stty -echo || die "cannot hide terminal input"
        printf '%s: ' "$key" >&2
        perl -e 'binmode STDIN; binmode STDOUT; my $line = <STDIN>; defined $line or exit 1; print $line or exit 1;' >"$WORK/input" || die "no input"
        stty "$TTY_STATE" || die "cannot restore terminal settings"
        TTY_STATE=""
        printf '\n' >&2
    else
        cat >"$WORK/input"
    fi
    perl - "$WORK/input" <<'PERL' || die "invalid value (empty, whitespace, quotes, newline, NUL, or CR)"
use strict; use warnings;
open my $f, '<', $ARGV[0] or exit 1; binmode $f; local $/; my $s = <$f>;
$s =~ s/\n\z//;
exit 1 if !length($s) || $s =~ /[\x00\r\n]/ || $s =~ /^\s|\s\z/ || $s =~ /^(?:".*"|'.*')\z/s;
PERL
    umask 077
    [[ ! -L "$SECRETS_DIR" ]] || die "secret directory must not be a symlink"
    mkdir -p "$SECRETS_DIR" "$(dirname "$file")"
    chmod 700 "$SECRETS_DIR"
    LOCK_TOKEN="$$.${WORK##*/}"
    for ((n = 0; n < 30; n++)); do
        # A direct mkdir(2) call: some mkdir binaries (uutils) check for the
        # directory before creating it, so two racing writers both succeed.
        if perl -e 'mkdir $ARGV[0] or exit 1' "$SECRETS_DIR/.write-lock"; then break; fi
        sleep 0.1
    done
    if ((n == 30)); then
        LOCK_TOKEN=""
        die "write lock timed out after 3 s; verify its PID is stopped, then manually remove $SECRETS_DIR/.write-lock (never auto-stolen)"
    fi
    printf '%s\n' "$LOCK_TOKEN" >"$SECRETS_DIR/.write-lock/token"
    printf '%s\n' "$$" >"$SECRETS_DIR/.write-lock/pid"
    [[ ! -L "$file" && (! -e "$file" || -f "$file") ]] || die "refusing symlink or non-regular write target"
    WRITE_TMP="$(mktemp "$file.XXXXXXXX")"
    perl - "$file" "$key" "$WORK/input" >"$WRITE_TMP" <<'PERL' || die "atomic store update failed"
use strict; use warnings;
my ($file, $key, $input) = @ARGV; binmode STDOUT;
if (-f $file) {
    open my $f, '<', $file or die "secret: store read failed\n";
    while (my $s = <$f>) { next if $s =~ /^\s*(?:export\s+)?\Q$key\E=/; $s =~ s/\n?\z/\n/; print $s }
}
open my $v, '<', $input or die "secret: input unavailable\n"; binmode $v; local $/;
my $value = <$v>; $value =~ s/\n\z//; print "$key=$value\n";
close STDOUT or die "secret: store output failed\n";
PERL
    chmod 600 "$WRITE_TMP"
    mv -f "$WRITE_TMP" "$file"
    WRITE_TMP=""
    printf 'stored %s in %s\n' "$key" "$file"
}

# cmd_get FILE KEY: check the terminal before resolving or opening any store.
cmd_get() {
    [[ -t 1 ]] || die "get is human-terminal-only; use show or run instead"
    (($# == 2)) || die "get needs FILE KEY"
    local i
    load "$(resolve "$1")"
    i="$(lookup "$2")" || die "key is not set"
    printf '%s\n' "${VALUES[i]}"
}

# clipboard_copy / clipboard_paste: select the host clipboard implementation.
clipboard_copy() {
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy
    elif command -v wl-copy >/dev/null 2>&1; then
        wl-copy
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard
    else die "no clipboard tool (pbcopy, wl-copy, xclip)"; fi
}
clipboard_paste() {
    if command -v pbpaste >/dev/null 2>&1; then
        pbpaste
    elif command -v wl-paste >/dev/null 2>&1; then
        wl-paste --no-newline
    else xclip -selection clipboard -o; fi
}

# cmd_clip FILE KEY SECONDS: clear only if the user has not replaced the copy.
cmd_clip() {
    (($# == 2 || $# == 3)) || die "clip needs FILE KEY [SECONDS]"
    local i value secs="${3:-45}"
    [[ "$secs" =~ ^[0-9]+$ ]] || die "SECONDS must be a number"
    load "$(resolve "$1")"
    i="$(lookup "$2")" || die "key is not set"
    value="${VALUES[i]}"
    printf '%s' "$value" | clipboard_copy
    (
        trap - EXIT INT TERM HUP
        sleep "$secs"
        if [[ "$(clipboard_paste 2>/dev/null)" == "$value" ]]; then printf '' | clipboard_copy; fi
    ) >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null || true
    printf 'copied %s; clears in %ss if unchanged\n' "$2" "$secs"
}

(($#)) || die "subcommand required; use secret help"
SUB="$1"
shift
case "$SUB" in
    help | --help | -h) usage ;;
    list) cmd_list "$@" ;;
    show) LC_ALL=C cmd_show "$@" ;;
    run | exec) cmd_launch "$SUB" "$@" ;;
    stash) cmd_stash "$@" ;;
    get) cmd_get "$@" ;;
    clip) cmd_clip "$@" ;;
    *) die "unknown subcommand; use secret help" ;;
esac
